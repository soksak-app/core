{
  "id": "terminal",
  "name": "터미널",
  "description": "터미널 프로그램을 실행하는 터미널 카드. 커서, 글꼴, 셸, 스크롤바를 설정한다.",
  "mark": "◊",
  "icon": "<rect x=\"2\" y=\"3\" width=\"12\" height=\"10\" rx=\"2\"/><circle cx=\"5\" cy=\"7\" r=\"1.5\"/><path d=\"M8 9l2-2m-2 0l2 2\"/>",
  "surface": {
    "module": "ui/terminal-module.js",
    "drop": "terminal.drop",
    "composition": {
      "kind": "hybrid",
      "regions": [
        {
          "name": "view",
          "kind": "image",
          "sidecar": "@soksak/sidecar-vt-alacritty",
          "input": "dom"
        }
      ],
      "overlays": ["scrollbar"]
    }
  },
  "preview": {
    "ink": "--surface-fg"
  },
  "settings": {
    "cursor.shape": {
      "label": "커서 모양",
      "description": "block은 칸 전체, underline은 밑줄, beam은 세로 막대로 그린다. 프로그램이 모양을 정하면 그 모양을 쓴다.",
      "type": "enum",
      "default": "block",
      "values": ["block", "underline", "beam"]
    },
    "cursor.blink": {
      "label": "커서 깜박임",
      "description": "Never는 늘 멈추고 Always는 늘 깜박인다. Off는 멈춘 채로 시작하고 On은 깜박이며 시작하며, 둘 다 프로그램의 요청을 따른다.",
      "type": "enum",
      "default": "Off",
      "values": ["Never", "Off", "On", "Always"]
    },
    "cursor.interval": {
      "label": "깜박임 간격(ms)",
      "type": "integer",
      "default": 750,
      "minimum": 50,
      "maximum": 5000
    },
    "cursor.idleTimeout": {
      "label": "깜박임 멈춤 시간(ms)",
      "description": "입력이 없으면 이 시간 뒤 깜박임을 멈춘다. 0이면 멈추지 않는다.",
      "type": "integer",
      "default": 5000,
      "minimum": 0,
      "maximum": 60000
    },
    "cursor.unfocused": {
      "label": "포커스 밖 커서",
      "description": "터미널이 입력을 받지 않을 때의 커서. hollow는 빈 네모, solid는 채운 네모, underline과 beam은 그 모양이며, unchanged는 포커스가 있을 때와 같다.",
      "type": "enum",
      "default": "hollow",
      "values": ["hollow", "solid", "underline", "beam", "unchanged"]
    },
    "clipboard.program": {
      "label": "프로그램의 클립보드 사용",
      "description": "deny는 터미널 프로그램이 OSC 요청으로 클립보드를 읽고 쓰는 것을 막고, allow는 허용한다. 사용자가 직접 붙여넣는 것에는 영향이 없다.",
      "type": "enum",
      "default": "deny",
      "values": ["deny", "allow"]
    },
    "font.family": {
      "label": "글꼴",
      "description": "세미콜론으로 나눈 글꼴 이름. 앞의 글꼴부터 쓴다.",
      "type": "string",
      "default": "D2Coding;Menlo",
      "maxLength": 256
    },
    "shell": {
      "label": "셸",
      "description": "login은 계정의 로그인 셸이다. 다른 값은 실행 파일의 절대 경로다.",
      "type": "string",
      "default": "login",
      "maxLength": 1024
    },
    "title": {
      "label": "탭 제목",
      "description": "program은 프로그램이 보낸 제목을 탭에 보이고, name은 프로그램 제목을 쓰지 않고 탭 이름을 유지한다.",
      "type": "enum",
      "default": "program",
      "values": ["program", "name"]
    },
    "scrollbar.track": {
      "label": "스크롤바 바탕",
      "description": "terminal은 터미널 바탕색이다. 다른 값은 #rrggbb 또는 #rrggbbaa 색이다.",
      "type": "string",
      "default": "terminal",
      "maxLength": 9
    },
    "scrollbar.thumb": {
      "label": "스크롤바 손잡이 색",
      "description": "#rrggbb 또는 #rrggbbaa 색.",
      "type": "string",
      "default": "#8f98a080",
      "maxLength": 9
    },
    "scrollbar.width": {
      "label": "스크롤바 폭(pt)",
      "type": "integer",
      "default": 10,
      "minimum": 4,
      "maximum": 24
    },
    "scrollbar.shape": {
      "label": "스크롤바 모양",
      "description": "rounded는 둥근 끝, square는 각진 끝.",
      "type": "enum",
      "default": "rounded",
      "values": ["rounded", "square"]
    }
  },
  "sidecars": [
    "@soksak/sidecar-vt-alacritty"
  ],
  "background": {
    "sidecar": "@soksak/sidecar-vt-alacritty",
    "operation": "open",
    "settings": { "shell": "shell" }
  },
  "exposes": {
    "status": [
      {
        "name": "terminal.screen",
        "description": "The latest terminal screen cell rows, updated on sidecar screen events.",
        "schema": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "ch": { "type": "string" } }
            }
          }
        }
      },
      {
        "name": "terminal.session",
        "description": "The session state: identifier, dimensions, cell size, the scrollback viewport offset and history, the number of selection releases the sidecar answered, the pointer shape the program set with OSC 22, and the reasons of the last eight output sequences the engine rejected.",
        "schema": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "font": {
              "type": "string"
            },
            "fontSystem": {
              "type": "boolean"
            },
            "fontSize": {
              "type": "number"
            },
            "cols": {
              "type": "integer"
            },
            "rows": {
              "type": "integer"
            },
            "cellWidth": {
              "type": "number"
            },
            "cellHeight": {
              "type": "number"
            },
            "inlineImages": {
              "type": "array",
              "items": { "type": "string" }
            },
            "selectionReleases": {
              "type": "integer"
            },
            "scrollback": {
              "type": "object",
              "properties": {
                "offset": { "type": "integer" },
                "history": { "type": "integer" }
              }
            },
            "selecting": {
              "type": "boolean"
            },
            "link": {
              "type": ["string", "null"]
            },
            "pointer": {
              "type": "string"
            },
            "rejected": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      {
        "name": "terminal.cursor",
        "description": "The terminal cursor position, the rendering policy that the sidecar applied and presented, and the shape and blink request that the sidecar drew after the program's request and the focus rule.",
        "schema": {
          "type": "object",
          "properties": {
            "row": { "type": "integer" },
            "col": { "type": "integer" },
            "shape": { "type": "string", "enum": ["block", "underline", "beam"] },
            "visible": { "type": "boolean" },
            "blinking": { "type": "boolean" },
            "focused": { "type": "boolean" },
            "blink": { "type": "string", "enum": ["Never", "Off", "On", "Always"] },
            "interval": { "type": "number" },
            "idleTimeout": { "type": "number" },
            "unfocused": { "type": "string", "enum": ["hollow", "solid", "underline", "beam", "unchanged"] },
            "hollow": { "type": "boolean" },
            "blinkVisible": { "type": "boolean" },
            "drawn": {
              "type": "object",
              "properties": {
                "shape": { "type": "string", "enum": ["block", "underline", "beam", "hollowBlock", "hidden"] },
                "blinking": { "type": "boolean" }
              }
            }
          }
        }
      },
      {
        "name": "terminal.compose",
        "description": "The current terminal composition state.",
        "schema": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "selectedRange": { "type": ["object", "null"] },
            "replacementRange": { "type": ["object", "null"] },
            "attributed": { "type": "boolean" }
          }
        }
      }
    ],
    "commands": [
      {
        "name": "terminal.input",
        "description": "Sends text input to the terminal session as UTF-8 bytes.",
        "params": {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "terminal.focus",
        "description": "Transfers keyboard ownership to the terminal native image region.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "terminal.screen.read",
        "description": "Requests the current terminal screen and returns its cell rows.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "ch": { "type": "string" } }
            }
          }
        }
      },
      {
        "name": "terminal.close",
        "description": "Closes the terminal session.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "terminal.image.inline.delete",
        "description": "Deletes one named inline image owned by this terminal session.",
        "params": {
          "type": "object",
          "properties": {
            "name": { "type": "string" }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "terminal.cursor.set",
        "description": "Sets the terminal cursor rendering policy.",
        "params": {
          "type": "object",
          "properties": {
            "shape": { "type": "string", "enum": ["block", "underline", "beam"] },
            "blink": { "type": "string", "enum": ["Never", "Off", "On", "Always"] },
            "interval": { "type": "integer" },
            "idleTimeout": { "type": "integer" },
            "unfocused": { "type": "string", "enum": ["hollow", "solid", "underline", "beam", "unchanged"] }
          }
        },
        "result": {
          "type": "object"
        }
      },
      {
        "name": "terminal.scrollback.set",
        "description": "Moves the terminal viewport to the given number of lines above the newest output, limited to the retained history, without writing to the program.",
        "params": {
          "type": "object",
          "properties": {
            "offset": { "type": "integer" }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "terminal.link.open",
        "description": "Opens a URI from a terminal hyperlink with the user's default application through the host; the host accepts http, https, and mailto.",
        "params": {
          "type": "object",
          "properties": {
            "uri": { "type": "string" }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "terminal.copy",
        "description": "Copies the text of the current terminal selection to the clipboard; without a selection the clipboard is unchanged.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "terminal.paste",
        "description": "Reads one user-selected text, file, or PNG clipboard payload and pastes it once without executing it.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "terminal.drop",
        "description": "Pastes user-dropped local file URLs once without executing them.",
        "params": {
          "type": "object",
          "properties": {
            "urls": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "result": {
          "type": "null"
        }
      }
    ],
    "dom": [
      {
        "name": "terminal.view",
        "description": "The terminal view area."
      },
      {
        "name": "terminal.scrollbar",
        "description": "The scrollbar track shown while the viewport is above the newest output."
      },
      {
        "name": "terminal.scrollbar.thumb",
        "description": "The scrollbar thumb; dragging it moves the viewport."
      }
    ]
  }
}
