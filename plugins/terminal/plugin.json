{
  "id": "terminal",
  "name": "터미널",
  "mark": "◊",
  "icon": "<rect x=\"2\" y=\"3\" width=\"12\" height=\"10\" rx=\"2\"/><circle cx=\"5\" cy=\"7\" r=\"1.5\"/><path d=\"M8 9l2-2m-2 0l2 2\"/>",
  "surface": {
    "module": "ui/terminal-module.js",
    "composition": {
      "kind": "hybrid",
      "regions": [
        {
          "name": "view",
          "kind": "image",
          "sidecar": "@soksak/sidecar-vt-alacritty",
          "input": "dom"
        }
      ],
      "overlays": []
    }
  },
  "preview": {
    "ink": "--surface-fg"
  },
  "settings": {
    "cursor.shape": {
      "type": "enum",
      "default": "block",
      "values": ["block", "underline", "beam"]
    },
    "cursor.blink": {
      "type": "enum",
      "default": "Off",
      "values": ["Never", "Off", "On", "Always"]
    },
    "cursor.interval": {
      "type": "integer",
      "default": 750,
      "minimum": 50,
      "maximum": 5000
    },
    "cursor.idleTimeout": {
      "type": "integer",
      "default": 5000,
      "minimum": 0,
      "maximum": 60000
    },
    "cursor.unfocused": {
      "type": "enum",
      "default": "hollow",
      "values": ["hollow", "solid", "underline", "beam", "unchanged"]
    },
    "clipboard.program": {
      "type": "enum",
      "default": "deny",
      "values": ["deny", "allow"]
    },
    "font.family": {
      "type": "string",
      "default": "D2Coding;Menlo",
      "maxLength": 256
    }
  },
  "sidecars": [
    "@soksak/sidecar-vt-alacritty"
  ],
  "background": {
    "sidecar": "@soksak/sidecar-vt-alacritty",
    "operation": "open"
  },
  "exposes": {
    "status": [
      {
        "name": "terminal.screen",
        "description": "The latest terminal screen cell rows, updated on sidecar screen events.",
        "schema": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "ch": { "type": "string" } }
            }
          }
        }
      },
      {
        "name": "terminal.session",
        "description": "The session state: identifier, dimensions, and cell size.",
        "schema": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "font": {
              "type": "string"
            },
            "fontSystem": {
              "type": "boolean"
            },
            "cols": {
              "type": "integer"
            },
            "rows": {
              "type": "integer"
            },
            "cellWidth": {
              "type": "number"
            },
            "cellHeight": {
              "type": "number"
            },
            "inlineImages": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      {
        "name": "terminal.cursor",
        "description": "The terminal cursor position and rendering policy.",
        "schema": {
          "type": "object",
          "properties": {
            "row": { "type": "integer" },
            "col": { "type": "integer" },
            "shape": { "type": "string", "enum": ["block", "underline", "beam"] },
            "visible": { "type": "boolean" },
            "blinking": { "type": "boolean" },
            "focused": { "type": "boolean" },
            "blink": { "type": "string", "enum": ["Never", "Off", "On", "Always"] },
            "interval": { "type": "number" },
            "idleTimeout": { "type": "number" },
            "unfocused": { "type": "string", "enum": ["hollow", "solid", "underline", "beam", "unchanged"] },
            "hollow": { "type": "boolean" },
            "blinkVisible": { "type": "boolean" }
          }
        }
      },
      {
        "name": "terminal.compose",
        "description": "The current terminal composition state.",
        "schema": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "selectedRange": { "type": ["object", "null"] },
            "replacementRange": { "type": ["object", "null"] },
            "attributed": { "type": "boolean" }
          }
        }
      },
      {
        "name": "terminal.ime.trace",
        "description": "The explicitly enabled bounded IME callback and terminal-input diagnostic trace.",
        "schema": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "overflow": { "type": "boolean" },
            "entries": { "type": "array" }
          }
        }
      }
    ],
    "commands": [
      {
        "name": "terminal.compose.update",
        "description": "Updates the active native terminal preedit without writing PTY bytes.",
        "params": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "selectedRange": { "type": ["object", "null"], "properties": {
              "location": { "type": "integer" }, "length": { "type": "integer" }
            } },
            "replacementRange": { "type": ["object", "null"], "properties": {
              "location": { "type": "integer" }, "length": { "type": "integer" }
            } },
            "attributed": { "type": "boolean" }
          }
        },
        "result": { "type": "null" }
      },
      {
        "name": "terminal.ime.trace",
        "description": "Starts or stops the bounded real IME callback and terminal-input trace.",
        "params": {
          "type": "object",
          "properties": { "action": { "type": "string", "enum": ["start", "stop"] } }
        },
        "result": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "overflow": { "type": "boolean" },
            "entries": { "type": "array" }
          }
        }
      },
      {
        "name": "terminal.input",
        "description": "Sends text input to the terminal session as UTF-8 bytes.",
        "params": {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "terminal.focus",
        "description": "Transfers keyboard ownership to the terminal native image region.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "terminal.screen.read",
        "description": "Requests the current terminal screen and returns its cell rows.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "ch": { "type": "string" } }
            }
          }
        }
      },
      {
        "name": "terminal.close",
        "description": "Closes the terminal session.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "terminal.image.inline.delete",
        "description": "Deletes one named inline image owned by this terminal session.",
        "params": {
          "type": "object",
          "properties": {
            "name": { "type": "string" }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "terminal.cursor.set",
        "description": "Sets the terminal cursor rendering policy.",
        "params": {
          "type": "object",
          "properties": {
            "shape": { "type": "string", "enum": ["block", "underline", "beam"] },
            "blink": { "type": "string", "enum": ["Never", "Off", "On", "Always"] },
            "interval": { "type": "integer" },
            "idleTimeout": { "type": "integer" },
            "unfocused": { "type": "string", "enum": ["hollow", "solid", "underline", "beam", "unchanged"] }
          }
        },
        "result": {
          "type": "object"
        }
      },
      {
        "name": "terminal.paste",
        "description": "Reads one user-selected text, file, or PNG clipboard payload and pastes it once without executing it.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "terminal.drop",
        "description": "Pastes user-dropped local file URLs once without executing them.",
        "params": {
          "type": "object",
          "properties": {
            "urls": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "result": {
          "type": "null"
        }
      }
    ],
    "dom": [
      {
        "name": "terminal.view",
        "description": "The terminal view area."
      }
    ]
  }
}
