{
  "id": "browser",
  "name": "브라우저",
  "mark": "www",
  "icon": "<rect x=\"2\" y=\"3\" width=\"12\" height=\"10\" rx=\"2\"/><path d=\"M2 6.25h12M4.3 4.6h.01M6.1 4.6h.01\"/>",
  "surface": {
    "module": "ui/browser.js",
    "composition": {
      "kind": "hybrid",
      "regions": [
        {
          "name": "page",
          "kind": "document",
          "input": "native"
        }
      ],
      "overlays": []
    }
  },
  "preview": {
    "ink": "--rail"
  },
  "sections": [
    {
      "id": "browser.dom",
      "name": "DOM",
      "module": "ui/sections/dom.js"
    },
    {
      "id": "browser.network",
      "name": "네트워크",
      "module": "ui/sections/network.js"
    },
    {
      "id": "browser.tabs",
      "name": "탭",
      "module": "ui/sections/tabs.js"
    },
    {
      "id": "browser.history",
      "name": "히스토리",
      "module": "ui/sections/history.js"
    }
  ],
  "settings": {
    "home": {
      "label": "홈 주소",
      "description": "새 브라우저 카드가 처음 여는 http 또는 https 주소다. 비우면 주소 입력 안내로 시작한다.",
      "type": "address",
      "default": ""
    }
  },
  "exposes": {
    "status": [
      {
        "name": "browser.location",
        "description": "The state of the document region: address, title, loading and its progress from 0 to 1, whether history can go back or forward, the last load error or null, and the document scroll position in CSS pixels.",
        "schema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "loading": {
              "type": "boolean"
            },
            "progress": {
              "type": "number"
            },
            "canGoBack": {
              "type": "boolean"
            },
            "canGoForward": {
              "type": "boolean"
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "scroll": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      {
        "name": "browser.address.text",
        "description": "The text the address field shows and whether the field has focus.",
        "schema": {
          "type": "object",
          "properties": {
            "value": { "type": "string" },
            "focused": { "type": "boolean" }
          }
        }
      }
    ],
    "commands": [
      {
        "name": "browser.address.select",
        "description": "Focuses the address field and selects its complete value for replacement.",
        "params": { "type": "object", "properties": {} },
        "result": { "type": "null" }
      },
      {
        "name": "browser.navigate",
        "description": "Opens an http or https address in the document region.",
        "params": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "browser.back",
        "description": "Goes back in the document history and returns whether there was an entry to go to.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "boolean"
        }
      },
      {
        "name": "browser.forward",
        "description": "Goes forward in the document history and returns whether there was an entry to go to.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "boolean"
        }
      },
      {
        "name": "browser.reload",
        "description": "Reloads the document and returns whether a document was loaded.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "boolean"
        }
      },
      {
        "name": "browser.stop",
        "description": "Stops any load in progress and returns true.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "boolean"
        }
      }
    ],
    "dom": [
      {
        "name": "browser.address",
        "description": "The address field."
      },
      {
        "name": "browser.back",
        "description": "The button that goes back."
      },
      {
        "name": "browser.forward",
        "description": "The button that goes forward."
      },
      {
        "name": "browser.reload",
        "description": "The button that reloads the document, or stops loading while it loads."
      },
      {
        "name": "browser.document",
        "description": "The element the document region occupies."
      },
      {
        "name": "browser.empty",
        "description": "The element shown in place of the document while the address is empty; a click focuses the address field."
      }
    ]
  }
}
