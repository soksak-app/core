{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soksak",
  "version": "0.0.1",
  "identifier": "dev.soksak.example",
  "build": {
    "frontendDist": "src/frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "soksak / Tauri v2",
        "width": 1200,
        "height": 760,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#101117",
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
