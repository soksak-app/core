{
  "starter": "starter",
  "registry": "https://soksak-app.github.io/registry/index.json",
  "settings": {
    "terminal": {
      "cursor.shape": "block",
      "cursor.blink": "Off",
      "cursor.interval": 750,
      "cursor.idleTimeout": 5000,
      "cursor.unfocused": "hollow",
      "clipboard.program": "deny"
    }
  },
  "workspace": {
    "focus": "main",
    "grid": {
      "root": {
        "cut": "x",
        "kids": [
          {
            "share": 0.3333333333333333,
            "node": {
              "card": "left",
              "fixed": true,
              "width": 190
            }
          },
          {
            "share": 0.3333333333333333,
            "node": {
              "card": "main",
              "tabs": []
            }
          },
          {
            "share": 0.33333333333333337,
            "node": {
              "card": "right",
              "fixed": true,
              "width": 210
            }
          }
        ]
      }
    }
  },
  "sidebars": {
    "sets": [
      {
        "id": "set-install",
        "title": "탐색기",
        "sections": [
          "files.tree",
          "files.bookmarks"
        ],
        "layout": "list"
      },
      {
        "id": "set-page",
        "title": "페이지",
        "sections": [
          "browser.dom",
          "browser.network"
        ],
        "layout": "tabs"
      },
      {
        "id": "set-browser",
        "title": "브라우저",
        "sections": [
          "browser.tabs",
          "browser.history"
        ],
        "layout": "tabs"
      }
    ],
    "links": [
      {
        "place": "left",
        "plugin": null,
        "set": "set-install"
      },
      {
        "place": "window-right",
        "plugin": "browser",
        "set": "set-browser"
      }
    ]
  }
}
