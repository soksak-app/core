{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lets the main webview, the modal webviews and the surface webviews call the app's own commands.",
  "windows": [
    "main",
    "project-*"
  ],
  "webviews": [
    "main",
    "modal-*",
    "surface-*",
    "project-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging"
  ]
}
