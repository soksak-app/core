{
  "surface": "packages/plugin-api/binder.js#createBinder",
  "description": "Ordered calls and events exercise the binder contract used by plugin pages. Each step observes command calls, change notifications, failures, element markings, audit results, or errors. A bind step names its event type with event (default click), and its when is {key}: the predicate accepts an event whose key equals key. A keydown event step carries key.",
  "cases": [
    {
      "id": "binder.bind.runs-declared-command",
      "steps": [
        {
          "bind": {
            "id": "direct",
            "tag": "button",
            "command": "fixture.save",
            "params": {
              "id": "a"
            }
          },
          "output": {
            "calls": [],
            "changed": 1,
            "failed": [],
            "result": null,
            "error": null,
            "element": {
              "command": "fixture.save",
              "params": "{\"id\":\"a\"}"
            }
          }
        },
        {
          "event": {
            "id": "direct",
            "type": "click"
          },
          "output": {
            "calls": [
              {
                "name": "fixture.save",
                "params": {
                  "id": "a"
                },
                "element": "direct"
              }
            ],
            "changed": 1,
            "failed": [],
            "result": null,
            "error": null,
            "element": {
              "command": "fixture.save",
              "params": "{\"id\":\"a\"}"
            }
          }
        }
      ]
    },
