{
  "surface": "packages/plugin-api/index.js#validateDiagnostics",
  "description": "Ordered validator calls fix a diagnostics exposure extension and refusals for duplicate names, missing surfaces, invalid module paths, and unknown members.",
  "cases": [
    {
      "id": "diagnostics.accepts-declared-extension",
      "steps": [
        {
          "call": {
            "manifest": {
              "id": "probe",
              "surface": {
                "module": "ui/probe.js"
              },
              "exposes": {
                "commands": [
                  {
                    "name": "probe.send",
                    "description": "Sends.",
                    "params": {
                      "type": "object",
                      "properties": {}
                    },
                    "result": {
                      "type": "null"
                    }
                  }
                ]
              }
            },
            "diagnostics": {
              "module": "ui/probe-diagnostics.js",
              "exposes": {
                "commands": [
                  {
                    "name": "probe.inject",
                    "description": "Injects.",
                    "params": {
                      "type": "object",
                      "properties": {}
                    },
                    "result": {
                      "type": "null"
                    }
                  }
                ]
              }
            }
          },
          "output": {
            "accepted": true,
            "result": {
              "module": "ui/probe-diagnostics.js",
              "exposes": {
                "commands": [
                  {
                    "name": "probe.inject",
                    "description": "Injects.",
                    "params": {
                      "type": "object",
                      "properties": {}
                    },
                    "result": {
                      "type": "null"
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    {
      "id": "diagnostics.refuses-duplicate-name",
