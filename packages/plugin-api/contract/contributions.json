{
  "surface": "packages/plugin-api/index.js#resolveContributions",
  "description": "Resolved contributions of the installed and enabled plugins, one case per outcome of resolveContributions. A case gives installed, the plugins of {id, package, version, manifest}, and output, the items that the function returns in order. Each item is {plugin, point, index, state, reason}; a connected item also has provider, item (the fields without range and module) and module (a URL on the core root). The states are connected, provider-missing, invalid (an undeclared extension point, a provider without extends, or an item that does not match the schema) and version-mismatch (the range does not contain the declared version). Items are sorted by plugin id, point and index.",
  "cases": [
    {
      "id": "contributions.resolve.connects-a-matching-item",
      "installed": [
        {
          "id": "probe",
          "package": "@scope/plugin-probe",
          "version": "0.1.0",
          "manifest": {
            "id": "probe",
            "name": "Probe",
            "description": "검사용 표면.",
            "mark": "p",
            "icon": "<path/>",
            "surface": {
              "module": "ui/probe.js",
              "composition": {
                "kind": "hybrid",
                "regions": [
                  {
                    "name": "page",
                    "kind": "document",
                    "input": "native"
                  }
                ],
                "overlays": []
              }
            },
            "extends": {
              "language": {
                "version": "1.2.0",
                "schema": {
                  "type": "object",
                  "properties": {
                    "extensions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "id": "tidy",
          "package": "@scope/plugin-tidy",
          "version": "0.0.1",
          "manifest": {
            "id": "tidy",
            "name": "tidy",
            "description": "검사용 기여.",
            "contributes": {
              "probe.language": [
                {
                  "range": "^1.0.0",
                  "module": "ui/tidy.js",
                  "extensions": [
                    "tidy"
                  ]
                }
              ]
            }
          }
        }
      ],
      "output": [
        {
          "plugin": "tidy",
          "point": "probe.language",
          "index": 0,
          "state": "connected",
          "reason": null,
          "provider": "probe",
          "item": {
            "extensions": [
              "tidy"
            ]
          },
          "module": "/modules/@scope/plugin-tidy/ui/tidy.js"
        }
      ]
    },
