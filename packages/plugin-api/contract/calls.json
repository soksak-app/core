{
  "surface": "packages/plugin-api/calls.js#createCalls",
  "description": "Ordered steps of the time limit of a call: a request step sends a command call (timeout is the declared limit, default 10000 ms), an advance step moves the clock, and a reply step delivers a reply from the peer. Each step lists the messages sent, the reports of the call layer (timeout, late-reply, open-calls) and the settled outcome of the request that the step watches: {resolved} or {rejected, code}, or null while the call is open. A call that its limit ends is rejected with code -32000 and the message command <name> did not reply within <ms>ms; a reply that arrives after that is a late reply, reported with its delay and not passed to the call.",
  "cases": [
    {
      "id": "calls.limit.default-limit-rejects-a-silent-call",
      "steps": [
        {
          "request": {
            "name": "a",
            "command": "demo.open",
            "params": {
              "id": "x"
            }
          },
          "watch": "a",
          "output": {
            "sent": [
              {
                "id": 1,
                "command": "demo.open",
                "params": {
                  "id": "x"
                }
              }
            ],
            "reports": [
              {
                "kind": "open-calls",
                "plugin": "probe",
                "count": 1,
                "oldestStartedAt": 0
              }
            ],
            "outcome": null
          }
        },
        {
          "advance": 9999,
          "watch": "a",
          "output": {
            "sent": [],
            "reports": [],
            "outcome": null
          }
        },
        {
          "advance": 1,
          "watch": "a",
          "output": {
            "sent": [],
            "reports": [
              {
                "kind": "timeout",
                "plugin": "probe",
                "command": "demo.open",
                "timeout": 10000
              },
              {
                "kind": "open-calls",
                "plugin": "probe",
                "count": 0,
                "oldestStartedAt": null
              }
            ],
            "outcome": {
              "rejected": "command demo.open did not reply within 10000ms",
              "code": -32000
            }
          }
        }
      ]
    },
    {
