    {"id":"view.bridge.sidecar-subscriptions","steps":[{"action":"create","output":{"ready":true}},{"action":"sidecar-subscribe","input":{"kind":"message","sidecar":"fixture-sidecar","id":"probe-surface"},"output":{"sok":1,"id":1,"command":"runtime.sidecar.on","params":{"id":"probe-surface","sidecar":"fixture-sidecar"}}},{"action":"host-reply","input":{"sok":1,"id":1,"result":null}},{"action":"sidecar-subscribe","input":{"kind":"failure","sidecar":"fixture-sidecar","id":"probe-surface"},"output":{"sok":1,"id":2,"command":"runtime.sidecar.onFailure","params":{"id":"probe-surface","sidecar":"fixture-sidecar"}}},{"action":"host-reply","input":{"sok":1,"id":2,"result":null}},{"action":"host-event","input":{"event":"sidecar.message","data":{"id":"probe-surface","body":"probe-answer"},"sok":1},"output":{"messages":["probe-answer"],"failures":[]}},{"action":"host-event","input":{"event":"sidecar.message","data":{"id":"other-surface","body":"not-for-probe"},"sok":1},"output":{"messages":["probe-answer"],"failures":[]}},{"action":"host-event","input":{"event":"sidecar.failure","data":{"id":"probe-surface","reason":"probe-failure"},"sok":1},"output":{"messages":["probe-answer"],"failures":["probe-failure"]}}]}
