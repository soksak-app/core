{
  "surface": "packages/plugin-api/binder.js#INTERACTIVE",
  "description": "The operable elements of a document and the audit rows that createBinder reports for them. The selector is the list of element kinds that an audit examines; an element inside an inert subtree cannot be operated and is not examined. Each case marks up a delegated root (markup) and lists the audit rows in document order; an element with a command inside the delegated root and an element name is connected and not listed. A row holds the ARIA role of the element (its role attribute, else the implicit role of its tag and input type, textbox for a contenteditable element, or null for an input type without a role), the element name or null, the command or null, and the text, which is the aria-label, else the title, else the text content, trimmed and cut to 40 characters.",
  "selector": "button, input, select, textarea, [role=\"button\"], [contenteditable]:not([contenteditable=\"false\"])",
  "cases": [
    {
      "id": "interactive.audit.lists-unconnected-and-unnamed-elements",
      "markup": "<button data-expose='demo.save' data-command='fixture.save'>Save</button><button>Free</button><input type='text' data-expose='demo.name' data-command='fixture.set' data-value='text'><input type='text' data-expose='demo.note'><select data-expose='demo.mode' data-command='fixture.set'><option>a</option></select><textarea data-command='fixture.set' data-expose='demo.body'></textarea><textarea></textarea><div role='button' data-command='fixture.save' data-expose='demo.role'>Role</div><div role='button'>Bare</div><div contenteditable='true' data-command='fixture.set' data-expose='demo.editor'></div><div contenteditable='true'>Editable</div><div contenteditable='false'>Static</div><span>Plain</span>",
      "output": [
        { "role": "button", "expose": null, "command": null, "text": "Free" },
        { "role": "textbox", "expose": "demo.note", "command": null, "text": "" },
        { "role": "textbox", "expose": null, "command": null, "text": "" },
        { "role": "button", "expose": null, "command": null, "text": "Bare" },
        { "role": "textbox", "expose": null, "command": null, "text": "Editable" }
      ]
    },
    {
      "id": "interactive.audit.role-takes-the-attribute-then-the-implicit-role",
      "markup": "<input type='checkbox'><input type='radio'><input type='range'><input type='number'><input type='search'><input type='email' list='suggestions'><input type='submit' value='Send'><input type='color'><input><select><option>a</option></select><select multiple><option>a</option></select><button role='switch'>Mode</button><span contenteditable='true' role='searchbox'></span>",
      "output": [
        { "role": "checkbox", "expose": null, "command": null, "text": "" },
        { "role": "radio", "expose": null, "command": null, "text": "" },
        { "role": "slider", "expose": null, "command": null, "text": "" },
        { "role": "spinbutton", "expose": null, "command": null, "text": "" },
        { "role": "searchbox", "expose": null, "command": null, "text": "" },
        { "role": "combobox", "expose": null, "command": null, "text": "" },
        { "role": "button", "expose": null, "command": null, "text": "" },
        { "role": null, "expose": null, "command": null, "text": "" },
        { "role": "textbox", "expose": null, "command": null, "text": "" },
        { "role": "combobox", "expose": null, "command": null, "text": "a" },
        { "role": "listbox", "expose": null, "command": null, "text": "a" },
        { "role": "switch", "expose": null, "command": null, "text": "Mode" },
        { "role": "searchbox", "expose": null, "command": null, "text": "" }
      ]
    },
    {
      "id": "interactive.audit.text-takes-label-then-title-then-truncates",
      "markup": "<button aria-label='Close dialog' title='Dismiss'>x</button><button title='Dismiss'>x</button><div role='button'>Adjust the layout of every visible panel in the window now</div>",
      "output": [
        { "role": "button", "expose": null, "command": null, "text": "Close dialog" },
        { "role": "button", "expose": null, "command": null, "text": "Dismiss" },
        { "role": "button", "expose": null, "command": null, "text": "Adjust the layout of every visible panel" }
      ]
    },
    {
      "id": "interactive.audit.skips-inert-subtrees",
      "markup": "<div inert><button data-command='fixture.save'>Kept</button><input type='text'></div><button>Free</button>",
      "output": [
        { "role": "button", "expose": null, "command": null, "text": "Free" }
      ]
    }
  ]
}
