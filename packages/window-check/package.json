{
  "name": "@soksak/window-check",
  "version": "0.0.21",
  "private": true,
  "description": "Harness for window checks against running soksak applications.",
  "type": "module",
  "exports": {
    "./app.mjs": "./app.mjs",
    "./endpoint-wait.mjs": "./endpoint-wait.mjs",
    "./folder-wait.mjs": "./folder-wait.mjs",
    "./event-log.mjs": "./event-log.mjs",
    "./frame.mjs": "./frame.mjs",
    "./frontmost.mjs": "./frontmost.mjs",
    "./log-policy.mjs": "./log-policy.mjs",
    "./view-calls.mjs": "./view-calls.mjs",
    "./view-metrics.mjs": "./view-metrics.mjs",
    "./lz4.mjs": "./lz4.mjs",
    "./pasteboard.mjs": "./pasteboard.mjs",
    "./png.mjs": "./png.mjs",
    "./repeat.mjs": "./repeat.mjs",
    "./session.mjs": "./session.mjs",
    "./shutdown-wait.mjs": "./shutdown-wait.mjs",
    "./stall-sample.mjs": "./stall-sample.mjs",
    "./text-difference.mjs": "./text-difference.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "app.mjs",
    "endpoint-wait.mjs",
    "folder-wait.mjs",
    "event-log.mjs",
    "frame.mjs",
    "frontmost.mjs",
    "log-policy.mjs",
    "view-calls.mjs",
    "view-metrics.mjs",
    "lz4.mjs",
    "pasteboard.mjs",
    "png.mjs",
    "repeat.mjs",
    "session.mjs",
    "shutdown-wait.mjs",
    "stall-sample.mjs",
    "text-difference.mjs"
  ],
  "bin": {
    "soksak-window-repeat": "./repeat.mjs"
  },
  "scripts": {
    "test": "node --test --experimental-test-module-mocks test/*.test.mjs"
  },
  "dependencies": {
    "@parcel/watcher": "2.6.0",
    "@soksak/client": "workspace:*",
    "@soksak/log-contract": "workspace:*"
  }
}
