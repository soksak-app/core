{
  "name": "soksak-workspace",
  "private": true,
  "description": "Workspace for the soksak layout library, its workbench frontend, plugins, and example applications.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -F soksak build",
    "test": "node scripts/node-tests.mjs",
    "test:scripts": "node --test scripts/test/*.test.mjs scripts/test/platform/darwin/*.test.mjs",
    "fuzz": "pnpm -F soksak fuzz",
    "mutate": "pnpm -F soksak mutate",
    "breaks": "pnpm -F soksak breaks",
    "example": "make browser-example"
  },
  "license": "MIT",
  "author": "soksak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soksak-app/core.git"
  },
  "dependencies": {
    "@soksak/client": "workspace:*",
    "@soksak/window-check": "workspace:*"
  },
  "devDependencies": {
    "@soksak/kit-events": "https://github.com/soksak-app/kit-events/releases/download/v0.0.1/soksak-kit-events-0.0.1.tgz",
    "@soksak/kit-records": "https://github.com/soksak-app/kit-records/releases/download/v0.0.6/soksak-kit-records-0.0.6.tgz",
    "acorn": "8.18.0",
    "yaml": "2.9.1"
  }
}
