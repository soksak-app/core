{
  "name": "soksak-workspace",
  "private": true,
  "description": "Workspace for the soksak layout library, its workbench frontend, plugins, and example applications.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -F soksak build",
    "test": "node --test scripts/test/*.test.mjs && pnpm -r test",
    "fuzz": "pnpm -F soksak fuzz",
    "mutate": "pnpm -F soksak mutate",
    "breaks": "pnpm -F soksak breaks",
    "example": "pnpm -F @soksak/browser dev"
  },
  "license": "MIT",
  "author": "min-median-max",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/min-median-max/soksak.git"
  }
}
