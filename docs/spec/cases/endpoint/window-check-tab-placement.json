{
  "name": "window-check-tab-placement",
  "description": "A view opens as a tab of a card, closes as a tab and leaves the registry of the surfaces; a close that the host reports as not closed fails.",
  "replay": false,
  "reason": "The case closes the views of a measured group and reads the processes that the close leaves, which need views of a plugin that the replay does not open.",
  "steps": [
    {"send":{"jsonrpc":"2.0","id":1,"method":"command.run","params":{"window":"main","name":"core.card.add-tab","params":{"card":"card-1","plugin":"fixture","params":{"path":"a.txt"}}}}},
    {"reply":{"jsonrpc":"2.0","id":1,"result":{"tab":"view-1"}}},
    {"send":{"jsonrpc":"2.0","id":2,"method":"command.run","params":{"window":"main","name":"core.tab.close","params":{"tab":"view-1"}}}},
    {"reply":{"jsonrpc":"2.0","id":2,"result":{"closed":true}}},
    {"send":{"jsonrpc":"2.0","id":3,"method":"status.watch","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":null}},
    {"send":{"jsonrpc":"2.0","id":4,"method":"status.get","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":4,"result":[]}},
    {"send":{"jsonrpc":"2.0","id":5,"method":"status.unwatch","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":5,"result":null}},
    {"send":{"jsonrpc":"2.0","id":6,"method":"command.run","params":{"window":"main","name":"core.tab.close","params":{"tab":"view-1"}}}},
    {"reply":{"jsonrpc":"2.0","id":6,"result":{"closed":false}}}
  ]
}
