{
  "name": "surface-window",
  "description": "surface.window asks the page of each ready window in the order of windows.list and answers the window and the space of the first page that holds the surface, with the space null for a section surface that a sidebar of that window draws; without one, a window that is not ready makes it 1003, and a surface that is missing or not a non-empty string is answered with -32602 without a page call.",
  "replay": false,
  "reason": "The page of the case is a script that the host producers play; a running application has a page of its own that answers differently.",
  "page": "scripted",
  "windows": ["loading", "main", "other"],
  "ready": ["main", "other"],
  "steps": [
    {"send": {"jsonrpc": "2.0", "id": 1, "method": "surface.window", "params": {"surface": "tab-b2"}}},
    {"page": {"call": {"window": "main", "name": "surface.window", "payload": {"surface": "tab-b2"}}}},
    {"page": {"reply": {"result": null}}},
    {"page": {"call": {"window": "other", "name": "surface.window", "payload": {"surface": "tab-b2"}}}},
    {"page": {"reply": {"result": {"space": "spc-b"}}}},
    {"reply": {"jsonrpc": "2.0", "id": 1, "result": {"window": "other", "space": "spc-b"}}},
    {"send": {"jsonrpc": "2.0", "id": 2, "method": "surface.window", "params": {"surface": "tab-z9"}}},
    {"page": {"call": {"window": "main", "name": "surface.window", "payload": {"surface": "tab-z9"}}}},
    {"page": {"reply": {"result": null}}},
    {"page": {"call": {"window": "other", "name": "surface.window", "payload": {"surface": "tab-z9"}}}},
    {"page": {"reply": {"result": null}}},
    {"reply": {"jsonrpc": "2.0", "id": 2, "error": {"code": 1003, "message": "window \"loading\" is not ready"}}},
    {"send": {"jsonrpc": "2.0", "id": 3, "method": "surface.window", "params": {"surface": ""}}},
    {"reply": {"jsonrpc": "2.0", "id": 3, "error": {"code": -32602, "message": "surface must be a non-empty string"}}},
    {"send": {"jsonrpc": "2.0", "id": 4, "method": "surface.window", "params": {"window": "main"}}},
    {"reply": {"jsonrpc": "2.0", "id": 4, "error": {"code": -32602, "message": "surface must be a non-empty string"}}},
    {"send": {"jsonrpc": "2.0", "id": 5, "method": "surface.window"}},
    {"reply": {"jsonrpc": "2.0", "id": 5, "error": {"code": -32602, "message": "params must be an object"}}},
    {"send": {"jsonrpc": "2.0", "id": 6, "method": "surface.window", "params": {"surface": "spc-b/sidebar-left/files"}}},
    {"page": {"call": {"window": "main", "name": "surface.window", "payload": {"surface": "spc-b/sidebar-left/files"}}}},
    {"page": {"reply": {"result": null}}},
    {"page": {"call": {"window": "other", "name": "surface.window", "payload": {"surface": "spc-b/sidebar-left/files"}}}},
    {"page": {"reply": {"result": {"space": null}}}},
    {"reply": {"jsonrpc": "2.0", "id": 6, "result": {"window": "other", "space": null}}}
  ]
}
