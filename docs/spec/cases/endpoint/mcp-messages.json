{
  "name": "mcp-messages",
  "description": "messages_read and messages_wait of sok mcp find the window of the terminal with surface.window and its plugin with exposure.snapshot of that window and surface, and run the command <plugin>.messages.read or <plugin>.messages.wait on the surface with the after and the registration of the call that are present; the result and the error of the command are the answer of the tool. A terminal in no window and a surface whose plugin registers no messaging command fail with unknown-terminal before any command, and a cancelled wait ends without a result while its command stays open, whose later answer the server discards and then answers the next call.",
  "replay": false,
  "reason": "The commands are those of a terminal plugin, which core does not name, and the client cancels a call, which the replay of the application cannot do.",
  "variables": {
    "messages": { "type": "object", "keys": ["registration", "messages", "last"], "example": { "registration": "r1", "messages": [{ "seq": 3, "path": "s2.a.txt", "text": "hello", "from": "s2" }], "last": 3 } },
    "empty": { "type": "object", "keys": ["registration", "messages", "last"], "example": { "registration": "r1", "messages": [], "last": 3 } }
  },
  "steps": [
    { "send": { "jsonrpc": "2.0", "id": 1, "method": "surface.window", "params": { "surface": "t1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "result": { "window": "main", "space": "s" } } },
    { "send": { "jsonrpc": "2.0", "id": 2, "method": "exposure.snapshot", "params": { "window": "main", "surface": "t1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": { "window": { "title": "soksak", "project": "/p" }, "layout": null, "plugins": [], "groups": [{ "owner": "host", "status": [], "commands": [], "element": [] }, { "owner": "surface", "surface": "t1", "plugin": "terminal", "kind": "view", "state": "ready", "visible": true, "status": [], "commands": [{ "name": "terminal.messages.read", "description": "Reads the messages.", "params": {} }, { "name": "terminal.messages.wait", "description": "Waits for messages.", "params": {} }], "element": [] }], "unregistered": [] } } },
    { "send": { "jsonrpc": "2.0", "id": 3, "method": "command.run", "params": { "window": "main", "surface": "t1", "name": "terminal.messages.read", "params": {} } } },
    { "reply": { "jsonrpc": "2.0", "id": 3, "result": "$empty" } },
    { "send": { "jsonrpc": "2.0", "id": 4, "method": "surface.window", "params": { "surface": "t1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 4, "result": { "window": "main", "space": "s" } } },
    { "send": { "jsonrpc": "2.0", "id": 5, "method": "exposure.snapshot", "params": { "window": "main", "surface": "t1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 5, "result": { "window": { "title": "soksak", "project": "/p" }, "layout": null, "plugins": [], "groups": [{ "owner": "surface", "surface": "t1", "plugin": "terminal", "kind": "view", "state": "ready", "visible": true, "status": [], "commands": [{ "name": "terminal.messages.read", "description": "Reads the messages.", "params": {} }, { "name": "terminal.messages.wait", "description": "Waits for messages.", "params": {} }], "element": [] }], "unregistered": [] } } },
    { "send": { "jsonrpc": "2.0", "id": 6, "method": "command.run", "params": { "window": "main", "surface": "t1", "name": "terminal.messages.wait", "params": { "after": 2, "registration": "r1" } } } },
    { "reply": { "jsonrpc": "2.0", "id": 6, "result": "$messages" } },
    { "send": { "jsonrpc": "2.0", "id": 7, "method": "surface.window", "params": { "surface": "t1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 7, "result": { "window": "main", "space": "s" } } },
    { "send": { "jsonrpc": "2.0", "id": 8, "method": "exposure.snapshot", "params": { "window": "main", "surface": "t1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 8, "result": { "window": { "title": "soksak", "project": "/p" }, "layout": null, "plugins": [], "groups": [{ "owner": "surface", "surface": "t1", "plugin": "terminal", "kind": "view", "state": "ready", "visible": true, "status": [], "commands": [{ "name": "terminal.messages.read", "description": "Reads the messages.", "params": {} }, { "name": "terminal.messages.wait", "description": "Waits for messages.", "params": {} }], "element": [] }], "unregistered": [] } } },
    { "send": { "jsonrpc": "2.0", "id": 9, "method": "command.run", "params": { "window": "main", "surface": "t1", "name": "terminal.messages.read", "params": { "after": 3, "registration": "r0" } } } },
    { "reply": { "jsonrpc": "2.0", "id": 9, "error": { "code": -32000, "message": "terminal.messages.read: epoch-changed: the registration r0 is not the current registration r1" } } },
    { "send": { "jsonrpc": "2.0", "id": 10, "method": "surface.window", "params": { "surface": "gone" } } },
    { "reply": { "jsonrpc": "2.0", "id": 10, "error": { "code": 1012, "message": "surface gone is in no window" } } },
    { "send": { "jsonrpc": "2.0", "id": 11, "method": "surface.window", "params": { "surface": "e1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 11, "result": { "window": "main", "space": "s" } } },
    { "send": { "jsonrpc": "2.0", "id": 12, "method": "exposure.snapshot", "params": { "window": "main", "surface": "e1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 12, "result": { "window": { "title": "soksak", "project": "/p" }, "layout": null, "plugins": [], "groups": [{ "owner": "surface", "surface": "e1", "plugin": "editor", "kind": "view", "state": "ready", "visible": true, "status": [], "commands": [{ "name": "editor.save", "description": "Saves.", "params": {} }], "element": [] }], "unregistered": [] } } },
    { "send": { "jsonrpc": "2.0", "id": 13, "method": "surface.window", "params": { "surface": "t1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 13, "result": { "window": "main", "space": "s" } } },
    { "send": { "jsonrpc": "2.0", "id": 14, "method": "exposure.snapshot", "params": { "window": "main", "surface": "t1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 14, "result": { "window": { "title": "soksak", "project": "/p" }, "layout": null, "plugins": [], "groups": [{ "owner": "surface", "surface": "t1", "plugin": "terminal", "kind": "view", "state": "ready", "visible": true, "status": [], "commands": [{ "name": "terminal.messages.read", "description": "Reads the messages.", "params": {} }, { "name": "terminal.messages.wait", "description": "Waits for messages.", "params": {} }], "element": [] }], "unregistered": [] } } },
    { "send": { "jsonrpc": "2.0", "id": 15, "method": "command.run", "params": { "window": "main", "surface": "t1", "name": "terminal.messages.wait", "params": { "after": 3, "registration": "r1" } } } },
    { "send": { "jsonrpc": "2.0", "id": 16, "method": "surface.window", "params": { "surface": "t1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 15, "result": "$messages" } },
    { "reply": { "jsonrpc": "2.0", "id": 16, "result": { "window": "main", "space": "s" } } },
    { "send": { "jsonrpc": "2.0", "id": 17, "method": "exposure.snapshot", "params": { "window": "main", "surface": "t1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 17, "result": { "window": { "title": "soksak", "project": "/p" }, "layout": null, "plugins": [], "groups": [{ "owner": "surface", "surface": "t1", "plugin": "terminal", "kind": "view", "state": "ready", "visible": true, "status": [], "commands": [{ "name": "terminal.messages.read", "description": "Reads the messages.", "params": {} }, { "name": "terminal.messages.wait", "description": "Waits for messages.", "params": {} }], "element": [] }], "unregistered": [] } } },
    { "send": { "jsonrpc": "2.0", "id": 18, "method": "command.run", "params": { "window": "main", "surface": "t1", "name": "terminal.messages.read", "params": {} } } },
    { "reply": { "jsonrpc": "2.0", "id": 18, "result": "$empty" } }
  ],
  "mcp": {
    "steps": [
      { "tool": "messages_read", "arguments": { "terminal": "t1" }, "result": "$empty" },
      { "tool": "messages_wait", "arguments": { "terminal": "t1", "after": 2, "registration": "r1" }, "result": "$messages" },
      { "tool": "messages_read", "arguments": { "terminal": "t1", "after": 3, "registration": "r0" }, "error": "terminal.messages.read: epoch-changed: the registration r0 is not the current registration r1 (-32000)" },
      { "received": "command.run" },
      { "received": "command.run" },
      { "received": "command.run" },
      { "tool": "messages_read", "arguments": { "terminal": "gone" }, "error": "unknown-terminal: surface gone is in no window" },
      { "tool": "messages_wait", "arguments": { "terminal": "e1" }, "error": "unknown-terminal: surface e1 of plugin editor registers no command editor.messages.wait" },
      { "tool": "messages_wait", "arguments": { "terminal": "t1", "after": 3, "registration": "r1" }, "as": "waiting" },
      { "received": "command.run", "contains": "\"terminal.messages.wait\",\"params\":{\"after\":3,\"registration\":\"r1\"}" },
      { "cancel": "waiting" },
      { "tool": "messages_read", "arguments": { "terminal": "t1" }, "result": "$empty" }
    ]
  }
}
