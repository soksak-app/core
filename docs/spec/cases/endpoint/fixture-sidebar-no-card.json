{
  "name": "fixture-sidebar-no-card",
  "description": "A card sidebar of a plugin that no card shows as an active tab fails after the link, when the grid names no such card.",
  "replay": false,
  "reason": "The case plays the requests of the start state of a check on a workbench with a layout that the replay cannot arrange.",
  "steps": [
    {"send":{"jsonrpc":"2.0","id":1,"method":"status.get","params":{"window":"main","name":"core.settings"}}},
    {"reply":{"jsonrpc":"2.0","id":1,"result":{"common":{},"values":{"sets":[]}}}},
    {"send":{"jsonrpc":"2.0","id":2,"method":"status.get","params":{"window":"main","name":"core.settings"}}},
    {"reply":{"jsonrpc":"2.0","id":2,"result":{"common":{},"values":{"sets":[]}}}},
    {"send":{"jsonrpc":"2.0","id":3,"method":"command.run","params":{"window":"main","name":"core.settings.set","params":{"patch":{"sets":[{"id":"check-sections","title":"검사","sections":["layoutprobe.alpha","layoutprobe.fill","layoutprobe.follow"],"layout":"list"}]},"scope":"common"}}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":null}},
    {"send":{"jsonrpc":"2.0","id":4,"method":"command.run","params":{"window":"main","name":"core.settings.link","params":{"place":"card-left","plugin":"layoutprobe","set":"check-sections","scope":"common"}}}},
    {"reply":{"jsonrpc":"2.0","id":4,"result":null}},
    {"send":{"jsonrpc":"2.0","id":5,"method":"status.get","params":{"window":"main","name":"core.grid"}}},
    {"reply":{"jsonrpc":"2.0","id":5,"result":{"cards":[{"id":"left","fixed":true,"focused":false,"active":null},{"id":"upper","focused":true,"active":"t1","tabs":[{"id":"t1","plugin":"starter-a"}]},{"id":"lower","focused":false,"active":"b1","tabs":[{"id":"b1","plugin":"starter-b"}]}]}}}
  ]
}
