{
  "name": "window-check-presses-held-refused",
  "description": "A release that the host refuses with 1007 while a person holds a button keeps the press open; the cleanup waits until status.watch of host.buttons reports mask 0, releases the press, and a later press and release are delivered.",
  "replay": false,
  "reason": "The case sends native pointer input and the held button is the state of a person, so the replay cannot arrange it.",
  "steps": [
    {"send": {"jsonrpc": "2.0", "id": 1, "method": "input.pointer", "params": {"window": "main", "x": 10, "y": 20, "phase": "down"}}},
    {"reply": {"jsonrpc": "2.0", "id": 1, "result": null}},
    {"send": {"jsonrpc": "2.0", "id": 2, "method": "input.pointer", "params": {"window": "main", "x": 10, "y": 20, "phase": "up"}}},
    {"reply": {"jsonrpc": "2.0", "id": 2, "error": {"code": 1007, "message": "AppKit reports NSEvent.pressedMouseButtons mask 0x1 while com.apple.finder (pid 667) is frontmost"}}},
    {"send": {"jsonrpc": "2.0", "id": 3, "method": "status.watch", "params": {"window": "main", "name": "host.buttons"}}},
    {"reply": {"jsonrpc": "2.0", "id": 3, "result": null}},
    {"send": {"jsonrpc": "2.0", "id": 4, "method": "status.get", "params": {"window": "main", "name": "host.buttons"}}},
    {"reply": {"jsonrpc": "2.0", "id": 4, "result": {"mask": 1}}},
    {"notify": {"jsonrpc": "2.0", "method": "status.changed", "params": {"window": "main", "name": "host.buttons", "value": {"mask": 0}}}},
    {"send": {"jsonrpc": "2.0", "id": 5, "method": "status.unwatch", "params": {"window": "main", "name": "host.buttons"}}},
    {"reply": {"jsonrpc": "2.0", "id": 5, "result": null}},
    {"send": {"jsonrpc": "2.0", "id": 6, "method": "input.pointer", "params": {"window": "main", "x": 10, "y": 20, "phase": "up", "button": "left"}}},
    {"reply": {"jsonrpc": "2.0", "id": 6, "result": null}},
    {"send": {"jsonrpc": "2.0", "id": 7, "method": "input.pointer", "params": {"window": "main", "x": 10, "y": 20, "phase": "down"}}},
    {"reply": {"jsonrpc": "2.0", "id": 7, "result": null}},
    {"send": {"jsonrpc": "2.0", "id": 8, "method": "input.pointer", "params": {"window": "main", "x": 10, "y": 20, "phase": "up"}}},
    {"reply": {"jsonrpc": "2.0", "id": 8, "result": null}}
  ]
}
