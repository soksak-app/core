{
  "name": "section-view-open",
  "description": "A section view splits the tallest card with a layout probe tab at its bottom, waits until the card-left sidebar of the new card shows the section, reads the project and the grid, and answers the surface of the section.",
  "replay": false,
  "reason": "The case plays the requests of a section view check on a workbench with a layout that the replay cannot arrange.",
  "steps": [
    {"send":{"jsonrpc":"2.0","id":1,"method":"status.get","params":{"window":"main","name":"core.grid"}}},
    {"reply":{"jsonrpc":"2.0","id":1,"result":{"cards":[{"id":"card-1","x":0,"y":0,"w":400,"h":200,"r0":0,"r1":1,"c0":0,"c1":1,"tabs":[{"id":"t-1","plugin":"layoutprobe"}]},{"id":"card-2","x":0,"y":0,"w":400,"h":420,"r0":0,"r1":1,"c0":0,"c1":1,"tabs":[{"id":"t-2","plugin":"layoutprobe"}]},{"id":"card-3","x":0,"y":0,"w":400,"h":500,"r0":0,"r1":1,"c0":0,"c1":1,"tabs":[{"id":"plain-1","plugin":"probeplain"}]}]}}},
    {"send":{"jsonrpc":"2.0","id":2,"method":"command.run","params":{"window":"main","name":"core.card.split","params":{"card":"card-2","side":"bottom","plugin":"layoutprobe"}}}},
    {"reply":{"jsonrpc":"2.0","id":2,"result":{"card":"card-4","tab":"t-4"}}},
    {"send":{"jsonrpc":"2.0","id":3,"method":"status.watch","params":{"window":"main","name":"core.sidebars"}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":null}},
    {"send":{"jsonrpc":"2.0","id":4,"method":"status.get","params":{"window":"main","name":"core.sidebars"}}},
    {"reply":{"jsonrpc":"2.0","id":4,"result":[{"sidebar":"card-1:left","placement":"card","card":"card-1","sections":[{"id":"probeplain.section","surfaceId":"spc-1/card-1:left/probeplain.section"}]}]}},
    {"notify":{"jsonrpc":"2.0","method":"status.changed","params":{"window":"main","name":"core.sidebars","value":[{"sidebar":"card-1:left","placement":"card","card":"card-1","sections":[{"id":"probeplain.section","surfaceId":"spc-1/card-1:left/probeplain.section"}]},{"sidebar":"card-4:left","placement":"card","card":"card-4","sections":[{"id":"probeplain.section","surfaceId":"spc-1/card-4:left/probeplain.section"}]}]}}},
    {"send":{"jsonrpc":"2.0","id":5,"method":"status.unwatch","params":{"window":"main","name":"core.sidebars"}}},
    {"reply":{"jsonrpc":"2.0","id":5,"result":null}},
    {"send":{"jsonrpc":"2.0","id":6,"method":"status.get","params":{"window":"main","name":"core.project"}}},
    {"reply":{"jsonrpc":"2.0","id":6,"result":{"id":"project-1","root":"/config/test-project"}}},
    {"send":{"jsonrpc":"2.0","id":7,"method":"status.get","params":{"window":"main","name":"core.grid"}}},
    {"reply":{"jsonrpc":"2.0","id":7,"result":{"cards":[{"id":"card-1","x":0,"y":0,"w":400,"h":200,"r0":0,"r1":1,"c0":0,"c1":1,"tabs":[{"id":"t-1","plugin":"layoutprobe"}]},{"id":"card-2","x":0,"y":0,"w":400,"h":420,"r0":0,"r1":1,"c0":0,"c1":1,"tabs":[{"id":"t-2","plugin":"layoutprobe"}]},{"id":"card-3","x":0,"y":0,"w":400,"h":500,"r0":0,"r1":1,"c0":0,"c1":1,"tabs":[{"id":"plain-1","plugin":"probeplain"}]},{"id":"card-4","x":0,"y":0,"w":400,"h":200,"r0":0,"r1":1,"c0":0,"c1":1,"tabs":[{"id":"t-4","plugin":"layoutprobe"}],"active":"t-4"}]}}}
  ]
}
