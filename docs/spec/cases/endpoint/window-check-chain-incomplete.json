    ], "next": null, "tail": { "host-b": 2 }, "scanned": { "logs": 1, "segments": 1, "read": 2, "lines": 2, "rebuilt": 0 }, "rejected": null } } },
    { "send": { "jsonrpc": "2.0", "id": 3, "method": "log.query", "params": { "channel": "all", "cid": "p1.6" } } },
