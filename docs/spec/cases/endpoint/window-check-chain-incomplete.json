      { "role": "host", "boot": "b", "file": "logs/host-b.jsonl", "offset": 120, "event": { "ts_us": 1791000000000002, "seq": 2, "level": "info", "layer": "host", "event": "workbench.call", "cids": ["p1.6"] } }
