{
  "name": "window-check-recorded-view-content-lacks",
  "description": "The value of a view lacks the expected content: the recording stops at once and the window is not presented.",
  "replay": false,
  "reason": "The case opens a view of a plugin under a recording of the window, which needs a display and a plugin that the replay does not open.",
  "variables": {"frames":{"type":"string","example":"/captures/capture-1"},"stills":{"type":"string","example":"/captures/capture-1/stills.jsonl"}},
  "steps": [
    {"send":{"jsonrpc":"2.0","id":1,"method":"status.get","params":{"window":"main","name":"host.window"}}},
    {"reply":{"jsonrpc":"2.0","id":1,"result":{"refreshRate":1,"documents":[{"surface":"view-1","document":"","visible":true,"process":3141,"frame":{"x":0,"y":0,"width":1,"height":1}}]}}},
    {"send":{"jsonrpc":"2.0","id":2,"method":"diagnostics.window.draw-covered","params":{"window":"main","draw":true}}},
    {"reply":{"jsonrpc":"2.0","id":2,"result":null}},
    {"send":{"jsonrpc":"2.0","id":3,"method":"diagnostics.capture.start","params":{"window":"main","gap":1000,"frames":4096}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":{"frames":"$frames","window":7}}},
    {"send":{"jsonrpc":"2.0","id":4,"method":"diagnostics.clock","params":{"window":"main"}}},
    {"reply":{"jsonrpc":"2.0","id":4,"result":{"mono_ns":"5000000"}}},
    {"send":{"jsonrpc":"2.0","id":5,"method":"command.run","params":{"window":"main","name":"core.card.add-tab","params":{"card":"card-1","plugin":"fixture"}}}},
    {"reply":{"jsonrpc":"2.0","id":5,"result":{"tab":"view-1"}}},
    {"send":{"jsonrpc":"2.0","id":6,"method":"status.watch","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":6,"result":null}},
    {"send":{"jsonrpc":"2.0","id":7,"method":"status.get","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":7,"result":[{"surface":"view-1","exposes":["status fixture.ready"]}]}},
    {"send":{"jsonrpc":"2.0","id":8,"method":"status.unwatch","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":8,"result":null}},
    {"send":{"jsonrpc":"2.0","id":9,"method":"status.get","params":{"window":"main","name":"fixture.ready","surface":"view-1"}}},
    {"reply":{"jsonrpc":"2.0","id":9,"result":"ready"}},
    {"send":{"jsonrpc":"2.0","id":10,"method":"command.run","params":{"window":"main","name":"fixture.view.read","params":{},"surface":"view-1"}}},
    {"reply":{"jsonrpc":"2.0","id":10,"result":"loading"}},
    {"send":{"jsonrpc":"2.0","id":11,"method":"diagnostics.capture.stop","params":{"window":"main","after":0}}},
    {"reply":{"jsonrpc":"2.0","id":11,"result":{"frames":"$frames","stills":"$stills","count":2,"missed":0,"late":0}}},
    {"send":{"jsonrpc":"2.0","id":12,"method":"diagnostics.window.draw-covered","params":{"window":"main","draw":false}}},
    {"reply":{"jsonrpc":"2.0","id":12,"result":null}}
  ]
}
