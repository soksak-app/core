{
  "name": "sok-describe-parties",
  "description": "sok describe lists the parties of the window before the layout, and each card of the layout carries its party and leader.",
  "replay": true,
  "variables": {
    "snapshot": {
      "type": "object",
      "keys": [
        "window",
        "layout",
        "plugins",
        "groups",
        "unregistered"
      ],
      "example": {
        "window": {
          "window": "main",
          "title": "soksak",
          "project": null
        },
        "layout": {
          "space": "space-1",
          "focused": "a",
          "root": {
            "direction": "row",
            "size": 1,
            "children": [
              {
                "card": "a",
                "size": 0.5,
                "frame": {
                  "x": 0,
                  "y": 40,
                  "width": 600,
                  "height": 760
                },
                "tabs": [
                  {
                    "id": "t-a",
                    "plugin": "probe-plain"
                  }
                ]
              },
              {
                "card": "b",
                "size": 0.5,
                "frame": {
                  "x": 600,
                  "y": 40,
                  "width": 600,
                  "height": 760
                },
                "tabs": [
                  {
                    "id": "t-b",
                    "plugin": "probe-plain"
                  }
                ]
              }
            ]
          }
        },
        "plugins": [],
        "groups": [
          {
            "owner": "core",
            "status": [
              {
                "name": "core.parties",
                "description": "The parties of the window.",
                "schema": {},
                "value": [
                  {
                    "id": "p1",
                    "cards": [
                      "a",
                      "b"
                    ],
                    "leader": "a",
                    "color": "#112233",
                    "leaderColor": null,
                    "outline": [
                      [
                        [
                          0,
                          40
                        ],
                        [
                          1200,
                          40
                        ],
                        [
                          1200,
                          800
                        ],
                        [
                          0,
                          800
                        ]
                      ]
                    ],
                    "reason": "taken"
                  }
                ]
              }
            ],
            "commands": [],
            "element": []
          }
        ],
        "unregistered": []
      }
    }
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "windows.list"
      }
    },
    {
      "reply": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": [
          {
            "window": "main",
            "title": "soksak",
            "project": null,
            "key": true,
            "ready": true
          }
        ]
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "exposure.snapshot",
        "params": {
          "window": "main"
        }
      }
    },
    {
      "reply": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": "$snapshot"
      }
    },
    {
      "close": "client"
    }
  ]
}