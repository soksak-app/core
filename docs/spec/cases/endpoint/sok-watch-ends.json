{
  "name": "sok-watch-ends",
  "description": "A status watch on a surface ends with an error when status.ended names its status and surface; a status.ended of another status of the same surface does not end it.",
  "replay": false,
  "reason": "status.ended is sent when the producer of the status ends, which the window check does not end on demand.",
  "variables": {
    "value": { "type": "any", "example": 1 }
  },
  "steps": [
    { "send": { "jsonrpc": "2.0", "id": 1, "method": "status.watch", "params": { "name": "fixture.value", "surface": "tab", "window": "main" } } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 2, "method": "status.get", "params": { "name": "fixture.value", "surface": "tab", "window": "main" } } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": "$value" } },
    { "notify": { "jsonrpc": "2.0", "method": "status.ended", "params": { "name": "fixture.other", "reason": "surface-closed", "surface": "tab", "window": "main" } } },
    { "notify": { "jsonrpc": "2.0", "method": "status.ended", "params": { "name": "fixture.value", "reason": "surface-closed", "surface": "tab", "window": "main" } } },
    { "close": "host" }
  ]
}
