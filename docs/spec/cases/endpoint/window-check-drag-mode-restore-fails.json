    {"send":{"jsonrpc":"2.0","id":2,"method":"command.run","params":{"window":"main","name":"core.settings.set","params":{"patch":{"diagnostics.performance":false,"diagnostics.log":{"frame":"trace"}},"scope":"common"}}}},
