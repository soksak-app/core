    {"send":{"jsonrpc":"2.0","id":3,"method":"status.get","params":{"window":"main","name":"core.settings"}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":{"values":{"diagnostics.performance":false,"diagnostics.log":{"frame":"trace"}}}}},
    {"send":{"jsonrpc":"2.0","id":4,"method":"command.run","params":{"window":"main","name":"core.settings.set","params":{"patch":{"diagnostics.performance":true,"diagnostics.log":{"frame":"trace"}},"scope":"common"}}}},
