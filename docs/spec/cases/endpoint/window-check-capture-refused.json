{
  "name": "window-check-capture-refused",
  "description": "The host refuses a second start while a recording runs and a stop without a recording, and the window check session reports each refusal as the error of the session with the name of the application and the method.",
  "replay": false,
  "reason": "The case starts a capture of a window of the application, and the replay cannot choose the folder that the host creates.",
  "steps": [
    {"send": {"jsonrpc": "2.0", "id": 1, "method": "diagnostics.capture.start", "params": {"window": "main", "gap": 8.333333333333334, "frames": 4096}}},
    {"reply": {"jsonrpc": "2.0", "id": 1, "result": {"frames": "/captures/capture-1", "window": 7}}},
    {"send": {"jsonrpc": "2.0", "id": 2, "method": "diagnostics.capture.start", "params": {"window": "main", "gap": 8.333333333333334, "frames": 1}}},
    {"reply": {"jsonrpc": "2.0", "id": 2, "error": {"code": -32000, "message": "a capture into /captures/capture-1 is running"}}},
    {"send": {"jsonrpc": "2.0", "id": 3, "method": "diagnostics.capture.stop", "params": {"window": "main"}}},
    {"reply": {"jsonrpc": "2.0", "id": 3, "result": {"frames": "/captures/capture-1", "window": 7}}},
    {"send": {"jsonrpc": "2.0", "id": 4, "method": "diagnostics.capture.stop", "params": {"window": "main"}}},
    {"reply": {"jsonrpc": "2.0", "id": 4, "error": {"code": -32000, "message": "no capture is running"}}}
  ]
}
