    { "send": { "jsonrpc": "2.0", "id": 2, "method": "input.pointer", "params": { "phase": "drag", "pointer": "second", "window": "main", "x": 30, "y": 40 } } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 3, "method": "input.pointer", "params": { "phase": "drag", "pointer": "second", "window": "main", "x": 50, "y": 60 } } },
    { "reply": { "jsonrpc": "2.0", "id": 3, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 4, "method": "input.pointer", "params": { "clicks": 2, "phase": "up", "pointer": "second", "window": "main", "x": 50, "y": 60 } } },
    { "reply": { "jsonrpc": "2.0", "id": 4, "result": null } },
