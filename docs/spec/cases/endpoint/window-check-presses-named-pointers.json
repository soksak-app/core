{
  "name": "window-check-presses-named-pointers",
  "description": "A check session that left a press of each named pointer open releases each press at its own position, after status.watch of host.buttons reports mask 0 for it.",
  "replay": false,
  "reason": "The case sends native pointer input, and the replay cannot undo the press or the release that the input delivers.",
  "steps": [
    { "send": { "jsonrpc": "2.0", "id": 1, "method": "input.pointer", "params": { "window": "main", "x": 10, "y": 20, "phase": "down", "pointer": "first" } } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 2, "method": "input.pointer", "params": { "window": "main", "x": 30, "y": 40, "phase": "down", "pointer": "second" } } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 3, "method": "status.watch", "params": { "window": "main", "name": "host.buttons" } } },
    { "reply": { "jsonrpc": "2.0", "id": 3, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 4, "method": "status.get", "params": { "window": "main", "name": "host.buttons" } } },
    { "reply": { "jsonrpc": "2.0", "id": 4, "result": { "mask": 0 } } },
    { "send": { "jsonrpc": "2.0", "id": 5, "method": "status.unwatch", "params": { "window": "main", "name": "host.buttons" } } },
    { "reply": { "jsonrpc": "2.0", "id": 5, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 6, "method": "input.pointer", "params": { "window": "main", "x": 10, "y": 20, "phase": "up", "button": "left", "pointer": "first" } } },
    { "reply": { "jsonrpc": "2.0", "id": 6, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 7, "method": "status.watch", "params": { "window": "main", "name": "host.buttons" } } },
    { "reply": { "jsonrpc": "2.0", "id": 7, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 8, "method": "status.get", "params": { "window": "main", "name": "host.buttons" } } },
    { "reply": { "jsonrpc": "2.0", "id": 8, "result": { "mask": 0 } } },
    { "send": { "jsonrpc": "2.0", "id": 9, "method": "status.unwatch", "params": { "window": "main", "name": "host.buttons" } } },
    { "reply": { "jsonrpc": "2.0", "id": 9, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 10, "method": "input.pointer", "params": { "window": "main", "x": 30, "y": 40, "phase": "up", "button": "left", "pointer": "second" } } },
    { "reply": { "jsonrpc": "2.0", "id": 10, "result": null } }
  ]
}
