{
  "name": "b3-run",
  "description": "A benchmark run reads the display of the window, activates the window, which then reports occluded false, closes the connection, which ends the watch, and quits the application by the Quit item of its menu.",
  "replay": false,
  "reason": "The frames activate and quit the application that the benchmark run starts.",
  "variables": {
    "title": { "type": "string", "example": "fixture" },
    "scale": { "type": "number", "example": 2 },
    "refresh-rate": { "type": "number", "example": 120 }
  },
  "steps": [
    { "send": { "jsonrpc": "2.0", "id": 1, "method": "windows.list" } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "result": [{ "window": "main", "title": "$title", "project": null, "key": true, "ready": true }] } },
    { "send": { "jsonrpc": "2.0", "id": 2, "method": "status.get", "params": { "window": "main", "name": "host.window" } } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": { "scale": "$scale", "refreshRate": "$refresh-rate", "content": { "width": 1200, "height": 760 }, "occluded": true, "active": false } } },
    { "close": "client" },
    { "send": { "jsonrpc": "2.0", "id": 1, "method": "windows.list" } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "result": [{ "window": "main", "title": "$title", "project": null, "key": true, "ready": true }] } },
    { "send": { "jsonrpc": "2.0", "id": 2, "method": "status.get", "params": { "window": "main", "name": "host.window" } } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": { "scale": "$scale", "refreshRate": "$refresh-rate", "content": { "width": 1200, "height": 760 }, "occluded": true, "active": false } } },
    { "send": { "jsonrpc": "2.0", "id": 3, "method": "input.pointer", "params": { "window": "main", "x": 600, "y": 4, "phase": "move", "activate": true } } },
    { "reply": { "jsonrpc": "2.0", "id": 3, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 4, "method": "status.watch", "params": { "window": "main", "name": "host.window" } } },
    { "reply": { "jsonrpc": "2.0", "id": 4, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 5, "method": "status.get", "params": { "window": "main", "name": "host.window" } } },
    { "reply": { "jsonrpc": "2.0", "id": 5, "result": { "scale": "$scale", "refreshRate": "$refresh-rate", "content": { "width": 1200, "height": 760 }, "occluded": false, "active": true } } },
    { "close": "client" },
    { "send": { "jsonrpc": "2.0", "id": 1, "method": "status.get", "params": { "window": "main", "name": "host.menu" } } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "result": { "language": "en", "menus": [{ "title": "fixture", "items": [{ "title": "Quit fixture", "key": "cmd+q" }] }] } } },
    { "send": { "jsonrpc": "2.0", "id": 2, "method": "command.run", "params": { "window": "main", "name": "host.menu.select", "params": { "menu": "fixture", "title": "Quit fixture" } } } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": null } },
    { "close": "host" }
  ]
}
