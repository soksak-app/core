{
  "name": "normal-shutdown-service-prepared",
  "description": "The shutdown check with a service prepares a raster probe tab and closes the connection without a quit when the service endpoint is invalid.",
  "replay": false,
  "reason": "The case plays the requests of the normal shutdown check on a host whose state and shutdown the replay cannot arrange.",
  "steps": [
    {"send":{"jsonrpc":"2.0","id":1,"method":"status.watch","params":{"window":"main","name":"host.windows"}}},
    {"reply":{"jsonrpc":"2.0","id":1,"result":null}},
    {"send":{"jsonrpc":"2.0","id":2,"method":"status.get","params":{"window":"main","name":"host.windows"}}},
    {"reply":{"jsonrpc":"2.0","id":2,"result":[{"window":"main","ready":true}]}},
    {"send":{"jsonrpc":"2.0","id":3,"method":"diagnostics.fixture","params":{"window":"main","settings":{}}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":null}},
    {"send":{"jsonrpc":"2.0","id":4,"method":"status.unwatch","params":{"window":"main","name":"host.windows"}}},
    {"reply":{"jsonrpc":"2.0","id":4,"result":null}},
    {"send":{"jsonrpc":"2.0","id":5,"method":"status.get","params":{"window":"main","name":"core.grid"}}},
    {"reply":{"jsonrpc":"2.0","id":5,"result":{"cards":[{"id":"c1","focused":true,"active":null}]}}},
    {"send":{"jsonrpc":"2.0","id":6,"method":"command.run","params":{"window":"main","name":"core.card.add-tab","params":{"card":"c1","plugin":"rasterprobe"}}}},
    {"reply":{"jsonrpc":"2.0","id":6,"result":{"tab":"tab-raster"}}},
    {"send":{"jsonrpc":"2.0","id":7,"method":"status.watch","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":7,"result":null}},
    {"send":{"jsonrpc":"2.0","id":8,"method":"status.get","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":8,"result":[{"surface":"tab-raster","plugin":"rasterprobe","visible":true}]}},
    {"send":{"jsonrpc":"2.0","id":9,"method":"status.watch","params":{"window":"main","name":"rasterprobe.session","surface":"tab-raster"}}},
    {"reply":{"jsonrpc":"2.0","id":9,"result":null}},
    {"send":{"jsonrpc":"2.0","id":10,"method":"status.unwatch","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":10,"result":null}},
    {"send":{"jsonrpc":"2.0","id":11,"method":"status.get","params":{"window":"main","name":"rasterprobe.session","surface":"tab-raster"}}},
    {"reply":{"jsonrpc":"2.0","id":11,"result":{"session":"session-raster","connected":true}}},
    {"close":"client"}
  ]
}
