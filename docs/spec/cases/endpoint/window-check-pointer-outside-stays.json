{
  "name": "window-check-pointer-outside-stays",
  "description": "The window moves away from the pointer, the host reports the window at its old place with the pointer inside it, and the watch of host.window ends because the window closed.",
  "replay": false,
  "reason": "The case ends the status watch with the host reason of a window that closed, which the replay cannot arrange.",
  "steps": [
    {"send":{"jsonrpc":"2.0","id":1,"method":"status.get","params":{"window":"main","name":"host.window"}}},
    {"reply":{"jsonrpc":"2.0","id":1,"result":{"pointer":{"x":50,"y":40},"frame":{"x":0,"y":0,"width":100,"height":80},"content":{"width":100,"height":80}}}},
    {"send":{"jsonrpc":"2.0","id":2,"method":"status.get","params":{"window":"main","name":"host.screens"}}},
    {"reply":{"jsonrpc":"2.0","id":2,"result":[{"x":0,"y":0,"width":300,"height":200,"visible":{"x":0,"y":0,"width":300,"height":200}}]}},
    {"send":{"jsonrpc":"2.0","id":3,"method":"status.get","params":{"window":"main","name":"host.window"}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":{"pointer":{"x":50,"y":40},"frame":{"x":0,"y":0,"width":100,"height":80},"content":{"width":100,"height":80}}}},
    {"send":{"jsonrpc":"2.0","id":4,"method":"command.run","params":{"window":"main","name":"host.window.move","params":{"x":200,"y":0}}}},
    {"reply":{"jsonrpc":"2.0","id":4,"result":null}},
    {"send":{"jsonrpc":"2.0","id":5,"method":"status.watch","params":{"window":"main","name":"host.window"}}},
    {"reply":{"jsonrpc":"2.0","id":5,"result":null}},
    {"send":{"jsonrpc":"2.0","id":6,"method":"status.get","params":{"window":"main","name":"host.window"}}},
    {"reply":{"jsonrpc":"2.0","id":6,"result":{"pointer":{"x":70,"y":50},"frame":{"x":0,"y":0,"width":100,"height":80},"content":{"width":100,"height":80}}}},
    {"notify":{"jsonrpc":"2.0","method":"status.ended","params":{"window":"main","name":"host.window","reason":"the window closed"}}},
    {"send":{"jsonrpc":"2.0","id":7,"method":"status.get","params":{"window":"main","name":"host.window"}}},
    {"reply":{"jsonrpc":"2.0","id":7,"result":{"pointer":{"x":70,"y":50},"frame":{"x":0,"y":0,"width":100,"height":80},"content":{"width":100,"height":80}}}}
  ]
}
