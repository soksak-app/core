{
  "name": "window-check-surface-status",
  "description": "A wait on a status of a surface watches core.surfaces until the surface lists the status, and then watches the status of the surface.",
  "replay": false,
  "reason": "The case waits on the statuses of a surface of a tab that the replay does not open.",
  "steps": [
    {"send":{"jsonrpc":"2.0","id":1,"method":"status.watch","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":1,"result":null}},
    {"send":{"jsonrpc":"2.0","id":2,"method":"status.get","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":2,"result":[{"surface":"tab-1","exposes":["status probe.document"]}]}},
    {"send":{"jsonrpc":"2.0","id":3,"method":"status.unwatch","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":null}},
    {"send":{"jsonrpc":"2.0","id":4,"method":"status.watch","params":{"window":"main","name":"probe.document","surface":"tab-1"}}},
    {"reply":{"jsonrpc":"2.0","id":4,"result":null}},
    {"send":{"jsonrpc":"2.0","id":5,"method":"status.get","params":{"window":"main","name":"probe.document","surface":"tab-1"}}},
    {"reply":{"jsonrpc":"2.0","id":5,"result":{"path":"note.txt"}}}
  ]
}
