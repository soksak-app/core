  "steps": [
    {"send":{"jsonrpc":"2.0","id":1,"method":"status.get","params":{"window":"main","name":"core.settings"}}},
    {"reply":{"jsonrpc":"2.0","id":1,"result":{"common":{},"values":{"sets":[{"id":"set-install","title":"탐색기","sections":["files.tree","files.bookmarks"],"layout":"list"},{"id":"set-browser","title":"브라우저","sections":["browser.tabs","browser.history"],"layout":"tabs"}]}}}},
    {"send":{"jsonrpc":"2.0","id":2,"method":"status.get","params":{"window":"main","name":"core.settings"}}},
    {"reply":{"jsonrpc":"2.0","id":2,"result":{"common":{},"values":{"sets":[{"id":"set-install","title":"탐색기","sections":["files.tree","files.bookmarks"],"layout":"list"},{"id":"set-browser","title":"브라우저","sections":["browser.tabs","browser.history"],"layout":"tabs"}]}}}},
    {"send":{"jsonrpc":"2.0","id":3,"method":"command.run","params":{"window":"main","name":"core.settings.set","params":{"patch":{"sets":[{"id":"set-install","title":"탐색기","sections":["layoutprobe.alpha","layoutprobe.fill","layoutprobe.follow"],"layout":"list"},{"id":"set-browser","title":"브라우저","sections":["layoutprobe.alpha","layoutprobe.beta"],"layout":"tabs"}]},"scope":"common"}}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":null}}
  ]
