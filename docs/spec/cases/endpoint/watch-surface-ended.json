{
  "name": "watch-surface-ended",
  "description": "status.ended of a surface ends each watch of that surface with its reason and removes the watch without a status.unwatch. A later watch of the same surface sends a new status.watch.",
  "replay": false,
  "reason": "status.ended follows the close of a surface, and the replay cannot close a surface of the application on demand.",
  "steps": [
    { "send": { "jsonrpc": "2.0", "id": 1, "method": "status.watch", "params": { "window": "main", "name": "probe.lines", "surface": "tab-a" } } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 2, "method": "status.get", "params": { "window": "main", "name": "probe.lines", "surface": "tab-a" } } },
    { "send": { "jsonrpc": "2.0", "id": 3, "method": "status.get", "params": { "window": "main", "name": "probe.lines", "surface": "tab-a" } } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": [] } },
    { "reply": { "jsonrpc": "2.0", "id": 3, "result": [] } },
    { "notify": { "jsonrpc": "2.0", "method": "status.ended", "params": { "window": "main", "name": "probe.lines", "surface": "tab-b", "reason": "surface-closed" } } },
    { "notify": { "jsonrpc": "2.0", "method": "status.ended", "params": { "window": "main", "name": "probe.lines", "surface": "tab-a", "reason": "surface-closed" } } },
    { "send": { "jsonrpc": "2.0", "id": 4, "method": "status.watch", "params": { "window": "main", "name": "probe.lines", "surface": "tab-a" } } },
    { "reply": { "jsonrpc": "2.0", "id": 4, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 5, "method": "status.get", "params": { "window": "main", "name": "probe.lines", "surface": "tab-a" } } },
    { "reply": { "jsonrpc": "2.0", "id": 5, "result": [] } },
    { "send": { "jsonrpc": "2.0", "id": 6, "method": "status.unwatch", "params": { "window": "main", "name": "probe.lines", "surface": "tab-a" } } },
    { "reply": { "jsonrpc": "2.0", "id": 6, "result": null } }
  ]
}
