{
  "name": "sok-surface-window",
  "description": "Without --window or --project, sok asks agent.surface and surface.window at each request and uses its window although the application has several windows; --window takes precedence and sends no agent.surface and no surface.window; a refusal 1014 of agent.surface selects the only window of windows.list.",
  "replay": false,
  "reason": "The case answers agent.surface with a surface, and the process of the sok that the test starts belongs to no surface of a running application, so agent.surface refuses it.",
  "variables": {
    "refusal": { "type": "string", "example": "process 1 is not a process of a surface: no parent process of it is a running sidecar of the application that started it for a surface" },
    "value": { "type": "any", "example": "ok" }
  },
  "steps": [
    { "send": { "jsonrpc": "2.0", "id": 1, "method": "agent.surface" } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "result": { "surface": "terminal-1" } } },
    { "send": { "jsonrpc": "2.0", "id": 2, "method": "surface.window", "params": { "surface": "terminal-1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": { "window": "project-a", "space": "space-1" } } },
    { "send": { "jsonrpc": "2.0", "id": 3, "method": "status.get", "params": { "name": "core.screen", "window": "project-a" } } },
    { "reply": { "jsonrpc": "2.0", "id": 3, "result": "$value" } },
    { "close": "client" },

    { "send": { "jsonrpc": "2.0", "id": 1, "method": "agent.surface" } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "result": { "surface": "terminal-1" } } },
    { "send": { "jsonrpc": "2.0", "id": 2, "method": "surface.window", "params": { "surface": "terminal-1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": { "window": "main", "space": "space-1" } } },
    { "send": { "jsonrpc": "2.0", "id": 3, "method": "status.get", "params": { "name": "core.screen", "window": "main" } } },
    { "reply": { "jsonrpc": "2.0", "id": 3, "result": "$value" } },
    { "close": "client" },

    { "send": { "jsonrpc": "2.0", "id": 1, "method": "status.get", "params": { "name": "core.screen", "window": "project-a" } } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "result": "$value" } },
    { "close": "client" },

    { "send": { "jsonrpc": "2.0", "id": 1, "method": "agent.surface" } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "error": { "code": 1014, "message": "$refusal" } } },
    { "send": { "jsonrpc": "2.0", "id": 2, "method": "windows.list" } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": [
      { "window": "main", "title": "soksak", "project": null, "key": true, "ready": true }
    ] } },
    { "send": { "jsonrpc": "2.0", "id": 3, "method": "status.get", "params": { "name": "core.screen", "window": "main" } } },
    { "reply": { "jsonrpc": "2.0", "id": 3, "result": "$value" } },
    { "close": "client" }
  ]
}
