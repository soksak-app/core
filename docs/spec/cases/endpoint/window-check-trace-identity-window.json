{
  "name": "window-check-trace-identity-window",
  "description": "The target window of the session changes during the start of the trace: the trace reads the clock and stops its observer in the new window.",
  "replay": false,
  "reason": "The case plays the clock reads and the trace commands of a measured gesture of a view, which need a view of a plugin that the replay does not open.",
  "steps": [
    {"send":{"jsonrpc":"2.0","id":1,"method":"command.run","params":{"window":"main","name":"core.surface.clock","params":{},"surface":"view-1"}}},
    {"reply":{"jsonrpc":"2.0","id":1,"result":{"page":"page-1","timeOrigin":1999,"now":0.2}}},
    {"send":{"jsonrpc":"2.0","id":2,"method":"diagnostics.clock","params":{"window":"main"}}},
    {"reply":{"jsonrpc":"2.0","id":2,"result":{"mono_ns":"1000000000"}}},
    {"send":{"jsonrpc":"2.0","id":3,"method":"command.run","params":{"window":"main","name":"fixture.trace.start","params":{},"surface":"view-1"}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":{"enabled":true,"sourceClock":{"documentTimeOriginMs":1999,"sourceNowMs":0.2,"sourceResolutionMs":1}}}},
    {"send":{"jsonrpc":"2.0","id":4,"method":"diagnostics.clock","params":{"window":"other-window"}}},
    {"reply":{"jsonrpc":"2.0","id":4,"result":{"mono_ns":"1010000000"}}},
    {"send":{"jsonrpc":"2.0","id":5,"method":"command.run","params":{"window":"other-window","name":"fixture.trace.stop","params":{},"surface":"view-1"}}},
    {"reply":{"jsonrpc":"2.0","id":5,"result":{"enabled":false}}}
  ]
}
