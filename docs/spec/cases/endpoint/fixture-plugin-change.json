{
  "name": "fixture-plugin-change",
  "description": "A plugin change waits for the new start in the event log, reads the workbench after the host reports the page ready, and waits until that start is complete.",
  "replay": false,
  "reason": "The case plays the requests of the start state of a check on a workbench with a layout that the replay cannot arrange.",
  "steps": [
    {"send":{"jsonrpc":"2.0","id":1,"method":"status.get","params":{"window":"main","name":"core.window.workbench"}}},
    {"reply":{"jsonrpc":"2.0","id":1,"result":{"start":"old","readyState":"complete"}}},
    {"send":{"jsonrpc":"2.0","id":2,"method":"status.watch","params":{"window":"main","name":"host.windows"}}},
    {"reply":{"jsonrpc":"2.0","id":2,"result":null}},
    {"send":{"jsonrpc":"2.0","id":3,"method":"status.get","params":{"window":"main","name":"host.windows"}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":[{"window":"main","title":"t","project":null,"key":true,"ready":true}]}},
    {"send":{"jsonrpc":"2.0","id":4,"method":"status.unwatch","params":{"window":"main","name":"host.windows"}}},
    {"reply":{"jsonrpc":"2.0","id":4,"result":null}},
    {"send":{"jsonrpc":"2.0","id":5,"method":"status.get","params":{"window":"main","name":"core.window.workbench"}}},
    {"reply":{"jsonrpc":"2.0","id":5,"result":{"start":"new","readyState":"loading"}}},
    {"send":{"jsonrpc":"2.0","id":6,"method":"status.watch","params":{"window":"main","name":"core.window.workbench"}}},
    {"reply":{"jsonrpc":"2.0","id":6,"result":null}},
    {"send":{"jsonrpc":"2.0","id":7,"method":"status.get","params":{"window":"main","name":"core.window.workbench"}}},
    {"reply":{"jsonrpc":"2.0","id":7,"result":{"start":"new","readyState":"loading"}}},
    {"notify":{"jsonrpc":"2.0","method":"status.changed","params":{"window":"main","name":"core.window.workbench","value":{"start":"new","readyState":"complete"}}}},
    {"send":{"jsonrpc":"2.0","id":8,"method":"status.unwatch","params":{"window":"main","name":"core.window.workbench"}}},
    {"reply":{"jsonrpc":"2.0","id":8,"result":null}}
  ]
}
