{
  "name": "normal-shutdown-quit",
  "description": "The shutdown check without a service reads an empty session list, requests host.quit and the host ends the connection.",
  "replay": false,
  "reason": "The case plays the requests of the normal shutdown check on a host whose state and shutdown the replay cannot arrange.",
  "steps": [
    {"send":{"jsonrpc":"2.0","id":1,"method":"status.watch","params":{"window":"main","name":"host.windows"}}},
    {"reply":{"jsonrpc":"2.0","id":1,"result":null}},
    {"send":{"jsonrpc":"2.0","id":2,"method":"status.get","params":{"window":"main","name":"host.windows"}}},
    {"reply":{"jsonrpc":"2.0","id":2,"result":[{"window":"main","ready":true}]}},
    {"send":{"jsonrpc":"2.0","id":3,"method":"diagnostics.objects","params":{"window":"main"}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":{"sessions":[]}}},
    {"send":{"jsonrpc":"2.0","id":4,"method":"status.unwatch","params":{"window":"main","name":"host.windows"}}},
    {"reply":{"jsonrpc":"2.0","id":4,"result":null}},
    {"send":{"jsonrpc":"2.0","id":5,"method":"command.run","params":{"window":"main","name":"host.quit","params":{}}}},
    {"reply":{"jsonrpc":"2.0","id":5,"result":null}},
    {"close":"host"}
  ]
}
