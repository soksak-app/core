{
  "name": "mcp-exposure-pages",
  "description": "Each exposure_search and exposure_describe of sok mcp reads exposure.list again, so an entry that a plugin change adds is found by the next call; after and limit page the matches by the key of the last entry, an entry removed between two pages shifts no later entry, and a query matches the words of the name or the description.",
  "replay": false,
  "reason": "The calls answer exposure.list with lists that change between calls, as after a plugin change, which the replay cannot cause on demand.",
  "steps": [
    { "send": { "jsonrpc": "2.0", "id": 1, "method": "exposure.list", "params": { "window": "main" } } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "result": { "status": [{ "name": "core.screen", "description": "Current screen.", "schema": { "type": "string" }, "registered": true }, { "name": "host.window", "description": "Window state.", "schema": { "type": "object" }, "registered": true }], "commands": [{ "name": "core.project.open", "description": "Opens a project.", "params": { "type": "object", "properties": { "root": { "type": "string" } } }, "result": { "type": "null" }, "registered": true }, { "name": "host.window.reload", "description": "Starts the workbench of the window again.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": true }], "element": [{ "name": "core.tab", "description": "A tab.", "many": true, "registered": true }] } } },
    { "send": { "jsonrpc": "2.0", "id": 2, "method": "exposure.list", "params": { "window": "main" } } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": { "status": [{ "name": "host.window", "description": "Window state.", "schema": { "type": "object" }, "registered": true }], "commands": [{ "name": "core.project.open", "description": "Opens a project.", "params": { "type": "object", "properties": { "root": { "type": "string" } } }, "result": { "type": "null" }, "registered": true }, { "name": "host.window.reload", "description": "Starts the workbench of the window again.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": true }, { "name": "fixture.added", "description": "Added by a plugin change.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": false }], "element": [{ "name": "core.tab", "description": "A tab.", "many": true, "registered": true }] } } },
    { "send": { "jsonrpc": "2.0", "id": 3, "method": "exposure.list", "params": { "window": "main" } } },
    { "reply": { "jsonrpc": "2.0", "id": 3, "result": { "status": [{ "name": "host.window", "description": "Window state.", "schema": { "type": "object" }, "registered": true }], "commands": [{ "name": "core.project.open", "description": "Opens a project.", "params": { "type": "object", "properties": { "root": { "type": "string" } } }, "result": { "type": "null" }, "registered": true }, { "name": "host.window.reload", "description": "Starts the workbench of the window again.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": true }, { "name": "fixture.added", "description": "Added by a plugin change.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": false }], "element": [{ "name": "core.tab", "description": "A tab.", "many": true, "registered": true }] } } },
    { "send": { "jsonrpc": "2.0", "id": 4, "method": "exposure.list", "params": { "window": "main" } } },
    { "reply": { "jsonrpc": "2.0", "id": 4, "result": { "status": [{ "name": "host.window", "description": "Window state.", "schema": { "type": "object" }, "registered": true }], "commands": [{ "name": "core.project.open", "description": "Opens a project.", "params": { "type": "object", "properties": { "root": { "type": "string" } } }, "result": { "type": "null" }, "registered": true }, { "name": "host.window.reload", "description": "Starts the workbench of the window again.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": true }, { "name": "fixture.added", "description": "Added by a plugin change.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": false }], "element": [{ "name": "core.tab", "description": "A tab.", "many": true, "registered": true }] } } },
    { "send": { "jsonrpc": "2.0", "id": 5, "method": "exposure.list", "params": { "window": "main" } } },
    { "reply": { "jsonrpc": "2.0", "id": 5, "result": { "status": [{ "name": "host.window", "description": "Window state.", "schema": { "type": "object" }, "registered": true }], "commands": [{ "name": "core.project.open", "description": "Opens a project.", "params": { "type": "object", "properties": { "root": { "type": "string" } } }, "result": { "type": "null" }, "registered": true }, { "name": "host.window.reload", "description": "Starts the workbench of the window again.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": true }, { "name": "fixture.added", "description": "Added by a plugin change.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": false }], "element": [{ "name": "core.tab", "description": "A tab.", "many": true, "registered": true }] } } },
    { "send": { "jsonrpc": "2.0", "id": 6, "method": "exposure.list", "params": { "window": "main" } } },
    { "reply": { "jsonrpc": "2.0", "id": 6, "result": { "status": [{ "name": "host.window", "description": "Window state.", "schema": { "type": "object" }, "registered": true }], "commands": [{ "name": "core.project.open", "description": "Opens a project.", "params": { "type": "object", "properties": { "root": { "type": "string" } } }, "result": { "type": "null" }, "registered": true }, { "name": "host.window.reload", "description": "Starts the workbench of the window again.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": true }, { "name": "fixture.added", "description": "Added by a plugin change.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": false }], "element": [{ "name": "core.tab", "description": "A tab.", "many": true, "registered": true }] } } },
    { "send": { "jsonrpc": "2.0", "id": 7, "method": "exposure.list", "params": { "window": "main" } } },
    { "reply": { "jsonrpc": "2.0", "id": 7, "result": { "status": [{ "name": "host.window", "description": "Window state.", "schema": { "type": "object" }, "registered": true }], "commands": [{ "name": "core.project.open", "description": "Opens a project.", "params": { "type": "object", "properties": { "root": { "type": "string" } } }, "result": { "type": "null" }, "registered": true }, { "name": "host.window.reload", "description": "Starts the workbench of the window again.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": true }, { "name": "fixture.added", "description": "Added by a plugin change.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": false }], "element": [{ "name": "core.tab", "description": "A tab.", "many": true, "registered": true }] } } },
    { "send": { "jsonrpc": "2.0", "id": 8, "method": "exposure.list", "params": { "window": "main" } } },
    { "reply": { "jsonrpc": "2.0", "id": 8, "result": { "status": [{ "name": "host.window", "description": "Window state.", "schema": { "type": "object" }, "registered": true }], "commands": [{ "name": "core.project.open", "description": "Opens a project.", "params": { "type": "object", "properties": { "root": { "type": "string" } } }, "result": { "type": "null" }, "registered": true }, { "name": "host.window.reload", "description": "Starts the workbench of the window again.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": true }, { "name": "fixture.added", "description": "Added by a plugin change.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": false }], "element": [{ "name": "core.tab", "description": "A tab.", "many": true, "registered": true }] } } },
    { "send": { "jsonrpc": "2.0", "id": 9, "method": "exposure.list", "params": { "window": "main" } } },
    { "reply": { "jsonrpc": "2.0", "id": 9, "result": { "status": [{ "name": "host.window", "description": "Window state.", "schema": { "type": "object" }, "registered": true }], "commands": [{ "name": "core.project.open", "description": "Opens a project.", "params": { "type": "object", "properties": { "root": { "type": "string" } } }, "result": { "type": "null" }, "registered": true }, { "name": "host.window.reload", "description": "Starts the workbench of the window again.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": true }, { "name": "fixture.added", "description": "Added by a plugin change.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": false }], "element": [{ "name": "core.tab", "description": "A tab.", "many": true, "registered": true }] } } }
  ],
  "mcp": {
    "arguments": ["--window", "main"],
    "steps": [
      { "tool": "exposure_search", "arguments": { "limit": 2 }, "result": { "entries": [{ "kind": "status", "name": "core.screen", "description": "Current screen.", "registered": true }, { "kind": "status", "name": "host.window", "description": "Window state.", "registered": true }], "total": 5, "next": "status host.window" } },
      { "tool": "exposure_search", "arguments": { "after": "status host.window", "limit": 2 }, "result": { "entries": [{ "kind": "command", "name": "core.project.open", "description": "Opens a project.", "registered": true }, { "kind": "command", "name": "host.window.reload", "description": "Starts the workbench of the window again.", "registered": true }], "total": 5, "next": "command host.window.reload" } },
      { "tool": "exposure_search", "arguments": { "after": "command host.window.reload" }, "result": { "entries": [{ "kind": "command", "name": "fixture.added", "description": "Added by a plugin change.", "registered": false }, { "kind": "element", "name": "core.tab", "description": "A tab.", "registered": true }], "total": 5, "next": null } },
      { "tool": "exposure_search", "arguments": { "query": " WINDOW\tre " }, "result": { "entries": [{ "kind": "command", "name": "host.window.reload", "description": "Starts the workbench of the window again.", "registered": true }], "total": 1, "next": null } },
      { "tool": "exposure_search", "arguments": { "kind": "element", "query": "   " }, "result": { "entries": [{ "kind": "element", "name": "core.tab", "description": "A tab.", "registered": true }], "total": 1, "next": null } },
      { "tool": "exposure_search", "arguments": { "query": "plugin CHANGE" }, "result": { "entries": [{ "kind": "command", "name": "fixture.added", "description": "Added by a plugin change.", "registered": false }], "total": 1, "next": null } },
      { "tool": "exposure_search", "arguments": { "after": "status core.screen" }, "error": "after status core.screen names no entry of the search" },
      { "tool": "exposure_describe", "arguments": { "kind": "command", "name": "fixture.added" }, "result": { "name": "fixture.added", "description": "Added by a plugin change.", "params": { "type": "object" }, "result": { "type": "null" }, "registered": false } },
      { "tool": "exposure_describe", "arguments": { "kind": "status", "name": "core.screen" }, "error": "status core.screen is not declared" },
      { "tool": "exposure_search", "arguments": { "limit": 201 }, "error": "limit must be an integer from 1 to 200" },
      { "tool": "exposure_search", "arguments": { "queries": "x" }, "error": "unknown argument queries" },
      { "tool": "exposure_describe", "arguments": { "kind": "status" }, "error": "name is required" },
      { "tool": "exposure_describe", "arguments": { "kind": "status", "name": 3 }, "error": "name must be a string" }
    ]
  }
}
