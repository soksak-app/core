{
  "name": "fixture-settings-closed-page",
  "description": "The settings tab is closed when core.settings-tab reports null.",
  "replay": false,
  "reason": "The case plays the requests of the start state of a check on a workbench with a layout that the replay cannot arrange.",
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "status.watch",
        "params": {
          "window": "main",
          "name": "core.settings-tab"
        }
      }
    },
    {
      "reply": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": null
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "status.get",
        "params": {
          "window": "main",
          "name": "core.settings-tab"
        }
      }
    },
    {
      "reply": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": null
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "status.unwatch",
        "params": {
          "window": "main",
          "name": "core.settings-tab"
        }
      }
    },
    {
      "reply": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": null
      }
    }
  ]
}
