{
  "name": "fixture-paint-probe-document",
  "description": "A layout probe tab is painted after its document reports, and is ready once the document reports the colour.",
  "replay": false,
  "reason": "The case plays the requests of the start state of a check on a workbench with a layout that the replay cannot arrange.",
  "steps": [
    {"send":{"jsonrpc":"2.0","id":1,"method":"status.watch","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":1,"result":null}},
    {"send":{"jsonrpc":"2.0","id":2,"method":"status.get","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":2,"result":[{"surface":"probe-1","exposes":["status layoutprobe.document"]}]}},
    {"send":{"jsonrpc":"2.0","id":3,"method":"status.unwatch","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":null}},
    {"send":{"jsonrpc":"2.0","id":4,"method":"status.watch","params":{"window":"main","name":"layoutprobe.document","surface":"probe-1"}}},
    {"reply":{"jsonrpc":"2.0","id":4,"result":null}},
    {"send":{"jsonrpc":"2.0","id":5,"method":"status.get","params":{"window":"main","name":"layoutprobe.document","surface":"probe-1"}}},
    {"reply":{"jsonrpc":"2.0","id":5,"result":{"reported":true,"color":null}}},
    {"send":{"jsonrpc":"2.0","id":6,"method":"status.unwatch","params":{"window":"main","name":"layoutprobe.document","surface":"probe-1"}}},
    {"reply":{"jsonrpc":"2.0","id":6,"result":null}},
    {"send":{"jsonrpc":"2.0","id":7,"method":"command.run","params":{"window":"main","name":"layoutprobe.document.color","params":{"color":"rgb(25, 27, 36)"},"surface":"probe-1"}}},
    {"reply":{"jsonrpc":"2.0","id":7,"result":null}},
    {"send":{"jsonrpc":"2.0","id":8,"method":"status.watch","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":8,"result":null}},
    {"send":{"jsonrpc":"2.0","id":9,"method":"status.get","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":9,"result":[{"surface":"probe-1","exposes":["status layoutprobe.document"]}]}},
    {"send":{"jsonrpc":"2.0","id":10,"method":"status.unwatch","params":{"window":"main","name":"core.surfaces"}}},
    {"reply":{"jsonrpc":"2.0","id":10,"result":null}},
    {"send":{"jsonrpc":"2.0","id":11,"method":"status.watch","params":{"window":"main","name":"layoutprobe.document","surface":"probe-1"}}},
    {"reply":{"jsonrpc":"2.0","id":11,"result":null}},
    {"send":{"jsonrpc":"2.0","id":12,"method":"status.get","params":{"window":"main","name":"layoutprobe.document","surface":"probe-1"}}},
    {"reply":{"jsonrpc":"2.0","id":12,"result":{"reported":true,"color":"rgb(25, 27, 36)"}}},
    {"send":{"jsonrpc":"2.0","id":13,"method":"status.unwatch","params":{"window":"main","name":"layoutprobe.document","surface":"probe-1"}}},
    {"reply":{"jsonrpc":"2.0","id":13,"result":null}}
  ]
}
