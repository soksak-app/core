{
  "name": "unwatch-without-watch",
  "description": "An unwatch enters the queue of its status only when the last change of its connection is a watch. While the page holds the first watch, the second unwatch of the same connection and the unwatch of a connection that never watched change nothing and are answered at once; the page receives one status.unwatch.",
  "replay": false,
  "reason": "The page of the case is a script that the host producers play; a running application has a page of its own that answers differently.",
  "page": "scripted",
  "windows": ["main"],
  "steps": [
    {"connection": "a", "send": {"jsonrpc": "2.0", "id": 1, "method": "status.watch", "params": {"window": "main", "name": "core.layout"}}},
    {"page": {"call": {"name": "status.watch", "payload": {"name": "core.layout"}}}},
    {"page": {"reply": {"result": null, "held": true}}},
    {"connection": "a", "send": {"jsonrpc": "2.0", "id": 2, "method": "status.unwatch", "params": {"window": "main", "name": "core.layout"}}},
    {"connection": "a", "send": {"jsonrpc": "2.0", "id": 3, "method": "status.unwatch", "params": {"window": "main", "name": "core.layout"}}},
    {"connection": "b", "send": {"jsonrpc": "2.0", "id": 1, "method": "status.unwatch", "params": {"window": "main", "name": "core.layout"}}},
    {"connection": "a", "reply": {"jsonrpc": "2.0", "id": 3, "result": null}},
    {"connection": "b", "reply": {"jsonrpc": "2.0", "id": 1, "result": null}},
    {"page": {"release": true}},
    {"connection": "a", "reply": {"jsonrpc": "2.0", "id": 1, "result": null}},
    {"connection": "a", "reply": {"jsonrpc": "2.0", "id": 2, "result": null}},
    {"page": {"call": {"name": "status.unwatch", "payload": {"name": "core.layout"}}}},
    {"page": {"reply": {"result": null}}}
  ]
}
