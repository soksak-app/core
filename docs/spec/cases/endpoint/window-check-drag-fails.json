{
  "name": "window-check-drag-fails",
  "description": "A drag that the host refuses still ends the drawing of the covered window.",
  "replay": false,
  "reason": "The case drives the diagnostic requests of a window check, which need a display, a recording folder or a state that the replay does not arrange.",
  "steps": [
    {"send":{"jsonrpc":"2.0","id":1,"method":"diagnostics.window.draw-covered","params":{"window":"main","draw":true}}},
    {"reply":{"jsonrpc":"2.0","id":1,"result":null}},
    {"send":{"jsonrpc":"2.0","id":2,"method":"diagnostics.drag","params":{"window":"main","axis":"x","line":0,"dx":10,"dy":0,"ms":100,"times":1,"capture":false}}},
    {"reply":{"jsonrpc":"2.0","id":2,"error":{"code":1004,"message":"drag failed"}}},
    {"send":{"jsonrpc":"2.0","id":3,"method":"diagnostics.window.draw-covered","params":{"window":"main","draw":false}}},
    {"reply":{"jsonrpc":"2.0","id":3,"result":null}}
  ]
}
