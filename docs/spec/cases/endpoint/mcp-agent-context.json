{
  "name": "mcp-agent-context",
  "description": "sok mcp with SOKSAK_SURFACE asks surface.window at each call without a window argument and uses its window; agent_context answers the configuration directory, the surface and its window; a window argument takes precedence; a surface in no window fails the call with the text that names the variable, and an endpoint error of surface.window is the tool error.",
  "replay": false,
  "reason": "The case needs the environment variable SOKSAK_SURFACE of the server that the test starts, which a window check of the application does not set.",
  "variables": {
    "screen": { "type": "any", "example": "home" }
  },
  "steps": [
    { "send": { "jsonrpc": "2.0", "id": 1, "method": "surface.window", "params": { "surface": "terminal-1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "result": { "window": "project-a", "space": "space-1" } } },
    { "send": { "jsonrpc": "2.0", "id": 2, "method": "surface.window", "params": { "surface": "terminal-1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": { "window": "main", "space": "space-1" } } },
    { "send": { "jsonrpc": "2.0", "id": 3, "method": "status.get", "params": { "window": "main", "name": "core.screen" } } },
    { "reply": { "jsonrpc": "2.0", "id": 3, "result": "$screen" } },
    { "send": { "jsonrpc": "2.0", "id": 4, "method": "status.get", "params": { "window": "project-a", "name": "core.screen" } } },
    { "reply": { "jsonrpc": "2.0", "id": 4, "result": "$screen" } },
    { "send": { "jsonrpc": "2.0", "id": 5, "method": "surface.window", "params": { "surface": "terminal-1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 5, "error": { "code": 1012, "message": "surface terminal-1 is in no window" } } },
    { "send": { "jsonrpc": "2.0", "id": 6, "method": "surface.window", "params": { "surface": "terminal-1" } } },
    { "reply": { "jsonrpc": "2.0", "id": 6, "error": { "code": 1003, "message": "window \"main\" is not ready" } } }
  ],
  "mcp": {
    "environment": { "SOKSAK_SURFACE": "terminal-1" },
    "steps": [
      { "tool": "agent_context", "arguments": {}, "result": { "configDirectory": "$config", "surface": "terminal-1", "window": "project-a" } },
      { "tool": "status_get", "arguments": { "name": "core.screen" }, "result": "$screen" },
      { "tool": "status_get", "arguments": { "window": "project-a", "name": "core.screen" }, "result": "$screen" },
      { "tool": "status_get", "arguments": { "name": "core.screen" }, "error": "SOKSAK_SURFACE names surface terminal-1, which is in no window of the application" },
      { "tool": "status_get", "arguments": { "name": "core.screen" }, "error": "window \"main\" is not ready (1003)" }
    ]
  }
}
