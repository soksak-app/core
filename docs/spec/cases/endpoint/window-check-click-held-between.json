{
  "name": "window-check-click-held-between",
  "description": "A click waits until status.watch of host.buttons reports mask 0 before its release, when a person pressed a button between the press and the release of the click.",
  "replay": false,
  "reason": "The case sends native pointer input and the held button is the state of a person, so the replay cannot arrange it.",
  "steps": [
    {"send": {"jsonrpc": "2.0", "id": 1, "method": "status.watch", "params": {"window": "main", "name": "host.buttons"}}},
    {"reply": {"jsonrpc": "2.0", "id": 1, "result": null}},
    {"send": {"jsonrpc": "2.0", "id": 2, "method": "status.get", "params": {"window": "main", "name": "host.buttons"}}},
    {"reply": {"jsonrpc": "2.0", "id": 2, "result": {"mask": 0}}},
    {"send": {"jsonrpc": "2.0", "id": 3, "method": "status.unwatch", "params": {"window": "main", "name": "host.buttons"}}},
    {"reply": {"jsonrpc": "2.0", "id": 3, "result": null}},
    {"send": {"jsonrpc": "2.0", "id": 4, "method": "input.pointer", "params": {"window": "main", "x": 10, "y": 20, "phase": "down"}}},
    {"reply": {"jsonrpc": "2.0", "id": 4, "result": null}},
    {"send": {"jsonrpc": "2.0", "id": 5, "method": "status.watch", "params": {"window": "main", "name": "host.buttons"}}},
    {"reply": {"jsonrpc": "2.0", "id": 5, "result": null}},
    {"send": {"jsonrpc": "2.0", "id": 6, "method": "status.get", "params": {"window": "main", "name": "host.buttons"}}},
    {"reply": {"jsonrpc": "2.0", "id": 6, "result": {"mask": 1}}},
    {"notify": {"jsonrpc": "2.0", "method": "status.changed", "params": {"window": "main", "name": "host.buttons", "value": {"mask": 0}}}},
    {"send": {"jsonrpc": "2.0", "id": 7, "method": "status.unwatch", "params": {"window": "main", "name": "host.buttons"}}},
    {"reply": {"jsonrpc": "2.0", "id": 7, "result": null}},
    {"send": {"jsonrpc": "2.0", "id": 8, "method": "input.pointer", "params": {"window": "main", "x": 10, "y": 20, "phase": "up"}}},
    {"reply": {"jsonrpc": "2.0", "id": 8, "result": null}}
  ]
}
