{
  "name": "watch-failed-then-watch-again",
  "description": "A watch whose predicate fails on the notification of the current value that follows the status.watch reply is unsubscribed, and the status.get reply that arrives after that value is ignored. The next watch of the same name sends its own status.watch and resolves from the notification of its current value.",
  "replay": false,
  "reason": "The first watch fails by a predicate of the client test, and a running application has no such predicate.",
  "variables": {
    "screen": { "type": "object", "keys": ["screen", "modal"], "example": { "screen": "workspace", "modal": null } },
    "screen-library": { "type": "object", "keys": ["screen", "modal"], "example": { "screen": "home", "modal": null } }
  },
  "steps": [
    { "send": { "jsonrpc": "2.0", "id": 1, "method": "status.watch", "params": { "window": "main", "name": "core.screen" } } },
    { "reply": { "jsonrpc": "2.0", "id": 1, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 2, "method": "status.get", "params": { "window": "main", "name": "core.screen" } } },
    { "notify": { "jsonrpc": "2.0", "method": "status.changed", "params": { "window": "main", "name": "core.screen", "value": "$screen-library" } } },
    { "reply": { "jsonrpc": "2.0", "id": 2, "result": "$screen-library" } },
    { "send": { "jsonrpc": "2.0", "id": 3, "method": "status.unwatch", "params": { "window": "main", "name": "core.screen" } } },
    { "reply": { "jsonrpc": "2.0", "id": 3, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 4, "method": "status.watch", "params": { "window": "main", "name": "core.screen" } } },
    { "reply": { "jsonrpc": "2.0", "id": 4, "result": null } },
    { "send": { "jsonrpc": "2.0", "id": 5, "method": "status.get", "params": { "window": "main", "name": "core.screen" } } },
    { "notify": { "jsonrpc": "2.0", "method": "status.changed", "params": { "window": "main", "name": "core.screen", "value": "$screen" } } },
    { "reply": { "jsonrpc": "2.0", "id": 5, "result": "$screen" } },
    { "send": { "jsonrpc": "2.0", "id": 6, "method": "status.unwatch", "params": { "window": "main", "name": "core.screen" } } },
    { "reply": { "jsonrpc": "2.0", "id": 6, "result": null } }
  ]
}
