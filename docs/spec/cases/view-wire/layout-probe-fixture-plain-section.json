{
  "name": "layout-probe-fixture-plain-section",
  "description": "A section view of the layout probe that does not follow watches no status.",
  "plugin": "layoutprobe",
  "replay": false,
  "reason": "The calls of this case other than runtime.log are answered by the page of the workbench, which only a running application has; the runtime.log steps are replayed by the cases log-clock and log-batch.",
  "steps": [
    {"call":{"command":"runtime.command.register","params":{"name":"layoutprobe.open"}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.on","params":{"name":"exposure-request"}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"status","name":"core.surface.document"}}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"status","name":"core.surface.input"}}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"command","name":"core.surface.hit"}}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"command","name":"core.surface.clock"}}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"status","name":"layoutprobe.section"}}}},
    {"reply":{"result":null}},
    {"notice":{"event":"exposure-request","data":{"id":1001,"method":"status.get","params":{"name":"layoutprobe.section"}}}},
    {"call":{"command":"runtime.native.call","params":{"name":"exposureReply","payload":{"id":1001,"result":{"id":"layoutprobe.fill","sidebar":"card-2:left","card":"card-2","width":640,"height":400,"overflows":false,"follows":false,"surface":null,"view":null}}}}},
