    {"call":{"command":"runtime.native.call","params":{"name":"exposureReply","payload":{"id":1004,"result":{"id":"layoutprobe.follow","sidebar":"right","card":null,"width":190,"height":72,"overflows":false,"follows":true,"surface":null,"view":null}}}}},
