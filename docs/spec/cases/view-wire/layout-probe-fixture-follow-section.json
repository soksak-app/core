{
  "name": "layout-probe-fixture-follow-section",
  "description": "The follow section of the layout probe follows the surface of core.sidebars and watches the view status.",
  "plugin": "layoutprobe",
  "replay": false,
  "reason": "The calls of this case other than runtime.log are answered by the page of the workbench, which only a running application has; the runtime.log steps are replayed by the cases log-clock and log-batch.",
  "steps": [
    {"call":{"command":"runtime.command.register","params":{"name":"layoutprobe.open"}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.on","params":{"name":"exposure-request"}}},
