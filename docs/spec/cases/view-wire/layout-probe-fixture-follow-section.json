    {"notice":{"event":"exposure-request","data":{"id":1002,"method":"status.get","params":{"name":"layoutprobe.section"}}}},
    {"call":{"command":"runtime.native.call","params":{"name":"exposureReply","payload":{"id":1002,"result":{"id":"layoutprobe.follow","sidebar":"right","card":null,"width":190,"height":72,"overflows":false,"follows":true,"surface":"tab-2","view":null}}}}},
    {"reply":{"result":null}},
    {"notice":{"event":"status","data":{"name":"core.sidebars","value":[{"sidebar":"right","sections":[{"surfaceId":"spc-1/right/layoutprobe.follow","surface":"tab-1"}]}]}}},
