{
  "name": "unload-probe-fixture-location",
  "description": "The unload probe serves its location status and writes the tab state that the document state reports.",
  "plugin": "probeunload",
  "replay": false,
  "reason": "The calls of this case other than runtime.log are answered by the page of the workbench, which only a running application has; the runtime.log steps are replayed by the cases log-clock and log-batch.",
  "steps": [
    {"call":{"command":"tab.state.read","params":null}},
    {"reply":{"result":{"url":"https://example.test/"}}},
    {"call":{"command":"runtime.native.on","params":{"name":"exposure-request"}}},
    {"reply":{"result":null}},
    {"call":{"command":"composition.declaration","params":null}},
    {"reply":{"result":{"kind":"view","page":"ui/page.html","regions":[{"name":"page","kind":"document","input":"native"}],"overlays":[]}}},
    {"call":{"command":"document.attach","params":{"name":"page"}}},
    {"reply":{"result":{"history":false}}},
    {"call":{"command":"runtime.native.on","params":{"name":"document-state"}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.on","params":{"name":"document-message"}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.on","params":{"name":"document-stream"}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"status","name":"core.surface.document"}}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"status","name":"core.surface.input"}}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"command","name":"core.surface.hit"}}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"command","name":"core.surface.clock"}}}},
    {"reply":{"result":null}},
    {"call":{"command":"composition.place","params":{"regions":[{"name":"page","left":0,"top":0,"right":640,"bottom":400,"visible":true}],"overlays":[]}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.command.register","params":{"name":"probeunload.load"}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.command.register","params":{"name":"probeunload.modified"}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"status","name":"probeunload.location"}}}},
    {"reply":{"result":null}},
    {"notice":{"event":"exposure-request","data":{"id":1001,"method":"status.get","params":{"name":"probeunload.location"}}}},
    {"call":{"command":"runtime.native.call","params":{"name":"exposureReply","payload":{"id":1001,"result":{"url":"","loading":false,"history":{"entries":[],"index":-1},"restored":{"url":"https://example.test/"}}}}}},
    {"reply":{"result":null}},
    {"notice":{"event":"exposure-request","data":{"id":1002,"method":"status.watch","params":{"name":"probeunload.location"}}}},
    {"call":{"command":"runtime.native.call","params":{"name":"changed","payload":{"name":"probeunload.location","value":{"url":"","loading":false,"history":{"entries":[],"index":-1},"restored":{"url":"https://example.test/"}},"version":1}}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"exposureReply","payload":{"id":1002,"result":null}}}},
    {"reply":{"result":null}},
    {"notice":{"event":"document-state","data":{"document":"page","state":{"url":"https://example.test/next","loading":false,"history":{"entries":[{"url":"https://example.test/next","title":""}],"index":0}}}}},
    {"call":{"command":"tab.state.write","params":{"url":"https://example.test/next"}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"changed","payload":{"name":"probeunload.location","value":{"url":"https://example.test/next","loading":false,"history":{"entries":[{"url":"https://example.test/next","title":""}],"index":0},"restored":{"url":"https://example.test/"}},"version":2}}}},
    {"reply":{"result":null}},
    {"notice":{"event":"exposure-request","data":{"id":1003,"method":"status.unwatch","params":{"name":"probeunload.location"}}}},
    {"call":{"command":"runtime.native.call","params":{"name":"exposureReply","payload":{"id":1003,"result":null}}}},
    {"reply":{"result":null}},
    {"notice":{"event":"document-state","data":{"document":"page","state":{"url":"https://example.test/later","loading":true,"history":{"entries":[{"url":"https://example.test/next","title":""}],"index":0}}}}},
    {"call":{"command":"tab.state.write","params":{"url":"https://example.test/later"}}},
    {"reply":{"result":null}},
    {"notice":{"event":"exposure-request","data":{"id":1004,"method":"status.get","params":{"name":"probeunload.location"}}}},
    {"call":{"command":"runtime.native.call","params":{"name":"exposureReply","payload":{"id":1004,"result":{"url":"https://example.test/later","loading":true,"history":{"entries":[{"url":"https://example.test/next","title":""}],"index":0},"restored":{"url":"https://example.test/"}}}}}},
    {"reply":{"result":null}}
  ]
