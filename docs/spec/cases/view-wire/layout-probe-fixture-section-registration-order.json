    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"status","name":"core.surface.input"}}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"command","name":"core.surface.hit"}}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"command","name":"core.surface.clock"}}}},
    {"reply":{"result":null}},
    {"call":{"command":"runtime.native.call","params":{"name":"registered","payload":{"kind":"status","name":"layoutprobe.section"}}}},
    {"reply":{"result":null}}
  ]
