{
  "schema": 3,
  "layers": [
    "native",
    "host",
    "page",
    "sidecar",
    "sok"
  ],
  "events": {
    "log.open": {
      "layer": "host",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schema": {
            "type": "number"
          },
          "pid": {
            "type": "number"
          },
          "role": {
            "type": "string"
          },
          "boot": {
            "type": "string"
          }
        },
        "required": [
          "schema",
          "pid",
          "role",
          "boot"
        ]
      }
    },
    "log.dropped": {
      "layer": "host",
      "class": "lifecycle",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "from_seq": {
            "type": "number"
          },
          "to_seq": {
            "type": "number"
          },
          "count": {
            "type": "number"
          },
          "bytes": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "from_seq",
          "to_seq",
          "count",
          "bytes",
          "reason"
        ]
      }
    },
    "log.rotated": {
      "layer": "host",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bytes": {
            "type": "number"
          },
          "kept": {
            "type": "number"
          },
          "removed": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "bytes",
          "kept",
          "removed"
        ]
      }
    },
    "native.input.key_down": {
      "layer": "native",
      "class": "input",
      "level": "info",
      "cids": "required",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "keyCode": {
            "type": "number"
          }
        },
        "required": [
          "keyCode"
        ]
      }
    },
    "host.sidecar.request": {
      "layer": "host",
      "class": "io",
      "level": "info",
      "cids": "required",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "bytes": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "surface",
          "bytes"
        ]
      }
    }
  },
  "chains": {
    "input": [
      "native.input.key_down",
      "host.sidecar.request"
    ]
  }
}
