{
  "name": "performance-timed",
  "description": "A timed operation records its duration in microseconds with its outcome, and the batch of the two commands leaves when the trace is switched off.",
  "replay": false,
  "reason": "The case calls performance, which the producer does not run.",
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "3536dceb-e446-42b2-8626-8b6b7d9d9ea4",
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000006869,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5006413310,
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000006960,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5006504643,
      "source": "page"
    },
    "us-ok": {
      "type": "integer",
      "example": 1500,
      "source": "page"
    },
    "us-fail": {
      "type": "integer",
      "example": 250,
      "source": "page"
    },
    "us-1": {
      "type": "integer",
      "example": 7,
      "source": "page"
    },
    "us-2": {
      "type": "integer",
      "example": 55,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "performance",
        "payload": {
          "action": "on"
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.trace.command",
              "fields": {
                "name": "core.ok",
                "us": "$us-1",
                "ok": true
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.trace.command",
              "fields": {
                "name": "core.fail",
                "us": "$us-2",
                "ok": false,
                "error": "boom"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "performance",
        "payload": {
          "action": "off"
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
