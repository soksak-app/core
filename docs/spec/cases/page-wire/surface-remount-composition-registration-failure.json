{
  "name": "surface-remount-composition-registration-failure",
  "description": "A surface whose state callback throws before its listeners are registered sends no host call but the event that records its failed mount, and a callback that throws a falsy value records the failure with the reason null.",
  "replay": false,
  "reason": "The page writes its events through the host call log with its own clock readings, which the Go producer cannot reproduce without the page (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "identity": {
      "type": "string",
      "example": "3f2c9a6e-0b1d-4c7e-9a52-6d1e8b4f0a21",
      "source": "page"
    },
    "event-1-ts-us": {
      "type": "integer",
      "example": 1791000000000790,
      "source": "page"
    },
    "event-1-mono-ns": {
