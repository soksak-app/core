  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.surface.mount.failed",
              "fields": {
                "plugin": "fixture-remount-registration-failure",
