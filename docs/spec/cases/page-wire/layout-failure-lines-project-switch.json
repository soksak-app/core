  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us-1",
          "mono_ns": "$clock-mono-ns-1"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
