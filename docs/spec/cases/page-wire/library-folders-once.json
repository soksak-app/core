{
  "name": "library-folders-once",
  "description": "The page reads the host notification state when it imports the library and applies the theme and the menu language of the project snapshot; the library asks the host for the folder of a project four times while the project list changes and writes the missing folder error in one log batch, and writes it again in a second log batch after the folder answered and was missing again.",
  "replay": false,
  "reason": "The case calls notificationState, setTheme, setMenuLanguage and projectFolder, which only the native host with a window answers (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "authorization": {
      "type": "string",
      "example": "notDetermined"
    },
    "clock-ts-us": {
      "type": "integer",
      "example": 1791000000000456
    },
    "clock-mono-ns": {
      "type": "integer",
      "example": 5000000789
    },
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    },
    "trip-us": {
      "type": "integer",
      "example": 412,
      "source": "page"
    },
    "resolution-us": {
      "type": "integer",
      "example": 1,
      "source": "page"
    },
