{
  "name": "report-levels-exposure",
  "description": "A core command whose settled wait fails reports the failure as an error record in a log batch, and the command, which still answers its value, records its command event in a second log batch.",
  "replay": true,
  "variables": {
    "page-identity": { "type": "string", "example": "5a0c9e7b-1f2d-4c3e-8b4a-6d7e8f901234", "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000472, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000812, "source": "page" },
    "ts-us-2": { "type": "integer", "example": 1791000000000473, "source": "page" },
    "mono-ns-2": { "type": "integer", "example": 5000000813, "source": "page" },
    "micros": { "type": "integer", "example": 1, "source": "page" }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "error", "event": "workbench.record.error", "fields": { "where": "exposure settled failed", "text": "surface tab-1 is not mounted" } }
          ]
        }
      }
    },
    { "reply": { "result": null } },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-2", "mono_ns": "$mono-ns-2", "start": "$page-identity", "level": "debug", "event": "workbench.command", "fields": { "name": "core.fixture.add", "micros": "$micros", "ok": true } }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
