{
  "name": "exposure-status-read-record",
  "description": "A status read that names a surface is forwarded to the surface it names, and the page stores the record workbench.status.read with the requested surface, the resolved surface and the owned session that the resolved surface shows, in one log batch after the clock anchor.",
  "replay": false,
  "reason": "The case records a status read that a surface answers, and the Go producer runs no page that forwards it (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    },
    "trip-us": {
      "type": "integer",
      "example": 412,
      "source": "page"
    },
    "resolution-us": {
      "type": "integer",
      "example": 1,
      "source": "page"
    },
    "clock-ts-us": {
      "type": "integer",
      "example": 1791000000000456,
      "source": "page"
    },
    "clock-mono-ns": {
      "type": "integer",
      "example": 5000000789,
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000461,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000801,
      "source": "page"
    },
    "ts-us": {
      "type": "integer",
      "example": 1791000000000456
    },
    "mono-ns": {
      "type": "integer",
      "example": 5000000789
    },
    "micros": {
      "type": "integer",
      "example": 1,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "exposureForward",
        "payload": {
          "id": 1,
          "surface": "tab-b",
          "method": "status.get",
          "params": {
            "name": "probe.lines",
            "surface": "tab-b"
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "result": {
            "screen": "tab-b"
          }
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$clock-ts-us",
              "mono_ns": "$clock-mono-ns",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.clock",
              "fields": {
                "trip_us": "$trip-us",
                "resolution_us": "$resolution-us"
              }
            },
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.status.read",
              "fields": {
                "name": "probe.lines",
                "requested": "tab-b",
                "resolved": "tab-b",
                "session": "s7",
                "micros": "$micros",
                "ok": true,
                "code": null
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
