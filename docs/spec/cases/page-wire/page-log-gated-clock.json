{
  "name": "page-log-gated-clock",
  "description": "Two calls that the gate refuses are counted, a record is relayed after more than a second of real time while the clock of the page stays at its start, and the count leaves in its own batch only when the clock of the page reaches the interval.",
  "replay": true,
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    },
    "host-ts-us": {
      "type": "integer",
      "example": 1791000000000456
    },
    "host-mono-ns": {
      "type": "integer",
      "example": 5000000789
    },
    "trip-us": {
      "type": "integer",
      "example": 0,
      "source": "page"
    },
    "resolution-us": {
      "type": "integer",
      "example": 1,
      "source": "page"
    },
    "ts-us-0": {
      "type": "integer",
      "example": 1791000000000456,
      "source": "page"
    },
    "mono-ns-0": {
      "type": "integer",
      "example": 5000000789,
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000456,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000789,
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000001000456,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5001000789,
      "source": "page"
    }
  },
  "steps": [
