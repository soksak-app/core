    {"reply":{"result":{"ts_us":"$clock-ts-us","mono_ns":"$clock-mono-ns"}}},
    {"call":{"name":"log","payload":{"action":"clock"}}},
    {"reply":{"result":{"ts_us":"$clock-ts-us","mono_ns":"$clock-mono-ns"}}},
    {"call":{"name":"log","payload":{"action":"batch","events":[{"ts_us":"$ts-us-1","mono_ns":"$mono-ns-1","start":"$page-identity","level":"info","event":"workbench.log.clock","fields":{"trip_us":"$trip-us-1","resolution_us":"$resolution-us-1"}},{"ts_us":"$ts-us-1","mono_ns":"$mono-ns-1","start":"$page-identity","level":"info","event":"workbench.start","fields":{"started_at":"$started-at-1","url":"http://soksak.test/index.html"}}]}}},
    {"reply":{"result":null}}
  ]
