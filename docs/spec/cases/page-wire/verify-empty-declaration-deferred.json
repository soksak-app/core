    "theme": {
      "type": "object",
      "example": {
        "scheme": "light",
        "tokens": {
          "--bg": "#fff"
        }
      },
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "setTheme",
        "payload": {
          "scheme": "light",
          "tokens": {
            "--bg": "#fff"
          }
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "syncSurfaces",
        "payload": {
          "settled": true,
          "overlays": [],
          "surfaces": [],
          "titlebar": 40,
          "declarations": [],
          "viewport": {
            "width": 1024,
            "height": 768
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "ticket": 1,
          "placements": [],
          "chrome": {
            "controls": {
              "x": 0,
              "y": 0,
              "w": 0,
              "h": 0
            },
            "row": 40
          }
        }
      }
    }
  ]
}
