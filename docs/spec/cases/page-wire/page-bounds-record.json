{
  "name": "page-bounds-record",
  "description": "The page reports an error whose place and text exceed their bounds: it cuts the place at 1024 bytes and the text at 8192 bytes, marks the event truncated, sends the clock anchor with the first batch, and then sends a short record of the info level without the truncated field.",
  "replay": true,
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    },
    "trip-us": {
      "type": "integer",
      "example": 412,
      "source": "page"
    },
    "resolution-us": {
      "type": "integer",
      "example": 1,
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000461,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000801,
      "source": "page"
    },
    "where-cut": {
      "type": "string",
      "example": "ppp",
      "source": "page"
    },
    "text-cut": {
      "type": "string",
      "example": "ééé",
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000000462,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5000000802,
      "source": "page"
    },
    "ts-us": {
      "type": "integer",
      "example": 1791000000000456
    },
    "mono-ns": {
      "type": "integer",
      "example": 5000000789
    }
  },
  "steps": [
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": 1791000000000456,
              "mono_ns": 5000000789,
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.clock",
              "fields": { "trip_us": "$trip-us", "resolution_us": "$resolution-us" }
            },
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": { "where": "$where-cut", "text": "$text-cut", "truncated": true }
            }
          ]
        }
      }
    },
    { "reply": { "result": null } },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.record.info",
              "fields": { "where": "short", "text": "text" }
            }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
