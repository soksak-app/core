{
  "name": "page-log-failed-relay-console",
  "description": "The host fails the log batch of a plugin event, and the page writes the failure to its original console only.",
  "replay": true,
  "variables": {
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000461, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000801, "source": "page" }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "info", "event": "plugin.fixture.x", "fields": {} }
          ]
        }
      }
    },
    { "reply": { "error": "host closed" } }
  ]
}
