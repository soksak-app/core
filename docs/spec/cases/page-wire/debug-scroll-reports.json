      "call": {
        "name": "overlayShow",
        "payload": "$show-request"
      }
    },
    {
      "reply": {
        "result": {
          "x": 0,
          "y": 0,
          "w": 1024,
          "h": 768
        }
      }
    },
    {
      "call": {
        "name": "debugRecord",
        "payload": {
          "workbench": "$statuses"
        }
      }
