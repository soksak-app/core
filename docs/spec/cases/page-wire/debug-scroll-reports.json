    {
      "reply": {
        "result": {
          "path": "logs/state.json"
        }
      }
    },
    {
      "call": {
        "name": "debugFiles"
      }
    },
    {
      "reply": {
        "result": []
      }
    },
    {
      "call": {
        "name": "overlayUpdate",
        "payload": "$update"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "overlayPlace",
        "payload": "$place"
      }
    },
    {
      "reply": {
        "result": {
          "x": 0,
          "y": 0,
          "w": 1024,
          "h": 768
        }
      }
    },
    {
      "call": {
        "name": "overlayUpdate",
        "payload": "$update-2"
      }
