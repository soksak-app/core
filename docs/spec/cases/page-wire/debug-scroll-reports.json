{
  "name": "debug-scroll-reports",
  "description": "The page opens the debug view, which records the state and lists the logs folder, and the modal reports the scroll position of its content eight times with the notice overlay-pick: four positions that the page keeps and four values that are not numbers, which the page refuses.",
  "replay": false,
  "reason": "The case shows, updates, places and hides a modal view of a window through the overlay calls, which the Go producer does not run (packages/host/go/tests/page_wire_test.go answers only log and workspace).",
  "variables": {
    "show-request": {
      "type": "object",
      "example": {},
      "source": "page"
    },
    "statuses": {
      "type": "array",
      "example": [],
      "source": "page"
    },
    "update": {
      "type": "object",
      "example": {},
      "source": "page"
    },
    "place": {
      "type": "object",
      "example": {},
      "source": "page"
    },
    "update-2": {
      "type": "object",
      "example": {},
      "source": "page"
    },
    "place-2": {
      "type": "object",
      "example": {},
      "source": "page"
    }
  },
  "steps": [
