{
  "name": "page-log-emit-event",
  "description": "The page queues two plugin events with their levels and fields, and sends them in one log batch.",
  "replay": true,
  "variables": {
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000461, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000801, "source": "page" },
    "ts-us-2": { "type": "integer", "example": 1791000000000462, "source": "page" },
    "mono-ns-2": { "type": "integer", "example": 5000000802, "source": "page" }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "debug", "event": "plugin.fixture.input",
              "fields": { "key": "a", "surface": "tab-1" } },
            { "ts_us": "$ts-us-2", "mono_ns": "$mono-ns-2", "start": "$page-identity", "level": "warn", "event": "plugin.fixture.slow",
              "fields": { "us": 9 } }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
