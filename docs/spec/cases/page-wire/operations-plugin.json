{
  "name": "operations-plugin",
  "description": "The page runs a plugin operation: the host runs the action with the identifiers of the operation, the page reads the plugin state after the run, and the page relays the event of the operation in a log batch.",
  "replay": false,
  "reason": "The case calls pluginsRun and pluginsState, which only the native host with the plugin registry answers (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000480, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000811, "source": "page" },
    "cid-1": { "type": "string", "example": "p0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e.3", "source": "page" }
  },
  "steps": [
    { "call": { "name": "pluginsRun", "payload": { "action": "install", "plugin": "tty" }, "cids": ["$cid-1"] } },
    { "reply": { "result": null } },
    { "call": { "name": "pluginsState" } },
    { "reply": { "result": { "installed": { "plugins": {}, "sidecars": {} }, "index": null, "registry": null } } },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "info", "event": "workbench.plugin.operation", "fields": { "action": "install", "plugin": "tty" }, "cids": ["$cid-1"] }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
