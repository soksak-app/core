{
  "name": "layout-verify-state-wait-refused",
  "description": "The first wait for the presentation of the window ends with the failure of the surface that did not present, and the wait of the next end of the failure is answered with null.",
  "replay": false,
  "reason": "The wait for the presentation of the window needs a window, and the Go producer runs only the log and workspace calls without a window (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000027727,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5027271477,
      "source": "page"
    },
    "page-identity": {
      "type": "string",
      "example": "1d105b4f-b6a5-498a-bacb-bc2c78aa5ad8",
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000027727,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5027271477,
      "source": "page"
    },
    "ts-us-3": {
      "type": "integer",
      "example": 1791000000027727,
      "source": "page"
    },
    "mono-ns-3": {
      "type": "integer",
      "example": 5027271477,
      "source": "page"
    },
    "ts-us-4": {
      "type": "integer",
      "example": 1791000000027727,
      "source": "page"
    },
    "mono-ns-4": {
      "type": "integer",
      "example": 5027271477,
      "source": "page"
    },
    "ts-us-5": {
      "type": "integer",
      "example": 1791000000016922,
      "source": "page"
    },
    "mono-ns-5": {
      "type": "integer",
      "example": 5016466393,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-4",
              "mono_ns": "$mono-ns-4",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "workbench",
                "text": "surface presentation failed: the current image raster did not present within 10s; pending tab-1/view generation 2 raster 1 sequence 0 presented 0/0 surface visible"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "waitPresented"
      }
    },
    {
      "reply": {
        "error": "the current image raster did not present within 10s; pending tab-1/view generation 2 raster 1 sequence 0 presented 0/0 surface visible"
      }
    },
    {
      "call": {
        "name": "waitPresented"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-5",
              "mono_ns": "$mono-ns-5",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.gated",
              "fields": {
                "class": "frame",
                "level": "debug",
                "count": 3
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
