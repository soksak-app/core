{
  "name": "plane-side-toggles",
  "description": "The page reads the notification state of the window once at its start. A layout with a sidebar fold sends no call; the close of the document moves the focus, and the one input event that the gate refused is reported in the batch of the flush.",
  "replay": false,
  "reason": "The notification state is the state of the notification center of the native host, which the Go producer does not run (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "ts-us": {
      "type": "integer",
      "example": 1791000000000456
    },
    "mono-ns": {
      "type": "integer",
      "example": 5000000789
    },
    "page-identity": {
      "type": "string",
      "example": "5a0c9e7b-1f2d-4c3e-8b4a-6d7e8f901234",
      "source": "page"
    },
    "trip-us": {
      "type": "integer",
      "example": 412,
      "source": "page"
    },
    "resolution-us": {
      "type": "integer",
      "example": 1,
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000501,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000801,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "notificationState"
      }
    },
    {
      "reply": {
        "result": {
          "authorization": "notDetermined",
          "error": null
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
