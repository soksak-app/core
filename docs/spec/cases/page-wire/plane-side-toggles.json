            {
              "ts_us": 1791000000000456,
              "mono_ns": 5000000789,
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.clock",
              "fields": {
                "trip_us": "$trip-us",
                "resolution_us": "$resolution-us"
              }
            },
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.gated",
              "fields": {
