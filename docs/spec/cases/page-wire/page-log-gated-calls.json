{
  "name": "page-log-gated-calls",
  "description": "The gate refuses the two successful calls of the policy and stores the refused call, and the log batch carries the count of the refused calls before the stored call.",
  "replay": true,
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "4cf991d7-f15e-4042-b526-6ec96e8cac3d",
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000007409,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5006954040,
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000007659,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5007203540,
      "source": "page"
    },
    "micros-1": {
      "type": "integer",
      "example": 50,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "warn",
              "event": "workbench.call",
              "fields": {
                "name": "bad",
                "args": "[{\"b\":2}]",
                "truncated": false,
                "micros": "$micros-1",
                "ok": false,
                "error": "-32603: refused"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.gated",
              "fields": {
                "class": "call",
                "level": "debug",
                "count": 2
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
