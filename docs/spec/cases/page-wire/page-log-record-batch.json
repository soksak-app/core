{
  "name": "page-log-record-batch",
  "description": "The page queues three records of one turn, an observation without a place, a failure and an observation, and sends them in one log batch.",
  "replay": true,
  "variables": {
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000461, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000801, "source": "page" },
    "ts-us-2": { "type": "integer", "example": 1791000000000462, "source": "page" },
    "mono-ns-2": { "type": "integer", "example": 5000000802, "source": "page" },
    "ts-us-3": { "type": "integer", "example": 1791000000000463, "source": "page" },
    "mono-ns-3": { "type": "integer", "example": 5000000803, "source": "page" }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "info", "event": "workbench.record.info",
              "fields": { "where": "workbench", "text": "focus moved to probe" } },
            { "ts_us": "$ts-us-2", "mono_ns": "$mono-ns-2", "start": "$page-identity", "level": "error", "event": "workbench.record.error",
              "fields": { "where": "second", "text": "failure\nsecond line" } },
            { "ts_us": "$ts-us-3", "mono_ns": "$mono-ns-3", "start": "$page-identity", "level": "info", "event": "workbench.record.info",
              "fields": { "where": "workbench", "text": "third" } }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
