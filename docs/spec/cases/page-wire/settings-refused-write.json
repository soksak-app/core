{
  "name": "settings-refused-write",
  "description": "A setting write that the host refuses answers its error, and the page then reads the stored settings: the value that the control shows is the stored true of memorySaver, not the value of the refused write.",
  "replay": false,
  "reason": "The page-wire producer of the Go host has no fault point that refuses a settings write, so the refusal is recorded by the case and only the page reader plays it.",
  "variables": {
    "theme-1": {
      "type": "object",
      "example": {
        "scheme": "dark",
        "tokens": {
          "--bg": "#101117"
        }
      },
      "source": "page"
    },
    "language": {
      "type": "string",
      "example": "ko",
      "source": "page"
    },
    "cid-1": {
      "type": "string",
      "example": "pac2a25e3-c159-4f4e-a904-9e4ddea55f2c.1",
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "workspace",
        "payload": {
          "kind": "snapshot"
        }
      }
    },
    {
      "reply": {
        "result": {
          "common": {
            "memorySaver": true
          },
          "pluginData": {},
          "projects": []
        }
      }
    },
    {
      "call": {
        "name": "setTheme",
        "payload": "$theme-1"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "performance",
        "payload": {
          "action": "off"
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "setMenuLanguage",
        "payload": "$language"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "setTheme",
        "payload": "$theme-1"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "workspace",
        "payload": {
          "kind": "settings",
          "id": null,
          "patch": {
            "memorySaver": false
          },
          "remove": []
        },
        "cids": [
          "$cid-1"
        ]
      }
    },
    {
      "reply": {
        "error": "the configuration directory is read-only"
      }
    },
    {
      "call": {
        "name": "setMenuLanguage",
        "payload": "$language"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "workspace",
        "payload": {
          "kind": "snapshot"
        }
      }
    },
    {
      "reply": {
        "result": {
          "common": {
            "memorySaver": true
          },
          "pluginData": {},
          "projects": []
        }
      }
    },
    {
      "call": {
        "name": "setTheme",
        "payload": "$theme-1"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "setMenuLanguage",
        "payload": "$language"
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
