{
  "name": "page-log-relay-failure",
  "description": "The host fails the first log batch with a closed host, and the page sends the next record in a second log batch, which the host answers.",
  "replay": false,
  "reason": "The log call of the case fails with host closed, the answer of a host whose connection ended, and the producer runs a host that does not end.",
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000461,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000801,
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000000462,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5000000802,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "a",
                "text": "lost"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "error": "host closed"
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.record.info",
              "fields": {
                "where": "b",
                "text": "kept"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
