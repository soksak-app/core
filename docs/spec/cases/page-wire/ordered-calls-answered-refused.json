{
  "name": "ordered-calls-answered-refused",
  "description": "The page hides the menu modal, then shows it; the host refuses the show, so the page records the failure in the log batch after it reads the host clock five times, and then hides the modal again.",
  "replay": false,
  "reason": "overlayShow opens a native modal view in the window, and only the native host with a window produces its answer (docs/operations/examples.md#test-kinds).",
  "variables": {
    "ts-us": { "type": "integer", "example": 1791000000000456 },
    "mono-ns": { "type": "integer", "example": 5000000789 },
    "page-identity": { "type": "string", "example": "e3a1c7d2-5b9f-4e0a-8d2c-6f1b3a9e7c40", "source": "page" },
    "trip-us": { "type": "integer", "example": 120, "source": "page" },
    "resolution-us": { "type": "integer", "example": 1, "source": "page" },
    "clock-ts-us": { "type": "integer", "example": 1791000000000456, "source": "page" },
    "clock-mono-ns": { "type": "integer", "example": 5000000789, "source": "page" },
    "record-ts-us": { "type": "integer", "example": 1791000000000470, "source": "page" },
    "record-mono-ns": { "type": "integer", "example": 5000000803, "source": "page" }
  },
  "steps": [
    { "call": { "name": "overlayHide", "payload": "menu" } },
    { "reply": { "result": null, "held": true } },
    { "call": { "name": "overlayShow", "payload": { "id": "menu", "title": "Menu", "rect": { "x": 0, "y": 0, "w": 10, "h": 10 }, "mode": "menu", "card": { "x": 0, "y": 0, "w": 0, "h": 0 }, "className": "", "html": "", "css": "", "border": "rgb(7, 8, 9)", "radius": 4 } } },
    { "reply": { "error": "create modal webview: refused", "held": true } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": {
      "action": "batch",
      "events": [
        { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns", "start": "$page-identity", "level": "info", "event": "workbench.log.clock", "fields": { "trip_us": "$trip-us", "resolution_us": "$resolution-us" } },
        { "ts_us": "$record-ts-us", "mono_ns": "$record-mono-ns", "start": "$page-identity", "level": "error", "event": "workbench.record.error", "fields": { "where": "host overlayShow failed", "text": "Error: create modal webview: refused" } }
      ]
    } } },
    { "reply": { "result": null } },
    { "call": { "name": "overlayHide", "payload": "menu" } },
    { "reply": { "result": null } }
  ]
}
