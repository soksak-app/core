{
  "name": "layout-failure-lines-gesture",
  "description": "A failed layout that no command waits for writes its failure once as a workbench error record in the next log batch, and the page sends no other call.",
  "replay": true,
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "d75099a9-d8d6-4fc6-b5e5-49782a0edfe6",
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000009511,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5009055956,
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000008929,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5008473331,
      "source": "page"
    },
    "ts-us-3": {
      "type": "integer",
      "example": 1791000000009503,
      "source": "page"
    },
    "mono-ns-3": {
      "type": "integer",
      "example": 5009047164,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "workbench",
                "text": "surface presentation failed: the current image raster did not present within 10s; pending tab-1/view generation 2 raster 1 sequence 0 presented 0/0 surface visible"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.gated",
              "fields": {
                "class": "call",
                "level": "debug",
                "count": 1
              }
            },
            {
              "ts_us": "$ts-us-3",
              "mono_ns": "$mono-ns-3",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.gated",
              "fields": {
                "class": "frame",
                "level": "debug",
                "count": 3
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
