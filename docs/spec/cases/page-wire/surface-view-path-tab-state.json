{
  "name": "surface-view-path-tab-state",
  "description": "A view of a plugin with surface.unload writes its tab state and reads it back through view calls, the refusals of an oversized state, a state without a value and a state of another format name the tab, and the store writes the last entry of the tab to the host.",
  "replay": false,
  "reason": "The view calls reach the page as the notice view-call of a view that the host runs in a window, which the Go producer does not run (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {"page-identity": {"type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page"}, "bytes": {"type": "integer", "example": 62}},
  "steps": [
    {"call": {"name": "workspace", "payload": {"kind": "snapshot"}}},
    {"reply": {"result": {"common": {}, "projects": [], "open": []}}},
    {"call": {"name": "workspace", "payload": {"kind": "tabState"}}},
    {"reply": {"result": null}},
    {"call": {"name": "workspace", "payload": {"kind": "tabSessions"}}},
    {"reply": {"result": []}},
    {"call": {"name": "windowReady"}},
    {"reply": {"result": null}},
    {"call": {"name": "compositionDeclare", "payload": {"plugin": "fixture-unload", "composition": {"kind": "view", "page": "ui/page.html", "regions": [], "overlays": []}, "surface": "view-state-a"}}},
    {"reply": {"result": null}},
    {"notice": {"event": "view-call", "payload": {"surface": "view-state-a", "plugin": "fixture-unload", "generation": 1, "id": 1, "command": "tab.state.read"}}},
    {"call": {"name": "viewReply", "payload": {"id": 1, "result": null, "page": "$page-identity", "generation": 1, "surface": "view-state-a"}}},
    {"reply": {"result": null}},
    {"notice": {"event": "view-call", "payload": {"surface": "view-state-a", "plugin": "fixture-unload", "generation": 1, "id": 2, "command": "tab.state.write", "params": {"page": 3}}}},
    {"call": {"name": "viewReply", "payload": {"id": 2, "result": null, "page": "$page-identity", "generation": 1, "surface": "view-state-a"}}},
    {"reply": {"result": null}},
    {"notice": {"event": "view-call", "payload": {"surface": "view-state-a", "plugin": "fixture-unload", "generation": 1, "id": 3, "command": "tab.state.read"}}},
    {"call": {"name": "viewReply", "payload": {"id": 3, "result": {"page": 3}, "page": "$page-identity", "generation": 1, "surface": "view-state-a"}}},
    {"reply": {"result": null}},
    {"notice": {"event": "view-call", "payload": {"surface": "view-state-a", "plugin": "fixture-unload", "generation": 1, "id": 4, "command": "tab.state.write", "params": {"text": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}}}},
    {"call": {"name": "viewReply", "payload": {"id": 4, "error": {"code": -32000, "message": "tab view-state-a state of 111 bytes exceeds 64"}, "page": "$page-identity", "generation": 1, "surface": "view-state-a"}}},
    {"reply": {"result": null}},
    {"notice": {"event": "view-call", "payload": {"surface": "view-state-a", "plugin": "fixture-unload", "generation": 1, "id": 5, "command": "tab.state.write"}}},
    {"call": {"name": "viewReply", "payload": {"id": 5, "error": {"code": -32000, "message": "tab view-state-a state is not JSON: undefined"}, "page": "$page-identity", "generation": 1, "surface": "view-state-a"}}},
    {"reply": {"result": null}},
    {"notice": {"event": "view-call", "payload": {"surface": "view-state-a", "plugin": "fixture-unload", "generation": 1, "id": 6, "command": "tab.state.read"}}},
    {"call": {"name": "viewReply", "payload": {"id": 6, "error": {"code": -32000, "message": "tab view-state-a state format 1 is not 2"}, "page": "$page-identity", "generation": 1, "surface": "view-state-a"}}},
    {"reply": {"result": null}},
    {"call": {"name": "workspace", "payload": {"kind": "tabStatePut", "tab": "view-state-a", "entry": {"state": {"format": 1, "value": {}}}}}},
    {"reply": {"result": "$bytes"}}
  ]
