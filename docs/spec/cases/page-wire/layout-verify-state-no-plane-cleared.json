{
  "name": "layout-verify-state-no-plane-cleared",
  "description": "A failed layout is written as a record; the presented layout after it and the end of the failure send two waits for the presentation of the window, which the host answers with null.",
  "replay": false,
  "reason": "The wait for the presentation of the window needs a window, and the Go producer runs only the log and workspace calls without a window (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000029577,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5029121268,
      "source": "page"
    },
    "page-identity": {
      "type": "string",
      "example": "0d33d5a1-d236-4f27-a954-46143dfcfbb9",
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "waitPresented"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "waitPresented"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.gated",
              "fields": {
                "class": "frame",
                "level": "debug",
                "count": 10
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
