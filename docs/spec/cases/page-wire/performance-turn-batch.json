{
  "name": "performance-turn-batch",
  "description": "With the trace on, the events of one turn go to the host in one log batch, in the order they were traced, and the switch goes off on the next request.",
  "replay": true,
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000480,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000820,
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000000481,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5000000821,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "performance",
        "payload": {
          "action": "on"
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.trace.action",
              "fields": {
                "kind": "resize",
                "width": 1200
              }
            },
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.trace.focus",
              "fields": {
                "phase": "in"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "performance",
        "payload": {
          "action": "off"
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
