{
  "name": "page-log-host-call-events",
  "description": "The page sends six host calls, and each call that the log records is a workbench call event in the log batch that follows it; the bad call is refused by the host and recorded at the level warn.",
  "replay": false,
  "reason": "The producer runs only the calls log and workspace (docs/spec/cases/page-wire/README.md#producer-runs), and this case holds the calls good, bad, logQuery, overlayUpdate, overlayPlace and big of the test.",
  "variables": {
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "big-text": { "type": "string", "example": "xxxxxxxx", "source": "page" },
    "big-args": { "type": "string", "example": "[{\"text\":\"xxxxxxxx\"}]", "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000461, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000801, "source": "page" },
    "ts-us-2": { "type": "integer", "example": 1791000000000462, "source": "page" },
    "mono-ns-2": { "type": "integer", "example": 5000000802, "source": "page" },
    "ts-us-3": { "type": "integer", "example": 1791000000000463, "source": "page" },
    "mono-ns-3": { "type": "integer", "example": 5000000803, "source": "page" },
    "micros-1": { "type": "integer", "example": 120, "source": "page" },
    "micros-2": { "type": "integer", "example": 95, "source": "page" },
    "micros-3": { "type": "integer", "example": 140, "source": "page" }
  },
  "steps": [
    { "call": { "name": "good", "payload": { "a": 1 } } },
    { "reply": { "result": null } },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "debug", "event": "workbench.call",
              "fields": { "name": "good", "args": "[{\"a\":1}]", "truncated": false, "micros": "$micros-1", "ok": true } }
          ]
        }
      }
    },
    { "reply": { "result": null } },
    { "call": { "name": "bad" } },
    { "reply": { "error": "refused" } },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-2", "mono_ns": "$mono-ns-2", "start": "$page-identity", "level": "warn", "event": "workbench.call",
              "fields": { "name": "bad", "args": "[]", "truncated": false, "micros": "$micros-2", "ok": false, "error": "-32603: refused" } }
          ]
        }
      }
    },
    { "reply": { "result": null } },
    { "call": { "name": "log", "payload": { "action": "batch", "events": [] } } },
    { "reply": { "result": null } },
    { "call": { "name": "logQuery", "payload": { "order": "desc", "limit": 500 } } },
    { "reply": { "result": null } },
    { "call": { "name": "overlayUpdate", "payload": { "id": "debug", "html": "<p></p>" } } },
    { "reply": { "result": null } },
    { "call": { "name": "overlayPlace", "payload": { "id": "debug", "rect": { "x": 0, "y": 0, "w": 1, "h": 1 } } } },
    { "reply": { "result": null } },
    { "call": { "name": "big", "payload": { "text": "$big-text" } } },
    { "reply": { "result": null } },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-3", "mono_ns": "$mono-ns-3", "start": "$page-identity", "level": "debug", "event": "workbench.call",
              "fields": { "name": "big", "args": "$big-args", "truncated": true, "micros": "$micros-3", "ok": true } }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
