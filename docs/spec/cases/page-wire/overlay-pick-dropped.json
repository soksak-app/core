{
  "name": "overlay-pick-dropped",
  "description": "The host relays a reply of a modal document that the page does not show, and the page records it as the event workbench.overlay.dropped; the page sends its clock anchor and that event in one log batch after the clock answers of the host.",
  "replay": false,
  "reason": "The case delivers the overlay-pick notice that a native modal view sends, and the Go producer runs no window and refuses a notice (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "trip-us": { "type": "integer", "example": 412, "source": "page" },
    "resolution-us": { "type": "integer", "example": 1, "source": "page" },
    "clock-ts-us": { "type": "integer", "example": 1791000000000456, "source": "page" },
    "clock-mono-ns": { "type": "integer", "example": 5000000789, "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000461, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000801, "source": "page" },
    "ts-us": { "type": "integer", "example": 1791000000000456 },
    "mono-ns": { "type": "integer", "example": 5000000789 }
  },
  "steps": [
    { "notice": { "event": "overlay-pick", "payload": { "id": "debug", "key": "save-all", "value": "" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns", "start": "$page-identity", "level": "info", "event": "workbench.log.clock", "fields": { "trip_us": "$trip-us", "resolution_us": "$resolution-us" } },
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "info", "event": "workbench.overlay.dropped", "fields": { "id": "debug", "shown": "", "key": "save-all" } }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
