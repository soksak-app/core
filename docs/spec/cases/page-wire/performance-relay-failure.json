{
  "name": "performance-relay-failure",
  "description": "A failed relay of the trace batch is reported with its event count, and a failed switch off rejects the switch; the first batch of the writer carries the clock statement of the page.",
  "replay": true,
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    },
    "trip-us": {
      "type": "integer",
      "example": 412,
      "source": "page"
    },
    "resolution-us": {
      "type": "integer",
      "example": 1,
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000500,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000840,
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000000501,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5000000841,
      "source": "page"
    },
    "us": {
      "type": "integer",
      "example": 1500,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "performance",
        "payload": {
          "action": "on"
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": 1791000000000456,
          "mono_ns": 5000000789
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": 1791000000000456,
          "mono_ns": 5000000789
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": 1791000000000456,
          "mono_ns": 5000000789
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": 1791000000000456,
          "mono_ns": 5000000789
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": 1791000000000456,
          "mono_ns": 5000000789
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.clock",
              "fields": {
                "trip_us": "$trip-us",
                "resolution_us": "$resolution-us"
              }
            },
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.trace.command",
              "fields": {
                "name": "core.ok",
                "us": "$us",
                "ok": true
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "error": "relay failed"
      }
    },
    {
      "call": {
        "name": "performance",
        "payload": {
          "action": "off"
        }
      }
    },
    {
      "reply": {
        "error": "switch failed"
      }
    }
  ]
}
