{
  "name": "verify-ahead-v7c-named",
  "description": "The page reads the notification authorization of the host when the plane is imported, prepares one layout of one DOM surface of a plugin in a plane at 6,6, and the host answers the syncSurfaces call with the placement that it applied at the declared place.",
  "replay": false,
  "reason": "notificationState and syncSurfaces belong to a window, and the Go producer runs only log and workspace calls without a window.",
  "variables": {
    "authorization": {
      "type": "string",
      "example": "notDetermined"
    }
  },
  "steps": [
    {
      "call": {
        "name": "notificationState"
      }
    },
    {
      "reply": {
        "result": {
          "authorization": "$authorization",
          "error": null
        }
      }
    },
    {
      "call": {
        "name": "surfaceFocus",
        "payload": {
          "surface": null
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "syncSurfaces",
        "payload": {
          "settled": true,
          "overlays": [],
          "surfaces": [
            {
              "id": "probe",
              "dim": false,
              "plugin": "probe",
              "composition": {
                "kind": "dom"
              },
              "visible": true,
              "x": 6,
              "y": 40,
              "w": 400,
              "h": 240
            }
          ],
          "titlebar": 40,
          "declarations": [],
          "viewport": {
            "width": 1024,
            "height": 768
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "ticket": 1,
          "placements": [
            {
              "id": "probe",
              "visible": true,
              "scale": 1,
              "x": 6,
              "y": 40,
              "w": 400,
              "h": 240
            }
          ],
          "chrome": {
            "controls": {
              "x": 0,
              "y": 0,
              "w": 0,
              "h": 0
            },
            "row": 40
          }
        }
      }
    }
  ]
}
