{
  "name": "error-toasts",
  "description": "The visible workbench toasts write two distinct error records, and repeating or dismissing either toast writes no other record.",
  "replay": true,
  "variables": {
    "clock-ts-us": {
      "type": "integer",
      "example": 1791000000000456
    },
    "clock-mono-ns": {
      "type": "integer",
      "example": 5000000789
    },
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    },
    "trip-us": {
      "type": "integer",
      "example": 412,
      "source": "page"
    },
    "resolution-us": {
      "type": "integer",
      "example": 1,
      "source": "page"
    },
    "anchor-ts-us": {
      "type": "integer",
      "example": 1791000000000456,
      "source": "page"
    },
    "anchor-mono-ns": {
      "type": "integer",
      "example": 5000000789,
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000461,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000801,
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000000462,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5000000802,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us",
          "mono_ns": "$clock-mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us",
          "mono_ns": "$clock-mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us",
          "mono_ns": "$clock-mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us",
          "mono_ns": "$clock-mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us",
          "mono_ns": "$clock-mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$anchor-ts-us",
              "mono_ns": "$anchor-mono-ns",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.clock",
              "fields": {
                "trip_us": "$trip-us",
                "resolution_us": "$resolution-us"
              }
            },
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "workbench",
                "text": "first failure"
              }
            },
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "workbench",
                "text": "second failure"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
