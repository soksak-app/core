    "snapshot": {
      "type": "object",
      "example": {
        "common": {
          "diagnostics.log": {
            "lifecycle": "info",
            "call": "info"
          },
          "left": false
        },
        "projects": [
          {
            "id": "prj-one",
            "root": "/work/one",
            "identity": "1:1",
            "title": "one",
            "color": "#fff",
            "named": 1,
            "activeSpaceId": "spc-one",
            "spaces": [
