{
  "name": "performance-frame-gate",
  "description": "With the trace off and the frame gate open, a layout phase is relayed in the batch of the page after the five clock answers of the host; a focus event of the call class is not.",
  "replay": true,
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    },
    "trip-us": {
      "type": "integer",
      "example": 412,
      "source": "page"
    },
    "resolution-us": {
      "type": "integer",
      "example": 1,
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000456,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000789,
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000000461,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5000000801,
      "source": "page"
    },
    "clock-ts-us-1": {
      "type": "integer",
      "example": 1791000000000456
    },
    "clock-mono-ns-1": {
      "type": "integer",
      "example": 5000000789
    },
    "clock-ts-us-2": {
      "type": "integer",
      "example": 1791000000000456
    },
    "clock-mono-ns-2": {
      "type": "integer",
      "example": 5000000789
    },
    "clock-ts-us-3": {
      "type": "integer",
      "example": 1791000000000456
    },
    "clock-mono-ns-3": {
      "type": "integer",
      "example": 5000000789
    },
    "clock-ts-us-4": {
      "type": "integer",
      "example": 1791000000000456
    },
    "clock-mono-ns-4": {
      "type": "integer",
      "example": 5000000789
    },
    "clock-ts-us-5": {
      "type": "integer",
      "example": 1791000000000456
    },
    "clock-mono-ns-5": {
      "type": "integer",
      "example": 5000000789
    }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us-1",
          "mono_ns": "$clock-mono-ns-1"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us-2",
          "mono_ns": "$clock-mono-ns-2"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us-3",
          "mono_ns": "$clock-mono-ns-3"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us-4",
          "mono_ns": "$clock-mono-ns-4"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us-5",
          "mono_ns": "$clock-mono-ns-5"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.clock",
              "fields": {
                "trip_us": "$trip-us",
                "resolution_us": "$resolution-us"
              }
            },
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.trace.layout",
              "fields": {
                "phase": "queued",
                "id": 1,
                "t": 2
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
