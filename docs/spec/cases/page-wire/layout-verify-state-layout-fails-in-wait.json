{
  "name": "layout-verify-state-layout-fails-in-wait",
  "description": "The end of the failure of a layout sends one wait for the presentation of the window, which a second failed layout meets; the host answers it with null after that failure.",
  "replay": false,
  "reason": "The wait for the presentation of the window needs a window, and the Go producer runs only the log and workspace calls without a window (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000015128,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5014672830,
      "source": "page"
    },
    "page-identity": {
      "type": "string",
      "example": "3a8bc9d5-9c42-40ba-ae3f-14fd26234cd0",
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000015128,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5014672830,
      "source": "page"
    },
    "ts-us-3": {
      "type": "integer",
      "example": 1791000000015128,
      "source": "page"
    },
    "mono-ns-3": {
      "type": "integer",
      "example": 5014672830,
      "source": "page"
    },
    "ts-us-4": {
      "type": "integer",
      "example": 1791000000016272,
      "source": "page"
    },
    "mono-ns-4": {
      "type": "integer",
      "example": 5015816873,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-3",
              "mono_ns": "$mono-ns-3",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "workbench",
                "text": "surface presentation failed: the current image raster did not present within 10s; pending tab-1/view generation 2 raster 1 sequence 0 presented 0/0 surface visible"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "waitPresented"
      }
    },
    {
      "reply": {
        "result": null,
        "held": true
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-4",
              "mono_ns": "$mono-ns-4",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.gated",
              "fields": {
                "class": "frame",
                "level": "debug",
                "count": 6
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
