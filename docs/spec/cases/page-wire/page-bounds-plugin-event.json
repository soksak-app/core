{
  "name": "page-bounds-plugin-event",
  "description": "The page sends an event of a plugin whose fields exceed 65536 bytes as its head of 4096 bytes with the truncated marker, and sends a small event of the same batch with its fields unchanged.",
  "replay": true,
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000471,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000811,
      "source": "page"
    },
    "head": {
      "type": "string",
      "example": "[1,1,1,1",
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000000472,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5000000812,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "info",
              "event": "plugin.test.big",
              "fields": { "head": "$head", "truncated": true }
            },
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "info",
              "event": "plugin.test.small",
              "fields": { "data": "x" }
            }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
