{
  "name": "layout-verify-state-failure-repeats",
  "description": "Two failed layouts write their failure as workbench error records and send no wait for the presentation of the window.",
  "replay": true,
  "variables": {
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000022691,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5022235748,
      "source": "page"
    },
    "page-identity": {
      "type": "string",
      "example": "234288a3-6d6e-4ab1-8d71-8b36db36c140",
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.gated",
              "fields": {
                "class": "frame",
                "level": "debug",
                "count": 6
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
