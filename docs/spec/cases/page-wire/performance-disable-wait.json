{
  "name": "performance-disable-wait",
  "description": "The trace is switched off while its accepted events are still in flight: the held batch of the accepted event is released first, and then the switch goes off.",
  "replay": false,
  "reason": "The case calls performance, which the producer does not run.",
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000490,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000830,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "performance",
        "payload": {
          "action": "on"
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.trace.focus",
              "fields": {}
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null,
        "held": true
      }
    },
    {
      "call": {
        "name": "performance",
        "payload": {
          "action": "off"
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
