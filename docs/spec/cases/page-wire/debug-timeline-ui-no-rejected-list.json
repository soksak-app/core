{
  "name": "debug-timeline-ui-no-rejected-list",
  "description": "The page shows the timeline, and the host answers a page without the list of the rejected files, which the page refuses.",
  "replay": false,
  "reason": "The case shows, updates, places and hides a modal view of a window through the overlay calls, which the Go producer does not run (packages/host/go/tests/page_wire_test.go answers only log and workspace).",
  "variables": {
    "show-request": {
      "type": "object",
      "example": {},
      "source": "page"
    },
    "statuses": {
      "type": "array",
      "example": [],
      "source": "page"
    },
    "update": {
      "type": "object",
      "example": {},
      "source": "page"
    },
    "place": {
      "type": "object",
      "example": {},
      "source": "page"
    },
    "update-2": {
      "type": "object",
      "example": {},
      "source": "page"
    },
    "place-2": {
      "type": "object",
      "example": {},
      "source": "page"
    },
    "update-3": {
      "type": "object",
      "example": {},
      "source": "page"
    },
    "ts-us": {
      "type": "integer",
      "example": 1791000000000456,
      "source": "page"
    },
    "mono-ns": {
      "type": "integer",
      "example": 5000000789,
      "source": "page"
    },
    "page-identity": {
      "type": "string",
      "example": "6571a40e-6d32-4c55-9632-3f4f321f53e5",
      "source": "page"
    },
    "place-3": {
      "type": "object",
      "example": {},
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "overlayShow",
        "payload": "$show-request"
      }
    },
    {
      "reply": {
        "result": {
          "x": 0,
          "y": 0,
          "w": 1024,
          "h": 768
        }
      }
    },
    {
      "call": {
        "name": "debugRecord",
        "payload": {
          "workbench": "$statuses"
        }
      }
    },
    {
      "reply": {
        "result": {
          "path": "logs/state.json"
        }
      }
    },
    {
      "call": {
        "name": "debugFiles"
      }
    },
    {
      "reply": {
        "result": []
      }
    },
    {
      "call": {
        "name": "overlayUpdate",
        "payload": "$update"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "overlayPlace",
        "payload": "$place"
      }
    },
    {
      "reply": {
        "result": {
          "x": 0,
          "y": 0,
          "w": 1024,
          "h": 768
        }
      }
    },
    {
      "call": {
        "name": "overlayUpdate",
        "payload": "$update-2"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "overlayPlace",
        "payload": "$place-2"
      }
    },
    {
      "reply": {
        "result": {
          "x": 0,
          "y": 0,
          "w": 1024,
          "h": 768
        }
      }
    },
    {
      "call": {
        "name": "logQuery",
        "payload": {
          "channel": "other",
          "level": "trace",
          "order": "desc",
          "limit": 500
        }
      }
    },
    {
      "reply": {
        "result": {
          "rows": [],
          "next": null,
          "tail": {}
        }
      }
    },
    {
      "call": {
        "name": "overlayUpdate",
        "payload": "$update-3"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us",
              "mono_ns": "$mono-ns",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "debug",
                "text": "timeline: the host answered a page without rows, a tail and the rejected files: {\"rows\":[],\"next\":null,\"tail\":{}}"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "overlayPlace",
        "payload": "$place-3"
      }
    },
    {
      "reply": {
        "result": {
          "x": 0,
          "y": 0,
          "w": 1024,
          "h": 768
        }
      }
    },
    {
      "call": {
        "name": "overlayHide",
        "payload": "debug"
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
