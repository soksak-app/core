{
  "name": "settings-debug-switch",
  "description": "The debug switch on writes the trace on and the policy that sets every class to trace; the switch off writes the trace off and the empty policy, which stores only the errors; a change that names the trace and a policy of one class at trace writes both values. Each write carries the identifiers of its change, as the policy of the change does.",
  "replay": false,
  "reason": "The reply of the call workspace with the kind snapshot is the state of the registry, which the Go producer builds no project for (docs/spec/cases/page-wire/README.md#limits), and the calls setTheme, setMenuLanguage and performance apply to the window of the native host, which the producer does not run.",
  "variables": {
    "theme-1": { "type": "object", "example": { "scheme": "dark", "tokens": { "--bg": "#111" } }, "source": "page" },
    "theme-2": { "type": "object", "example": { "scheme": "dark", "tokens": { "--bg": "#111" } }, "source": "page" },
    "theme-3": { "type": "object", "example": { "scheme": "dark", "tokens": { "--bg": "#111" } }, "source": "page" },
    "language": { "type": "string", "example": "ko", "source": "page" },
    "cid-1": { "type": "string", "example": "p6f1d0c2e-5a7b-4e8f-9c3d-2b1a0f9e8d7c.1", "source": "page" },
    "cid-2": { "type": "string", "example": "p6f1d0c2e-5a7b-4e8f-9c3d-2b1a0f9e8d7c.2", "source": "page" },
    "cid-3": { "type": "string", "example": "p6f1d0c2e-5a7b-4e8f-9c3d-2b1a0f9e8d7c.3", "source": "page" }
  },
  "steps": [
    { "call": { "name": "workspace", "payload": { "kind": "snapshot" } } },
    { "reply": { "result": { "common": {}, "projects": [] } } },
    { "call": { "name": "performance", "payload": { "action": "off" } } },
    { "reply": { "result": null } },

    { "call": { "name": "log", "payload": { "action": "policy", "classes": { "lifecycle": "trace", "input": "trace", "call": "trace", "io": "trace", "frame": "trace" }, "cids": ["$cid-1"] } } },
    { "reply": { "result": null } },
    { "call": { "name": "setTheme", "payload": "$theme-1" } },
    { "reply": { "result": null } },
    { "call": { "name": "performance", "payload": { "action": "on" } } },
    { "reply": { "result": null } },
    { "call": { "name": "setMenuLanguage", "payload": "$language" } },
    { "reply": { "result": null } },
    { "call": { "name": "workspace", "payload": { "kind": "settings", "id": null, "patch": { "diagnostics.performance": true, "diagnostics.log": { "lifecycle": "trace", "input": "trace", "call": "trace", "io": "trace", "frame": "trace" } }, "remove": [] }, "cids": ["$cid-1"] } },
    { "reply": { "result": null } },
    { "call": { "name": "workspace", "payload": { "kind": "snapshot" } } },
    { "reply": { "result": { "common": { "diagnostics.performance": true, "diagnostics.log": { "lifecycle": "trace", "input": "trace", "call": "trace", "io": "trace", "frame": "trace" } }, "projects": [] } } },

    { "call": { "name": "log", "payload": { "action": "policy", "classes": { "lifecycle": "error", "input": "error", "call": "error", "io": "error", "frame": "error" }, "cids": ["$cid-2"] } } },
    { "reply": { "result": null } },
    { "call": { "name": "setTheme", "payload": "$theme-2" } },
    { "reply": { "result": null } },
    { "call": { "name": "performance", "payload": { "action": "off" } } },
    { "reply": { "result": null } },
    { "call": { "name": "setMenuLanguage", "payload": "$language" } },
    { "reply": { "result": null } },
    { "call": { "name": "workspace", "payload": { "kind": "settings", "id": null, "patch": { "diagnostics.performance": false, "diagnostics.log": {} }, "remove": [] }, "cids": ["$cid-2"] } },
    { "reply": { "result": null } },
    { "call": { "name": "workspace", "payload": { "kind": "snapshot" } } },
    { "reply": { "result": { "common": { "diagnostics.performance": false, "diagnostics.log": {} }, "projects": [] } } },

    { "call": { "name": "log", "payload": { "action": "policy", "classes": { "lifecycle": "error", "input": "error", "call": "trace", "io": "error", "frame": "error" }, "cids": ["$cid-3"] } } },
    { "reply": { "result": null } },
    { "call": { "name": "setTheme", "payload": "$theme-3" } },
    { "reply": { "result": null } },
    { "call": { "name": "performance", "payload": { "action": "on" } } },
    { "reply": { "result": null } },
    { "call": { "name": "setMenuLanguage", "payload": "$language" } },
    { "reply": { "result": null } },
    { "call": { "name": "workspace", "payload": { "kind": "settings", "id": null, "patch": { "diagnostics.performance": true, "diagnostics.log": { "call": "trace" } }, "remove": [] }, "cids": ["$cid-3"] } },
    { "reply": { "result": null } },
    { "call": { "name": "workspace", "payload": { "kind": "snapshot" } } },
    { "reply": { "result": { "common": { "diagnostics.performance": true, "diagnostics.log": { "call": "trace" } }, "projects": [] } } }
  ]
}
