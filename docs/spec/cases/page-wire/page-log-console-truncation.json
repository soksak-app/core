{
  "name": "page-log-console-truncation",
  "description": "The page records a console text and a console structure that are cut at 8192 bytes with the field truncated, and a short console text, in one log batch.",
  "replay": true,
  "variables": {
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "long-text": { "type": "string", "example": "ééé", "source": "page" },
    "structure-text": { "type": "string", "example": "[1,1,1]", "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000461, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000801, "source": "page" },
    "ts-us-2": { "type": "integer", "example": 1791000000000462, "source": "page" },
    "mono-ns-2": { "type": "integer", "example": 5000000802, "source": "page" },
    "ts-us-3": { "type": "integer", "example": 1791000000000463, "source": "page" },
    "mono-ns-3": { "type": "integer", "example": 5000000803, "source": "page" }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "info", "event": "workbench.console.log",
              "fields": { "text": "$long-text", "truncated": true } },
            { "ts_us": "$ts-us-2", "mono_ns": "$mono-ns-2", "start": "$page-identity", "level": "info", "event": "workbench.console.info",
              "fields": { "text": "$structure-text", "truncated": true } },
            { "ts_us": "$ts-us-3", "mono_ns": "$mono-ns-3", "start": "$page-identity", "level": "debug", "event": "workbench.console.debug",
              "fields": { "text": "short" } }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
