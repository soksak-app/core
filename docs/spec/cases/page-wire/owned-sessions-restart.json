{
  "name": "owned-sessions-restart",
  "description": "The page reads the owned sessions of its sidecar at its restart, adopts each session whose owner surface is in the restored layout as a session of the plugin that its entry names, also when the owner surface belongs to a plugin without sessions, ends the session whose owner is absent with owner-absent and the session whose plugin is not installed with plugin-absent, shows the adopted session in the restored tab whose params name it, and states the error of the restored tab whose session did not return.",
  "replay": false,
  "reason": "The host side of the owned session messages lands with the host work of F1062-3; the producer runs this case once the host answers the owned session messages.",
  "variables": {
    "owned-cid-1": {"type": "string", "example": "8a1f2c3d-4b5e-4f60-8a7b-9c0d1e2f3a4b", "source": "page"},
    "owned-cid-2": {"type": "string", "example": "8a1f2c3d-4b5e-4f60-8a7b-9c0d1e2f3a4b", "source": "page"},
    "clock-ts-us-1": {
      "type": "integer",
      "example": 1791000000000456
    },
    "clock-mono-ns-1": {
      "type": "integer",
      "example": 5000000789
    },
    "clock-ts-us-2": {
      "type": "integer",
      "example": 1791000000000456
    },
    "clock-mono-ns-2": {
      "type": "integer",
      "example": 5000000789
    },
    "clock-ts-us-3": {
      "type": "integer",
      "example": 1791000000000456
    },
    "clock-mono-ns-3": {
      "type": "integer",
      "example": 5000000789
    },
    "clock-ts-us-4": {
      "type": "integer",
      "example": 1791000000000456
    },
    "clock-mono-ns-4": {
      "type": "integer",
      "example": 5000000789
    },
    "clock-ts-us-5": {
      "type": "integer",
      "example": 1791000000000456
    },
    "clock-mono-ns-5": {
      "type": "integer",
      "example": 5000000789
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000456,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000789,
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000000999,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5000000999,
      "source": "page"
    },
    "page-identity": {
      "type": "string",
      "example": "25c5dd90-4c68-4c05-9a13-093a42d6c132",
      "source": "page"
    },
    "trip-us-1": {
      "type": "integer",
      "example": 0,
      "source": "page"
    },
    "resolution-us-1": {
      "type": "integer",
      "example": 1,
      "source": "page"
    }
  },
  "filter": [
    "notificationState",
    "setTheme",
    "setMenuLanguage"
  ],
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us-1",
          "mono_ns": "$clock-mono-ns-1"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us-2",
          "mono_ns": "$clock-mono-ns-2"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us-3",
          "mono_ns": "$clock-mono-ns-3"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us-4",
          "mono_ns": "$clock-mono-ns-4"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us-5",
          "mono_ns": "$clock-mono-ns-5"
        }
      }
    },
    {
      "call": {
        "name": "sidecarSessions",
        "payload": {
          "sidecar": "@scope/fixture-sidecar"
        }
      }
    },
    {
      "reply": {
        "result": {
          "sessions": [
            {
              "session": "ses-keep",
              "surface": "tab-aaaaa1",
              "root": "/work/project",
              "creation": "c-keep",
              "size": {"width": 640, "height": 384, "scale": 2},
              "plugin": "fixture-session",
              "program": "idle"
            },
            {
              "session": "ses-room",
              "surface": "tab-aaaaa3",
              "root": "/work/project",
              "creation": "c-room",
              "size": {"width": 640, "height": 384, "scale": 2},
              "plugin": "fixture-session",
              "program": null
            },
            {
              "session": "ses-gone",
              "surface": "tab-zzzzzz",
              "root": "/work/project",
              "creation": "c-gone",
              "size": {"width": 640, "height": 384, "scale": 2},
              "plugin": "fixture-session",
              "program": null
            },
            {
              "session": "ses-orphan",
              "surface": "tab-aaaaa1",
              "root": "/work/project",
              "creation": "c-orphan",
              "size": {"width": 640, "height": 384, "scale": 2},
              "plugin": "fixture-removed",
              "program": null
            }
          ]
        }
      }
    },
    {
      "call": {
        "name": "sidecarListen",
        "payload": {"sidecar": "@scope/fixture-sidecar", "id": "tab-aaaaa1", "on": true}
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "sidecarSend",
        "payload": {
          "sidecar": "@scope/fixture-sidecar",
          "surface": "tab-zzzzzz",
          "cids": ["$owned-cid-1"],
          "answer": true,
          "body": {
            "operation": "end",
            "session": "ses-gone"
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "session": "ses-gone",
          "ended": true
        }
      }
    },
    {
      "call": {
        "name": "sidecarListen",
        "payload": {"sidecar": "@scope/fixture-sidecar", "id": "tab-aaaaa3", "on": true}
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "sidecarSend",
        "payload": {
          "sidecar": "@scope/fixture-sidecar",
          "surface": "tab-aaaaa1",
          "cids": ["$owned-cid-2"],
          "answer": true,
          "body": {
            "operation": "end",
            "session": "ses-orphan"
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "session": "ses-orphan",
          "ended": true
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.clock",
              "fields": {
                "trip_us": "$trip-us-1",
                "resolution_us": "$resolution-us-1"
              }
            },
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.session.end",
              "fields": {
                "session": "ses-gone",
                "reason": "owner-absent"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.session.end",
              "fields": {
                "session": "ses-orphan",
                "reason": "plugin-absent"
              }
            },
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "restored tab tab-aaaaa2",
                "text": "session ses-missing is not open"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
