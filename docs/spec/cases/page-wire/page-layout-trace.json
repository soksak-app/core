              "ts_us": "$ts-us-6",
              "mono_ns": "$mono-ns-6",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.trace.layout",
              "fields": {
                "phase": "cancelled",
                "id": 1,
                "t": "$t-5"
              }
