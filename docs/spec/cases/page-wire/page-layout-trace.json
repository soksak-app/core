    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us-5",
          "mono_ns": "$clock-mono-ns-5"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.clock",
              "fields": {
                "trip_us": "$trip-us-1",
                "resolution_us": "$resolution-us-1"
              }
            },
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.trace.layout",
              "fields": {
                "phase": "queued",
                "id": 1,
                "t": "$t-1"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-3",
              "mono_ns": "$mono-ns-3",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.trace.layout",
              "fields": {
                "phase": "prepare",
                "id": 1,
                "t": "$t-2"
              }
            },
            {
              "ts_us": "$ts-us-4",
              "mono_ns": "$mono-ns-4",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.trace.layout",
              "fields": {
                "phase": "prepared",
                "id": 1,
                "t": "$t-3"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-5",
              "mono_ns": "$mono-ns-5",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.trace.layout",
              "fields": {
                "phase": "draw",
                "id": 1,
                "t": "$t-4"
              }
            }
          ]
        }
      }
    },
    {
