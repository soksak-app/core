            {
              "ts_us": "$ts-us-7",
              "mono_ns": "$mono-ns-7",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "workbench",
                "text": "surface presentation failed: diagnostic layout fault"
