    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$clock-ts-us-3",
          "mono_ns": "$clock-mono-ns-3"
        }
