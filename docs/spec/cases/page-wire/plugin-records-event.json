{
  "name": "plugin-records-event",
  "description": "The page stores two events of the plugin probe of the tab tab-1: an info event with the correlation identifier p1.1 and a debug event whose fields are built, and sends them in one log batch after the clock answers of the host.",
  "replay": true,
  "variables": {
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "trip-us": { "type": "integer", "example": 412, "source": "page" },
    "resolution-us": { "type": "integer", "example": 1, "source": "page" },
    "clock-ts-us": { "type": "integer", "example": 1791000000000456, "source": "page" },
    "clock-mono-ns": { "type": "integer", "example": 5000000789, "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000461, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000801, "source": "page" },
    "ts-us-2": { "type": "integer", "example": 1791000000000462, "source": "page" },
    "mono-ns-2": { "type": "integer", "example": 5000000802, "source": "page" },
    "ts-us": { "type": "integer", "example": 1791000000000456 },
    "mono-ns": { "type": "integer", "example": 5000000789 }
  },
  "steps": [
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns", "start": "$page-identity", "level": "info", "event": "workbench.log.clock", "fields": { "trip_us": "$trip-us", "resolution_us": "$resolution-us" } },
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "info", "event": "plugin.probe.started", "fields": { "project": "p1", "surface": "tab-1" }, "cids": ["p1.1"] },
            { "ts_us": "$ts-us-2", "mono_ns": "$mono-ns-2", "start": "$page-identity", "level": "debug", "event": "plugin.probe.built", "fields": { "rows": 2, "surface": "tab-1" } }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
