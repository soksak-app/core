{
  "name": "layout-change-drag",
  "description": "A drag of the divider between the two cards of a group moves the line in three steps and is released; the release runs core.boundary.move with the position where the drag ended, which is the event workbench.layout.change with the layout that it left before its event workbench.command.",
  "replay": false,
  "reason": "The case runs a divider drag of the page workbench, and the Go producer runs no window (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "9f20fb6e-7f94-435d-8c8d-af8e028b35a1",
      "source": "page"
    },
    "params": {
      "type": "string",
      "example": "{\"axis\":\"x\",\"line\":1,\"position\":860}",
      "source": "page"
    },
    "result": {
      "type": "string",
      "example": "{\"position\":860}",
      "source": "page"
    },
    "layout": {
      "type": "string",
      "example": "{\"state\":{},\"groups\":[],\"leader\":null,\"lastCard\":1}",
      "source": "page"
    },
    "micros": {
      "type": "integer",
      "example": 12000,
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000456,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000789,
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000000456,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5000000789,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.layout.change",
              "fields": {
                "command": "core.boundary.move",
                "params": "$params",
                "paramsTruncated": false,
                "result": "$result",
                "layout": "$layout",
                "layoutTruncated": false
              }
            },
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.command",
              "fields": {
                "name": "core.boundary.move",
                "micros": "$micros",
                "ok": true
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
