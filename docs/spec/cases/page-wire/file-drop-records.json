{
  "name": "file-drop-records",
  "description": "The page receives three file drops, two of which fail, and sends the log lines of each drop, the failures among them, in one log batch after the clock answers of the host.",
  "replay": false,
  "reason": "The case delivers the files-dropped notices of the window, and the Go producer runs no window and refuses a notice (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    },
    "trip-us": {
      "type": "integer",
      "example": 412,
      "source": "page"
    },
    "resolution-us": {
      "type": "integer",
      "example": 1,
      "source": "page"
    },
    "parse-error": {
      "type": "string",
      "example": "Unexpected token 'o', \"not json\" is not valid JSON",
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000461,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000801,
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000000462,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5000000802,
      "source": "page"
    },
    "ts-us-3": {
      "type": "integer",
      "example": 1791000000000463,
      "source": "page"
    },
    "mono-ns-3": {
      "type": "integer",
      "example": 5000000803,
      "source": "page"
    },
    "ts-us-4": {
      "type": "integer",
      "example": 1791000000000464,
      "source": "page"
    },
    "mono-ns-4": {
      "type": "integer",
      "example": 5000000804,
      "source": "page"
    },
    "ts-us-5": {
      "type": "integer",
      "example": 1791000000000465,
      "source": "page"
    },
    "mono-ns-5": {
      "type": "integer",
      "example": 5000000805,
      "source": "page"
    },
    "ts-us-6": {
      "type": "integer",
      "example": 1791000000000466,
      "source": "page"
    },
    "mono-ns-6": {
      "type": "integer",
      "example": 5000000806,
      "source": "page"
    },
    "authorization": {
      "type": "string",
      "example": "notDetermined"
    }
  },
  "steps": [
    {
      "call": {
        "name": "notificationState"
      }
    },
    {
      "reply": {
        "result": {
          "authorization": "$authorization",
          "error": null
        }
      }
    },
    {
      "notice": {
        "event": "files-dropped",
        "payload": "not json"
      }
    },
    {
      "notice": {
        "event": "files-dropped",
        "payload": "{\"urls\":[],\"x\":1,\"y\":2}"
      }
    },
    {
      "notice": {
        "event": "files-dropped",
        "payload": "{\"urls\":[\"file:///a.txt\"],\"x\":5,\"y\":6}"
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": 1791000000000456,
          "mono_ns": 5000000789
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": 1791000000000456,
          "mono_ns": 5000000789
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": 1791000000000456,
          "mono_ns": 5000000789
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": 1791000000000456,
          "mono_ns": 5000000789
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": 1791000000000456,
          "mono_ns": 5000000789
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": 1791000000000456,
              "mono_ns": 5000000789,
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.clock",
              "fields": {
                "trip_us": "$trip-us",
                "resolution_us": "$resolution-us"
              }
            },
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.record.info",
              "fields": {
                "where": "drop",
                "text": "received not json"
              }
            },
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "drop",
                "text": "$parse-error"
              }
            },
            {
              "ts_us": "$ts-us-3",
              "mono_ns": "$mono-ns-3",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.record.info",
              "fields": {
                "where": "drop",
                "text": "received {\"urls\":[],\"x\":1,\"y\":2}"
              }
            },
            {
              "ts_us": "$ts-us-4",
              "mono_ns": "$mono-ns-4",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "drop",
                "text": "the application sent an invalid file drop"
              }
            },
            {
              "ts_us": "$ts-us-5",
              "mono_ns": "$mono-ns-5",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.record.info",
              "fields": {
                "where": "drop",
                "text": "received {\"urls\":[\"file:///a.txt\"],\"x\":5,\"y\":6}"
              }
            },
            {
              "ts_us": "$ts-us-6",
              "mono_ns": "$mono-ns-6",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "drop",
                "text": "no surface is under the drop point"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
