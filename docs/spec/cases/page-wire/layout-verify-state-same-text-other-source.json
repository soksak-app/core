{
  "name": "layout-verify-state-same-text-other-source",
  "description": "A failed layout and an error of another source with its text are written as records; the end of the failure sends one wait for the presentation of the window, which the host answers with null.",
  "replay": false,
  "reason": "The wait for the presentation of the window needs a window, and the Go producer runs only the log and workspace calls without a window (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000020022,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5019566748,
      "source": "page"
    },
    "page-identity": {
      "type": "string",
      "example": "c3bd6d48-38cd-4064-8a41-96a538aea257",
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "waitPresented"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.gated",
              "fields": {
                "class": "frame",
                "level": "debug",
                "count": 3
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
