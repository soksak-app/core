        "name": "setTheme",
        "payload": {
          "scheme": "dark",
          "tokens": {}
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "compositionDeclare",
        "payload": {
          "plugin": "probe",
          "composition": {
            "kind": "view",
            "page": "ui/page.html"
          },
          "surface": "mounted-view"
        }
      }
    },
    {
      "reply": {
        "result": null
