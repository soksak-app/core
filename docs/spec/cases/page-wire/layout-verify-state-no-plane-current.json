{
  "name": "layout-verify-state-no-plane-current",
  "description": "A failed layout writes its failure as a workbench error record and sends no wait for the presentation of the window.",
  "replay": true,
  "variables": {
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000027999,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5027543769,
      "source": "page"
    },
    "page-identity": {
      "type": "string",
      "example": "2953926d-1812-4e8c-b3ba-77e9b227a2a2",
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000027999,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5027543769,
      "source": "page"
    },
    "ts-us-3": {
      "type": "integer",
      "example": 1791000000021446,
      "source": "page"
    },
    "mono-ns-3": {
      "type": "integer",
      "example": 5020990539,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "workbench",
                "text": "surface presentation failed: the current image raster did not present within 10s; pending tab-1/view generation 2 raster 1 sequence 0 presented 0/0 surface visible"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-3",
              "mono_ns": "$mono-ns-3",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.gated",
              "fields": {
                "class": "frame",
                "level": "debug",
                "count": 3
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
