{
  "name": "space-rename-session",
  "description": "The page starts at the library, reads the registry with one project of two spaces, opens the project, and writes the layout of the project with the new title of its second space.",
  "replay": false,
  "reason": "The page start sends the theme of the window, and the project open sends the folder, the open and the shown project of the window (windowReady, projectFolder, projectOpen, projectShown), which the Go producer does not run; it runs only log and workspace without a window (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "snapshot": {
      "type": "object",
      "example": {
        "common": { "diagnostics.log": { "lifecycle": "info", "call": "info" } },
        "projects": [
          {
            "id": "prj-one", "root": "/work/one", "identity": "1:1", "title": "one", "color": "#fff", "named": 2, "activeSpaceId": "spc-one",
            "spaces": [
              { "id": "spc-one", "title": "SPACE1", "layout": { "state": { "cards": [], "name": "one" } } },
              { "id": "spc-two", "title": "SPACE2", "layout": { "state": { "cards": [], "name": "two" } } }
            ],
            "settings": {}
          }
        ],
        "open": []
      }
    },
    "clock-ts-us": { "type": "integer", "example": 1791000000000456 },
    "clock-mono-ns": { "type": "integer", "example": 5000000789 },
    "theme": { "type": "object", "example": { "scheme": "dark", "tokens": { "--bg": "#000" } }, "source": "page" },
    "language": { "type": "string", "example": "en", "source": "page" },
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "trip-us": { "type": "integer", "example": 412, "source": "page" },
    "resolution-us": { "type": "integer", "example": 1, "source": "page" },
    "anchor-ts-us": { "type": "integer", "example": 1791000000000456, "source": "page" },
    "anchor-mono-ns": { "type": "integer", "example": 5000000789, "source": "page" },
    "start-ts-us": { "type": "integer", "example": 1791000000000461, "source": "page" },
    "start-mono-ns": { "type": "integer", "example": 5000000801, "source": "page" },
    "started-at": { "type": "number", "example": 1791500000000.5, "source": "page" },
    "open-cid": { "type": "string", "example": "p0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e.1", "source": "page" },
    "open-ts-us": { "type": "integer", "example": 1791000000000470, "source": "page" },
    "open-mono-ns": { "type": "integer", "example": 5000000803, "source": "page" },
    "opened-at": { "type": "integer", "example": 1791000000123, "source": "page" }
  },
  "steps": [
    { "call": { "name": "setTheme", "payload": "$theme" } },
    { "reply": { "result": null } },
    { "call": { "name": "setMenuLanguage", "payload": "$language" } },
    { "reply": { "result": null } },
    { "call": { "name": "workspace", "payload": { "kind": "snapshot" } } },
    { "reply": { "result": "$snapshot" } },
    { "call": { "name": "performance", "payload": { "action": "off" } } },
    { "reply": { "result": null } },
    { "call": { "name": "log", "payload": { "action": "policy", "classes": { "lifecycle": "info", "input": "error", "call": "info", "io": "error", "frame": "error" } } } },
    { "reply": { "result": null } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "batch", "events": [
      { "ts_us": "$anchor-ts-us", "mono_ns": "$anchor-mono-ns", "start": "$page-identity", "level": "info", "event": "workbench.log.clock", "fields": { "trip_us": "$trip-us", "resolution_us": "$resolution-us" } },
      { "ts_us": "$start-ts-us", "mono_ns": "$start-mono-ns", "start": "$page-identity", "level": "info", "event": "workbench.start", "fields": { "started_at": "$started-at", "url": "http://soksak.test/index.html" } }
    ] } } },
    { "reply": { "result": null } },
    { "call": { "name": "workspace", "payload": { "kind": "snapshot" } } },
    { "reply": { "result": "$snapshot" } },
    { "call": { "name": "workspace", "payload": { "kind": "tabState" } } },
    { "reply": { "result": null } },
    { "call": { "name": "workspace", "payload": { "kind": "tabSessions" } } },
    { "reply": { "result": [] } },
    { "call": { "name": "windowReady" } },
    { "reply": { "result": null } },
    { "call": { "name": "projectFolder", "payload": "/work/one" } },
    { "reply": { "result": { "root": "/work/one", "identity": "1:1" } } },
    { "call": { "name": "projectOpen", "payload": { "id": "prj-one", "root": "/work/one", "separate": true, "geometry": null }, "cids": ["$open-cid"] } },
    { "reply": { "result": { "local": true } } },
    { "call": { "name": "log", "payload": { "action": "batch", "events": [
      { "ts_us": "$open-ts-us", "mono_ns": "$open-mono-ns", "start": "$page-identity", "level": "info", "event": "workbench.project.operation", "fields": { "action": "open", "project": "prj-one" }, "cids": ["$open-cid"] }
    ] } } },
    { "reply": { "result": null } },
    { "call": { "name": "workspace", "payload": { "kind": "snapshot" } } },
    { "reply": { "result": "$snapshot" } },
    { "call": { "name": "projectShown", "payload": { "project": { "id": "prj-one", "root": "/work/one", "title": "one" } } } },
    { "reply": { "result": null } },
    { "call": { "name": "workspace", "payload": { "kind": "patch", "id": "prj-one", "patch": { "lastOpened": "$opened-at" } } } },
    { "reply": { "result": true } },
    { "call": { "name": "workspace", "payload": { "kind": "patch", "id": "prj-one", "patch": {
      "spaces": [
        { "id": "spc-one", "title": "SPACE1", "layout": { "state": { "cards": [], "name": "one" } } },
        { "id": "spc-two", "title": "Work", "layout": { "state": { "cards": [], "name": "two" } } }
      ],
      "activeSpaceId": "spc-one",
      "named": 2
    } } } },
    { "reply": { "result": true } }
  ]
}
