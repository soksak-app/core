{
  "name": "page-log-console-unserializable",
  "description": "The page records a console call whose argument is a cycle as a marker with the reason of the serializer, in one log batch.",
  "replay": true,
  "variables": {
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000461, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000801, "source": "page" }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "info", "event": "workbench.console.log",
              "fields": { "text": "state {\"unserializable\":\"Converting circular structure to JSON\"}" } }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
