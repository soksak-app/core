{
  "name": "view-events-settings",
  "description": "The view subscribes to the settings of its plugin; the page applies the theme of the changed settings to the window and pushes the changed settings of the plugin.",
  "replay": false,
  "reason": "The events of a view reach the page as notices of a window that the native host runs, and the Go producer runs no window (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {"page-identity":{"type":"string","example":"0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e","source":"page"}},
  "steps": [
    {"notice":{"event":"view-call","payload":{"surface":"probe-surface","plugin":"probe","generation":1,"id":1,"command":"runtime.settings.on","params":null}}},
    {"call":{"name":"viewReply","payload":{"id":1,"result":null,"page":"$page-identity","generation":1,"surface":"probe-surface"}}},
    {"reply":{"result":null}},
    {"change":{"state":"settings","value":{"home":""}}},
    {"call":{"name":"setTheme","payload":{"scheme":"dark","tokens":{"--bg":"#101117","--card":"#191b24","--fg":"#ececf5","--muted":"#8f92a4","--edge":"#2b2e3d","--rule":"#22242f","--rail":"#7279ff","--focus":"#ffb36b","--no":"#ff7c7c", "--fail": "#ff7cd3", "--ok": "#4cc38a", "--warn": "#f0a33a","--r":"10px","--half-gap":"6px","--bw":"1px","--font":"ui-monospace,SFMono-Regular,Menlo,monospace","--size":"13px"}}}},
    {"reply":{"result":null}},
    {"call":{"name":"viewEvent","payload":{"generation":1,"event":"settings","data":{"home":""},"surface":"probe-surface"}}},
    {"reply":{"result":true}},
    {"call":{"name":"setMenuLanguage","payload":"en"}},
    {"reply":{"result":null}}
  ]
}
