{
  "name": "exposure-reply-held-reply",
  "description": "The page answers a command request of a surface into a diagnostic hold, sends the event of the command in a log batch before the reload, and sends the held reply when the holds end.",
  "replay": false,
  "reason": "The case delivers an exposure-request notice of the host, and the Go producer runs no window and refuses a notice (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "page-identity": { "type": "string", "example": "5a0c9e7b-1f2d-4c3e-8b4a-6d7e8f901234", "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000495, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000835, "source": "page" },
    "micros-1": { "type": "integer", "example": 19, "source": "page" }
  },
  "steps": [
    { "notice": { "event": "exposure-request", "payload": { "id": 41, "surface": "fixture-held", "method": "command.run", "params": { "name": "core.fixture.held", "params": {} } } } },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "debug", "event": "workbench.command", "fields": { "name": "core.fixture.held", "micros": "$micros-1", "ok": true } }
          ]
        }
      }
    },
    { "reply": { "result": null } },
    { "call": { "name": "exposureReply", "payload": { "id": 41, "result": "held" } } },
    { "reply": { "result": null } }
  ]
}
