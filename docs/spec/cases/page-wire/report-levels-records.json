{
  "name": "report-levels-records",
  "description": "The page reports one failure and then one observation: the first log batch carries the clock of the page and the error record, and the second batch carries the info record, each after the clock answers of the host.",
  "replay": true,
  "variables": {
    "ts-us": {
      "type": "integer",
      "example": 1791000000000456
    },
    "mono-ns": {
      "type": "integer",
      "example": 5000000789
    },
    "page-identity": {
      "type": "string",
      "example": "5a0c9e7b-1f2d-4c3e-8b4a-6d7e8f901234",
      "source": "page"
    },
    "trip-us": {
      "type": "integer",
      "example": 412,
      "source": "page"
    },
    "resolution-us": {
      "type": "integer",
      "example": 1,
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000461,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000801,
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000000462,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5000000802,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "clock"
        }
      }
    },
    {
      "reply": {
        "result": {
          "ts_us": "$ts-us",
          "mono_ns": "$mono-ns"
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": 1791000000000456,
              "mono_ns": 5000000789,
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.clock",
              "fields": {
                "trip_us": "$trip-us",
                "resolution_us": "$resolution-us"
              }
            },
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "surface probe mount failed",
                "text": "x"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.record.info",
              "fields": {
                "where": "workbench",
                "text": "focus moved to probe"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
