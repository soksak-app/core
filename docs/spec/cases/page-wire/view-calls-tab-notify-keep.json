    "ts-us-1": {
      "type": "integer",
      "example": 1791000000618441,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5617985997,
      "source": "page"
    },
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    }
  },
