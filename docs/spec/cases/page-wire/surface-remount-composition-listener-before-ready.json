{
  "name": "surface-remount-composition-listener-before-ready",
  "description": "A view whose registration of the listener view-process-ended is refused before its composition is declared sends no composition declaration, and the failed mount is recorded in one batch.",
  "replay": false,
  "reason": "The registration of a listener belongs to a page, which the Go producer does not have (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "identity": {
      "type": "string",
      "example": "3f2c9a6e-0b1d-4c7e-9a52-6d1e8b4f0a21",
      "source": "page"
    },
    "event-1-ts-us": {
      "type": "integer",
      "example": 1791000000000790,
      "source": "page"
    },
    "event-1-mono-ns": {
      "type": "integer",
      "example": 5000001000,
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000147326,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5146870226,
      "source": "page"
    },
    "page-identity": {
      "type": "string",
      "example": "9b8ae03e-c3cf-4a76-8a41-bcb85b1932c7",
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000147382,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5146926560,
      "source": "page"
    },
    "ts-us-3": {
      "type": "integer",
      "example": 1791000000147576,
      "source": "page"
    },
    "mono-ns-3": {
      "type": "integer",
      "example": 5147120435,
      "source": "page"
    },
    "time-origin": {
      "type": "number",
      "example": 1794617107328.546,
      "source": "page"
    }
  },
  "steps": [
    {
      "listen": {
        "event": "view-call"
      }
    },
    {
      "listen": {
        "event": "view-process-ended",
        "error": "view-process-ended registration failed before ready"
      }
    },
    {
      "listen": {
        "event": "view-reply"
      }
    },
    {
      "listen": {
        "event": "view-stopped"
      }
    },
    {
      "listen": {
        "event": "view-responsiveness"
      }
    },
    {
      "listen": {
        "event": "view-presentation-abandoned"
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.surface.mount.failed",
              "fields": {
                "plugin": "fixture-view-listener-after-ready",
                "surface": "fixture-view-listener-after-ready",
                "attempt": 1,
                "phase": "mount",
                "reason": "view-process-ended registration failed before ready"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
