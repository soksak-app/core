    "remove-cid": {
      "type": "string",
      "example": "p5a0c9e7b-1f2d-4c3e-8b4a-6d7e8f901234.1",
      "source": "page"
    },
    "page-identity": {
      "type": "string",
      "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e",
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000470,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000810,
      "source": "page"
    },
    "folder-identity": {
      "type": "string",
      "example": "id"
    },
    "notice-at": {
      "type": "string",
      "example": "2026-11-27T17:22:45.921+09:00",
      "source": "page"
    },
    "notices-size": {
      "type": "integer",
      "example": 212
    },
    "clock-ts-us-1": {
      "type": "integer",
      "example": 1791000000000100
    },
    "clock-mono-ns-1": {
      "type": "integer",
      "example": 5000000100
