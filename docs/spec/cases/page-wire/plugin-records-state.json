{
  "name": "plugin-records-state",
  "description": "A state module of the plugin probe stores one info event without a surface, and the page sends it in one log batch without a clock answer, because the page already anchored its clock.",
  "replay": true,
  "variables": {
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000461, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000801, "source": "page" }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "info", "event": "plugin.probe.started", "fields": { "project": "p1" } }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
