{
  "name": "shown-errors-record",
  "description": "The page shows an error at a place and writes it to the log when it is shown: a repeated error at the same place is written once, and an error written again after its place was cleared; the clock anchor and the records are sent in one log batch after five clock answers of the host.",
  "replay": true,
  "variables": {
    "clock-ts-us": { "type": "integer", "example": 1791000000000456 },
    "clock-mono-ns": { "type": "integer", "example": 5000000789 },
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "trip-us": { "type": "integer", "example": 412, "source": "page" },
    "resolution-us": { "type": "integer", "example": 1, "source": "page" },
    "anchor-ts-us": { "type": "integer", "example": 1791000000000456, "source": "page" },
    "anchor-mono-ns": { "type": "integer", "example": 5000000789, "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000461, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000801, "source": "page" },
    "ts-us-2": { "type": "integer", "example": 1791000000000462, "source": "page" },
    "mono-ns-2": { "type": "integer", "example": 5000000802, "source": "page" },
    "ts-us-3": { "type": "integer", "example": 1791000000000463, "source": "page" },
    "mono-ns-3": { "type": "integer", "example": 5000000803, "source": "page" }
  },
  "steps": [
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns" } } },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$anchor-ts-us",
              "mono_ns": "$anchor-mono-ns",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.clock",
              "fields": { "trip_us": "$trip-us", "resolution_us": "$resolution-us" }
            },
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": { "where": "library", "text": "folder is missing" }
            },
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": { "where": "library", "text": "registry failed" }
            },
            {
              "ts_us": "$ts-us-3",
              "mono_ns": "$mono-ns-3",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": { "where": "library", "text": "registry failed" }
            }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
