{
  "name": "layout-verify-state-banner-withdrawn",
  "description": "A failed layout writes its failure, and the presented layout after it and the end of the failure send two waits for the presentation of the window, which the host answers with null.",
  "replay": false,
  "reason": "The wait for the presentation of the window needs a window, and the Go producer runs only the log and workspace calls without a window (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000012430,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5011974873,
      "source": "page"
    },
    "page-identity": {
      "type": "string",
      "example": "dd215cd7-eca0-40a8-90c7-ba9c837ea3cf",
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000012430,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5011974873,
      "source": "page"
    },
    "ts-us-3": {
      "type": "integer",
      "example": 1791000000012430,
      "source": "page"
    },
    "mono-ns-3": {
      "type": "integer",
      "example": 5011974873,
      "source": "page"
    },
    "ts-us-4": {
      "type": "integer",
      "example": 1791000000012430,
      "source": "page"
    },
    "mono-ns-4": {
      "type": "integer",
      "example": 5011974873,
      "source": "page"
    },
    "ts-us-5": {
      "type": "integer",
      "example": 1791000000007799,
      "source": "page"
    },
    "mono-ns-5": {
      "type": "integer",
      "example": 5007344144,
      "source": "page"
    }
  },
  "steps": [
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-4",
              "mono_ns": "$mono-ns-4",
              "start": "$page-identity",
              "level": "error",
              "event": "workbench.record.error",
              "fields": {
                "where": "workbench",
                "text": "surface presentation failed: the current image raster did not present within 10s; pending tab-1/view generation 2 raster 1 sequence 0 presented 0/0 surface visible"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "waitPresented"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "waitPresented"
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-5",
              "mono_ns": "$mono-ns-5",
              "start": "$page-identity",
              "level": "info",
              "event": "workbench.log.gated",
              "fields": {
                "class": "frame",
                "level": "debug",
                "count": 10
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
