{
  "name": "view-events-status-surface",
  "description": "The view watches a status on a section surface and on a tab surface, the page forwards each watch to its surface, a second watch of the same name and surface replies null without a forward, pushes the value of each, forwards the unwatch of the section surface, and forwards the unwatch of the tab surface when the view closes.",
  "replay": false,
  "reason": "The events of a view reach the page as notices of a window that the native host runs, and the Go producer runs no window (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {"page-identity":{"type":"string","example":"0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e","source":"page"}},
  "steps": [
    {"notice":{"event":"view-call","payload":{"surface":"probe-surface","plugin":"probe","generation":1,"id":1,"command":"runtime.status.watch","params":{"name":"probe.lines","surface":"spc-aaaaaa/left/files.tree"}}}},
    {"call":{"name":"exposureForward","payload":{"id":1,"surface":"spc-aaaaaa/left/files.tree","method":"status.watch","params":{"name":"probe.lines"}}}},
    {"reply":{"result":{"result":null}}},
    {"call":{"name":"viewReply","payload":{"id":1,"result":null,"page":"$page-identity","generation":1,"surface":"probe-surface"}}},
    {"reply":{"result":null}},
    {"notice":{"event":"view-call","payload":{"surface":"probe-surface","plugin":"probe","generation":1,"id":2,"command":"runtime.status.watch","params":{"name":"probe.lines","surface":"tab-a"}}}},
    {"call":{"name":"exposureForward","payload":{"id":2,"surface":"tab-a","method":"status.watch","params":{"name":"probe.lines"}}}},
    {"reply":{"result":{"result":null}}},
    {"call":{"name":"viewReply","payload":{"id":2,"result":null,"page":"$page-identity","generation":1,"surface":"probe-surface"}}},
    {"reply":{"result":null}},
    {"notice":{"event":"view-call","payload":{"surface":"probe-surface","plugin":"probe","generation":1,"id":3,"command":"runtime.status.watch","params":{"name":"probe.lines","surface":"tab-a"}}}},
    {"call":{"name":"viewReply","payload":{"id":3,"result":null,"page":"$page-identity","generation":1,"surface":"probe-surface"}}},
    {"reply":{"result":null}},
    {"change":{"state":"status","name":"probe.lines","surface":"spc-aaaaaa/left/files.tree","value":["section"]}},
    {"call":{"name":"viewEvent","payload":{"generation":1,"event":"status","data":{"name":"probe.lines","surface":"spc-aaaaaa/left/files.tree","value":["section"]},"surface":"probe-surface"}}},
    {"reply":{"result":true}},
    {"change":{"state":"status","name":"probe.lines","surface":"tab-a","value":["tab"]}},
    {"call":{"name":"viewEvent","payload":{"generation":1,"event":"status","data":{"name":"probe.lines","surface":"tab-a","value":["tab"]},"surface":"probe-surface"}}},
    {"reply":{"result":true}},
    {"notice":{"event":"view-call","payload":{"surface":"probe-surface","plugin":"probe","generation":1,"id":4,"command":"runtime.status.unwatch","params":{"name":"probe.lines","surface":"spc-aaaaaa/left/files.tree"}}}},
    {"call":{"name":"exposureForward","payload":{"id":3,"surface":"spc-aaaaaa/left/files.tree","method":"status.unwatch","params":{"name":"probe.lines"}}}},
    {"reply":{"result":{"result":null}}},
    {"call":{"name":"viewReply","payload":{"id":4,"result":null,"page":"$page-identity","generation":1,"surface":"probe-surface"}}},
    {"reply":{"result":null}},
    {"close":{}},
    {"call":{"name":"exposureForward","payload":{"id":4,"surface":"tab-a","method":"status.unwatch","params":{"name":"probe.lines"}}}},
    {"reply":{"result":{"result":null}}}
  ]
}
