{
  "name": "surface-view-tab-state-open",
  "description": "A view of a surface with surface.unload sends three calls while the page opens the tab state store: the host holds the tab state read, and after it answers, the page answers the calls of the view in order, declares the composition of the view, and writes the title and the state that the view sent.",
  "replay": false,
  "reason": "The view calls reach the page as the notice view-call of a view that the host runs in a window, which the Go producer does not run (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "bytes": { "type": "integer", "example": 62 }
  },
  "steps": [
    { "call": { "name": "workspace", "payload": { "kind": "snapshot" } } },
    { "reply": { "result": { "common": {}, "projects": [], "open": [] } } },
    { "call": { "name": "workspace", "payload": { "kind": "tabState" } } },
    { "reply": { "result": null, "held": true } },
    { "notice": { "event": "view-call", "payload": { "surface": "fixture-tab-state-view-surface", "plugin": "fixture-tab-state-view", "generation": 1, "id": 1, "command": "tab.state.read", "params": null } } },
    { "notice": { "event": "view-call", "payload": { "surface": "fixture-tab-state-view-surface", "plugin": "fixture-tab-state-view", "generation": 1, "id": 2, "command": "tab.title", "params": "Early" } } },
    { "notice": { "event": "view-call", "payload": { "surface": "fixture-tab-state-view-surface", "plugin": "fixture-tab-state-view", "generation": 1, "id": 3, "command": "tab.state.write", "params": { "page": 4 } } } },
    { "call": { "name": "workspace", "payload": { "kind": "tabSessions" } } },
    { "reply": { "result": [] } },
    { "call": { "name": "compositionDeclare", "payload": { "plugin": "fixture-tab-state-view", "composition": { "kind": "view", "page": "ui/page.html" }, "surface": "fixture-tab-state-view-surface" } } },
    { "reply": { "result": null } },
    { "call": { "name": "viewReply", "payload": { "id": 1, "result": null, "page": "$page-identity", "generation": 1, "surface": "fixture-tab-state-view-surface" } } },
    { "reply": { "result": null } },
    { "call": { "name": "viewReply", "payload": { "id": 2, "result": null, "page": "$page-identity", "generation": 1, "surface": "fixture-tab-state-view-surface" } } },
    { "reply": { "result": null } },
    { "call": { "name": "viewReply", "payload": { "id": 3, "result": null, "page": "$page-identity", "generation": 1, "surface": "fixture-tab-state-view-surface" } } },
    { "reply": { "result": null } },
    { "call": { "name": "windowReady" } },
    { "reply": { "result": null } },
    { "call": { "name": "workspace", "payload": { "kind": "tabStatePut", "tab": "fixture-tab-state-view-surface", "entry": { "label": "Early", "state": { "format": 2, "value": { "page": 4 } } } } } },
    { "reply": { "result": "$bytes" } }
  ]
}
