{
  "name": "exposure-reply-command-events",
  "description": "The page answers two command requests, one that succeeds and one that fails. The event of the failed command leaves in a batch of its own before the replies, and the event of the succeeded command follows the replies in the next batch.",
  "replay": false,
  "reason": "The case delivers the exposure-request notices of the host, and the Go producer runs no window and refuses a notice (docs/spec/cases/page-wire/README.md#producer-runs).",
  "variables": {
    "page-identity": {
      "type": "string",
      "example": "5a0c9e7b-1f2d-4c3e-8b4a-6d7e8f901234",
      "source": "page"
    },
    "ts-us-1": {
      "type": "integer",
      "example": 1791000000000480,
      "source": "page"
    },
    "mono-ns-1": {
      "type": "integer",
      "example": 5000000820,
      "source": "page"
    },
    "micros-1": {
      "type": "integer",
      "example": 31,
      "source": "page"
    },
    "ts-us-2": {
      "type": "integer",
      "example": 1791000000000481,
      "source": "page"
    },
    "mono-ns-2": {
      "type": "integer",
      "example": 5000000821,
      "source": "page"
    },
    "micros-2": {
      "type": "integer",
      "example": 44,
      "source": "page"
    }
  },
  "steps": [
    {
      "notice": {
        "event": "exposure-request",
        "payload": {
          "id": 21,
          "method": "command.run",
          "params": {
            "name": "core.fixture.fine",
            "params": {}
          }
        }
      }
    },
    {
      "notice": {
        "event": "exposure-request",
        "payload": {
          "id": 22,
          "method": "command.run",
          "params": {
            "name": "core.fixture.broken",
            "params": {}
          }
        }
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-2",
              "mono_ns": "$mono-ns-2",
              "start": "$page-identity",
              "level": "warn",
              "event": "workbench.command",
              "fields": {
                "name": "core.fixture.broken",
                "micros": "$micros-2",
                "ok": false,
                "error": "-32000: broken on purpose"
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "exposureReply",
        "payload": {
          "id": 22,
          "error": {
            "code": -32000,
            "message": "broken on purpose"
          }
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "exposureReply",
        "payload": {
          "id": 21,
          "result": null
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            {
              "ts_us": "$ts-us-1",
              "mono_ns": "$mono-ns-1",
              "start": "$page-identity",
              "level": "debug",
              "event": "workbench.command",
              "fields": {
                "name": "core.fixture.fine",
                "micros": "$micros-1",
                "ok": true
              }
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": null
      }
    }
  ]
}
