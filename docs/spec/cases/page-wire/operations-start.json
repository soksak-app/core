{
  "name": "operations-start",
  "description": "The page relays the first two events of two plugin operations, the clock anchor of its first batch and the operation identifiers of each event, after five clock answers of the host.",
  "replay": true,
  "variables": {
    "ts-us": { "type": "integer", "example": 1791000000000456 },
    "mono-ns": { "type": "integer", "example": 5000000789 },
    "page-identity": { "type": "string", "example": "0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e", "source": "page" },
    "trip-us": { "type": "integer", "example": 38, "source": "page" },
    "resolution-us": { "type": "integer", "example": 1, "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000470, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000803, "source": "page" },
    "ts-us-2": { "type": "integer", "example": 1791000000000471, "source": "page" },
    "mono-ns-2": { "type": "integer", "example": 5000000804, "source": "page" },
    "ts-us-3": { "type": "integer", "example": 1791000000000472, "source": "page" },
    "mono-ns-3": { "type": "integer", "example": 5000000805, "source": "page" },
    "cid-1": { "type": "string", "example": "p0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e.1", "source": "page" },
    "cid-2": { "type": "string", "example": "p0b6e1f5c-3d2a-4b7e-9c1d-2f4a6b8c0d1e.2", "source": "page" }
  },
  "steps": [
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "info", "event": "workbench.log.clock", "fields": { "trip_us": "$trip-us", "resolution_us": "$resolution-us" } },
            { "ts_us": "$ts-us-2", "mono_ns": "$mono-ns-2", "start": "$page-identity", "level": "info", "event": "workbench.plugin.operation", "fields": { "action": "install", "plugin": "tty" }, "cids": ["$cid-1"] },
            { "ts_us": "$ts-us-3", "mono_ns": "$mono-ns-3", "start": "$page-identity", "level": "info", "event": "workbench.plugin.operation", "fields": { "action": "remove", "plugin": "tty" }, "cids": ["$cid-2"] }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
