{
  "name": "modal-answer-trace-answer",
  "description": "The page turns the performance trace on, opens the menu modal, and receives the answer core.modal.dismiss of the modal; the page writes the answer as the trace event workbench.trace.modal.answer in one log batch after the clock answers of the host.",
  "replay": false,
  "reason": "The case opens a native modal view and delivers its answer notice, and only the native host with a window produces them (the native tier of docs/operations/examples.md#test-kinds).",
  "variables": {
    "page-identity": { "type": "string", "example": "5a0c9e7b-1f2d-4c3e-8b4a-6d7e8f901234", "source": "page" },
    "trip-us": { "type": "integer", "example": 412, "source": "page" },
    "resolution-us": { "type": "integer", "example": 1, "source": "page" },
    "clock-ts-us": { "type": "integer", "example": 1791000000000456, "source": "page" },
    "clock-mono-ns": { "type": "integer", "example": 5000000789, "source": "page" },
    "ts-us-1": { "type": "integer", "example": 1791000000000461, "source": "page" },
    "mono-ns-1": { "type": "integer", "example": 5000000801, "source": "page" },
    "ts-us": { "type": "integer", "example": 1791000000000456 },
    "mono-ns": { "type": "integer", "example": 5000000789 }
  },
  "steps": [
    { "call": { "name": "performance", "payload": { "action": "on" } } },
    { "reply": { "result": null } },
    { "call": { "name": "overlayShow", "payload": { "id": "menu", "title": "Menu", "rect": { "x": 0, "y": 0, "w": 10, "h": 10 }, "mode": "menu", "card": { "x": 0, "y": 0, "w": 0, "h": 0 }, "className": "", "html": "", "css": "", "border": "rgb(7, 8, 9)", "radius": 4 } } },
    { "reply": { "result": { "x": 0, "y": 0, "w": 10, "h": 10 } } },
    { "notice": { "event": "overlay-pick", "payload": { "id": "menu", "key": "core.modal.dismiss", "value": "" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    { "call": { "name": "log", "payload": { "action": "clock" } } },
    { "reply": { "result": { "ts_us": "$ts-us", "mono_ns": "$mono-ns" } } },
    {
      "call": {
        "name": "log",
        "payload": {
          "action": "batch",
          "events": [
            { "ts_us": "$clock-ts-us", "mono_ns": "$clock-mono-ns", "start": "$page-identity", "level": "info", "event": "workbench.log.clock", "fields": { "trip_us": "$trip-us", "resolution_us": "$resolution-us" } },
            { "ts_us": "$ts-us-1", "mono_ns": "$mono-ns-1", "start": "$page-identity", "level": "debug", "event": "workbench.trace.modal.answer", "fields": { "key": "core.modal.dismiss" } }
          ]
        }
      }
    },
    { "reply": { "result": null } }
  ]
}
