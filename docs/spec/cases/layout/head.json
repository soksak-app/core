{
"description":"The fold stage of a card head: from the measured widths of the head, its padding, its leading button, the gap between its elements, its tools, its ⋯ button, its tabs and the gap between them, the width of the active tab (0 without one) and the chrome metrics tab-peek-w (peek) and tab-min-w (minTab), the stage of the tabs (strip: every tab, one: the active tab, ham: no tab) and of the tools (bar or the ⋯ menu) (docs/spec/example-model.md#card-tabs).",
"cases":[
 {"name":"every tab fits beside the tools","head":{"width":400,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[60,60,60],"activeWidth":60},"returns":{"fit":"strip","tools":"bar"}},
 {"name":"the strip stays while the active tab and the peek fit beside the tools","head":{"width":400,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[100,100,100,100],"activeWidth":100},"returns":{"fit":"strip","tools":"bar"}},
 {"name":"the strip stays when the active tab and the peek fill the room exactly","head":{"width":400,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[216,100],"activeWidth":216},"returns":{"fit":"strip","tools":"bar"}},
 {"name":"only the active tab shows when the peek no longer fits","head":{"width":400,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[217,100],"activeWidth":217},"returns":{"fit":"one","tools":"bar"}},
 {"name":"the active tab keeps the tools while it fits beside them exactly","head":{"width":400,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[272,50],"activeWidth":272},"returns":{"fit":"one","tools":"bar"}},
 {"name":"the tools fold into the menu when the active tab does not fit beside them","head":{"width":400,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[273,50],"activeWidth":273},"returns":{"fit":"one","tools":"menu"}},
 {"name":"the active tab stays at the minimum tab width beside the menu","head":{"width":120,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[100,100],"activeWidth":100},"returns":{"fit":"one","tools":"menu"}},
 {"name":"the tabs fold under the minimum tab width","head":{"width":119,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[100,100],"activeWidth":100},"returns":{"fit":"ham","tools":"menu"}},
 {"name":"an active tab narrower than the minimum stays while it fits beside the menu","head":{"width":102,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[30,100],"activeWidth":30},"returns":{"fit":"one","tools":"menu"}},
 {"name":"an active tab narrower than the minimum folds when it does not fit beside the menu","head":{"width":101,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[30,100],"activeWidth":30},"returns":{"fit":"ham","tools":"menu"}},
 {"name":"without an active tab the strip needs the peek beside the tools","head":{"width":400,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[60,60],"activeWidth":0},"returns":{"fit":"strip","tools":"bar"}},
 {"name":"without an active tab a narrow head keeps the menu","head":{"width":120,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[60,60],"activeWidth":0},"returns":{"fit":"one","tools":"menu"}},
 {"name":"a head without tabs keeps the strip","head":{"width":400,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[],"activeWidth":0},"returns":{"fit":"strip","tools":"bar"}},
 {"name":"a head narrower than its buttons folds everything","head":{"width":40,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":48,"tabWidths":[60],"activeWidth":60},"returns":{"fit":"ham","tools":"menu"}},
 {"name":"fractional widths compare without rounding","head":{"width":233.75,"paddingLeft":7.5,"paddingRight":7.5,"lead":22.25,"gap":6,"toolsWidth":96.75,"moreWidth":24,"tabGap":3.5,"peek":56,"minTab":48,"tabWidths":[70.5,63.25],"activeWidth":63.25},"returns":{"fit":"one","tools":"bar"}},
 {"name":"a wider peek folds the strip earlier","head":{"width":400,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":80,"minTab":48,"tabWidths":[200,200],"activeWidth":200},"returns":{"fit":"one","tools":"bar"}},
 {"name":"a wider minimum tab width folds the tabs earlier","head":{"width":120,"paddingLeft":8,"paddingRight":8,"lead":24,"gap":4,"toolsWidth":80,"moreWidth":24,"tabGap":2,"peek":56,"minTab":50,"tabWidths":[100,100],"activeWidth":100},"returns":{"fit":"ham","tools":"menu"}}
]
