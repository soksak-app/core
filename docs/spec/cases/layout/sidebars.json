  {"call":"setSidebar","args":["left","off"]},
  {"call":"effectiveSidebar","args":["left",{"size":190,"min":120,"max":480},{"id":"first"}],"returns":null},
  {"call":"setSidebar","args":["left","inherit"]},
  {"call":"card","returns":{"sidebars":{"left":{}}}},
  {"call":"effectiveSidebar","args":["left",{"size":190,"min":120,"max":480},{"id":"first"}],"returns":{"set":"first","size":190,"collapsed":false}}
 ]},
