 {"name":"column of two cards","layout":{"root":{"cut":"y","kids":[{"share":0.25,"node":{"card":"a"}},{"share":0.75,"node":{"card":"b"}}]}},"root":{"direction":"column","size":1,"children":[{"card":"a","size":0.25},{"card":"b","size":0.75}]}},
 {"name":"grid whose two lines cross the whole window is a row of two columns","layout":{"root":{"cut":"x","kids":[{"share":0.5,"node":{"cut":"y","kids":[{"share":0.5,"node":{"card":"a"}},{"share":0.5,"node":{"card":"c"}}]}},{"share":0.5,"node":{"cut":"y","kids":[{"share":0.5,"node":{"card":"b"}},{"share":0.5,"node":{"card":"d"}}]}}]}},"root":{"direction":"row","size":1,"children":[{"direction":"column","size":0.5,"children":[{"card":"a","size":0.5},{"card":"c","size":0.5}]},{"direction":"column","size":0.5,"children":[{"card":"b","size":0.5},{"card":"d","size":0.5}]}]}},
 {"name":"grid of three columns whose lines all cross the whole window","layout":{"root":{"cut":"x","kids":[{"share":0.25,"node":{"card":"a"}},{"share":0.25,"node":{"card":"b"}},{"share":0.5,"node":{"card":"c"}}]}},"root":{"direction":"row","size":1,"children":[{"card":"a","size":0.25},{"card":"b","size":0.25},{"card":"c","size":0.5}]}},
 {"name":"nested splits of alternating directions","layout":{"root":{"cut":"x","kids":[{"share":0.4,"node":{"card":"a"}},{"share":0.6,"node":{"cut":"y","kids":[{"share":0.6,"node":{"card":"b"}},{"share":0.4,"node":{"cut":"x","kids":[{"share":0.4999999999999999,"node":{"card":"c"}},{"share":0.5000000000000001,"node":{"card":"d"}}]}}]}}]}},"root":{"direction":"row","size":1,"children":[{"card":"a","size":0.4},{"direction":"column","size":0.6,"children":[{"card":"b","size":0.6},{"direction":"row","size":0.4,"children":[{"card":"c","size":0.5},{"card":"d","size":0.5}]}]}]}},
 {"name":"nested column whose top holds a row","layout":{"root":{"cut":"y","kids":[{"share":0.5,"node":{"cut":"x","kids":[{"share":0.5,"node":{"card":"a"}},{"share":0.5,"node":{"card":"b"}}]}},{"share":0.5,"node":{"card":"c"}}]}},"root":{"direction":"column","size":1,"children":[{"direction":"row","size":0.5,"children":[{"card":"a","size":0.5},{"card":"b","size":0.5}]},{"card":"c","size":0.5}]}}
