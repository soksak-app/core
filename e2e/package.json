{
  "name": "@soksak/e2e",
  "version": "0.0.21",
  "private": true,
  "description": "Window checks for running Wails and Tauri applications.",
  "type": "module",
  "scripts": {
    "verify": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs './*.test.mjs'",
    "verify:activation": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs 'activation/*.test.mjs'",
    "verify:person": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs 'person/*.test.mjs'",
    "verify:real": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs 'real/*.test.mjs'",
    "repeat": "soksak-window-repeat --setup ./setup.mjs",
    "test": "node --test test/*.test.mjs activation/terminal-ime-document.test.mjs",
    "verify:terminal-sidebar-current": "node ./run.mjs --test --test-global-setup=./setup.mjs observation/terminal-sidebar-current.test.mjs",
    "verify:shutdown": "node normal-shutdown.mjs",
    "verify:terminal-focus-current": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs observation/terminal-focus-current.test.mjs",
    "benchmark:view-drag": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs benchmark/view-drag.test.mjs"
  },
  "dependencies": {
    "@soksak/client": "workspace:*",
    "@soksak/window-check": "workspace:*"
  }
}
