{
  "name": "@soksak/e2e",
  "version": "0.0.40",
  "private": true,
  "description": "Window checks for running Wails and Tauri applications.",
  "type": "module",
  "scripts": {
    "test-app": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs './*.test.mjs'",
    "test-app:capture-input-close": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs '--test-name-pattern=consecutive captures preserve finalized recordings|an image region draws its frame after the window is resized from outside|a click gives native focus to the clicked image region and its card|save replies that retain modified state keep the native tab open' capture-lifecycle.test.mjs view-surfaces.test.mjs save-close.test.mjs",
    "test-app:activation": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs 'activation/*.test.mjs'",
    "repeat": "sok-repeat --setup ./setup.mjs",
    "test": "node --test test/",
    "test-app:section-design": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs observation/section-design.test.mjs",
    "test-app:card-sidebar-current": "node ./run.mjs --test --test-global-setup=./setup.mjs observation/card-sidebar-current.test.mjs",
    "test-app:shutdown": "node normal-shutdown.mjs",
    "test-app:view-focus-current": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs observation/view-focus-current.test.mjs",
    "benchmark:view-drag": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs benchmark/view-drag.test.mjs",
    "benchmark:resize-catch-up": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs benchmark/resize-catch-up.test.mjs",
    "benchmark:idle-tab": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs benchmark/idle-tab.test.mjs",
    "benchmark:split-load": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs benchmark/split-load.test.mjs",
    "benchmark:plain-view": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs benchmark/plain-view.test.mjs",
    "benchmark:input-latency": "node ./run.mjs --test --test-concurrency=1 --test-global-setup=./setup.mjs input-latency.test.mjs"
  },
  "specFiles": [
    "docs/spec/events.json",
    "docs/spec/host-contract.md",
    "docs/spec/performance-goals.json"
  ],
  "dependencies": {
    "@soksak/client": "workspace:*",
    "@soksak/plugin-api": "workspace:*",
    "@soksak/window-check": "workspace:*",
    "@soksak/workbench": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}
