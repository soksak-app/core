{
  "name": "@soksak/e2e",
  "version": "0.0.1",
  "private": true,
  "description": "Window checks for running Wails and Tauri applications.",
  "type": "module",
  "scripts": {
    "verify": "node --test --test-concurrency=1 './*.test.mjs'",
    "verify:activation": "node --test --test-concurrency=1 'activation/*.test.mjs'",
    "repeat": "node repeat.mjs"
  },
  "dependencies": {
    "@soksak/client": "workspace:*"
  }
}
