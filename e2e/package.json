{
  "name": "@soksak/e2e",
  "version": "0.0.2",
  "private": true,
  "description": "Window checks for running Wails and Tauri applications.",
  "type": "module",
  "scripts": {
    "verify": "node --test --test-concurrency=1 './*.test.mjs'",
    "verify:activation": "node --test --test-concurrency=1 'activation/*.test.mjs'",
    "verify:real": "node --test --test-concurrency=1 'real/*.test.mjs'",
    "repeat": "node repeat.mjs",
    "test": "node --test test/*.test.mjs",
    "verify:terminal-sidebar-current": "node --test observation/terminal-sidebar-current.test.mjs"
  },
  "dependencies": {
    "@soksak/client": "workspace:*"
  }
}
