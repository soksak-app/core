#!/bin/sh
# Checks the commit messages that a push publishes before the push leaves this checkout; CI runs every other check. `make hooks` sets this folder as the git hook folder.
# git passes the remote name as the first argument and one line per pushed ref on stdin; RANGE holds the commits of those refs.
root=$(git rev-parse --show-toplevel) || exit 1
ranges=$(node "$root/scripts/push-range.mjs" "$1") || exit 1
exec make -C "$(git rev-parse --show-toplevel)" push-check RANGE="$ranges"
