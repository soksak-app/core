#!/bin/sh
# Checks the commit messages that a push publishes before the push leaves this checkout; CI runs every other check. `make install-hooks` sets this folder as the git hook folder.
# git passes the remote name as the first argument and one line per pushed ref on stdin; RANGE holds the commits of those refs.
root=$(git rev-parse --show-toplevel) || exit 1
# pnpm takes a node_modules that is a symbolic link into another checkout for the install of that checkout and removes it for the
# install of this one, so the hook refuses that form before it runs pnpm (#F918).
if [ -L "$root/node_modules" ]; then
  echo "$root/node_modules is a symbolic link to $(readlink "$root/node_modules"); this checkout needs its own install: run pnpm install" >&2
  exit 1
fi
ranges=$(node "$root/scripts/push-range.mjs" "$1") || exit 1
exec make -C "$(git rev-parse --show-toplevel)" check-push RANGE="$ranges"
