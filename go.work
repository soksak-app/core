go 1.27.3

use (
	./apps/mygo
	./apps/wailsv3
	./packages/host/go
	./packages/host/mygo
	./packages/host/wailsv3
	./packages/sok/go
	./packages/workbench-mygo
)

// 앱 go.mod 가 선언한 호스트 의존성을 이 저장소의 모듈로 해석한다.
replace github.com/soksak-app/core/packages/host/go v0.0.0 => ./packages/host/go
replace github.com/soksak-app/core/packages/host/mygo v0.0.0 => ./packages/host/mygo
replace github.com/soksak-app/core/packages/host/wailsv3 v0.0.0 => ./packages/host/wailsv3
replace github.com/soksak-app/core/packages/sok/go v0.0.0 => ./packages/sok/go
