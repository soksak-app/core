    { "id": "G2-S0-host-cpu", "goal": "G2", "scenario": "S0", "target": "make measure-app-usage STATE=S0 IDLE=1 INTERVAL=240", "measurement": "hostCpuSeconds", "unit": "s", "over": "median", "bound": { "atMost": 0.12 }, "relative": true },
    { "id": "G3-S1-host-footprint", "goal": "G3", "scenario": "S1", "target": "make measure-app-usage STATE=S1", "measurement": "hostFootprintKb", "unit": "KB", "over": "median" },
    { "id": "G3-S4-host-footprint", "goal": "G3", "scenario": "S4", "target": "make measure-host-allocations MINUTES=60", "measurement": "hostFootprintKb", "unit": "KB", "over": "median", "against": "G3-S1-host-footprint" },
    { "id": "G3-S10-host-growth", "goal": "G3", "scenario": "S10", "target": "make benchmark-split-load", "measurement": "hostGrowthKb", "unit": "KB", "over": "median", "bound": { "below": 131072 }, "constant": "SPLIT_LOAD_GROWTH_BOUND_KB" },
