    { "id": "G5-S2-rows-1-frame-rate", "goal": "G5", "scenario": "S2", "target": "make measure-terminal-redraw PLUGIN=term RATE=30 ROWS=1", "measurement": "framesPerSecond", "unit": "frames/s", "over": "median", "bound": { "atLeast": 27 }, "relative": true }
