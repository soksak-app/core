{
  "version": 1,
  "cases": [
    {
      "id": "js-command-supervisor",
      "language": "js-ts",
      "timeoutMs": 30000,
      "command": "node",
      "args": ["--test", "--test-reporter=tap", "scripts/test/test-command.test.mjs"],
      "expectedTests": 22,
      "implementationFiles": ["scripts/test-command.mjs"],
      "testFiles": ["scripts/test/test-command.test.mjs"],
      "dependencyFiles": ["package.json", "pnpm-lock.yaml"],
      "buildFlags": ["node>=20", "node --test"]
    },
    {
      "id": "rust-sok-registry",
      "language": "rust",
      "timeoutMs": 30000,
      "command": "cargo",
      "args": ["test", "-p", "soksak-sok", "--test", "registry_test"],
      "expectedTests": 5,
      "implementationFiles": ["packages/sok/rust/src/registry.rs"],
      "testFiles": ["packages/sok/rust/tests/registry_test.rs"],
      "dependencyFiles": ["Cargo.toml", "Cargo.lock"],
      "buildFlags": ["MACOSX_DEPLOYMENT_TARGET=14.4", "cargo test"]
    },
    {
      "id": "go-sok-registry",
      "language": "go",
      "timeoutMs": 30000,
      "command": "go",
      "args": ["test", "-json", "-run", "^TestRegistryBuild", "./packages/sok/go/tests"],
      "expectedTests": 5,
      "implementationFiles": ["packages/sok/go/src/registry.go"],
      "testFiles": ["packages/sok/go/tests/registry_test.go"],
      "dependencyFiles": ["packages/sok/go/go.mod", "go.work"],
      "buildFlags": ["go test -json"]
    },
    {
      "id": "objc-appearance",
      "language": "objective-c",
      "timeoutMs": 30000,
      "command": "./native/darwin/build/appearance_test",
      "args": [],
      "expectedTests": 6,
      "implementationFiles": ["native/darwin/src/appearance.m"],
      "testFiles": ["native/darwin/tests/appearance_test.m"],
      "dependencyFiles": ["native/darwin/Makefile"],
      "buildFlags": ["clang -fblocks -fmodules -mmacosx-version-min=14.4", "Cocoa WebKit"]
    },
    {
      "id": "shell-build-environment",
      "language": "shell",
      "timeoutMs": 30000,
      "command": "sh",
      "args": ["scripts/test/check-tools.sh"],
      "expectedTests": 4,
      "implementationFiles": ["scripts/check-tools.sh"],
      "testFiles": ["scripts/test/check-tools.sh"],
      "dependencyFiles": [".node-version", "package.json", "pnpm-lock.yaml"],
      "buildFlags": ["sh scripts/test/check-tools.sh"]
    }
