{
  "exclude": "^(e2e|packages/window-check)/",
  "entrances": {
    "go.go-statement": [
      "^packages/host/wailsv3/src/routine/routine\\.go$",
      "^packages/sok/wailsv3/src/routine\\.go$"
    ],
    "m.registration": [
      "^native/darwin/src/observe\\.m$"
    ],
    "m.delegate": [
      "^native/darwin/src/observe\\.m$"
    ],
    "go.recover": [
      "^packages/host/wailsv3/src/routine/routine\\.go$",
      "^packages/sok/wailsv3/src/routine\\.go$"
    ],
    "rs.thread-spawn": [
      "^packages/host/tauriv2/src/routine/routine\\.rs$",
      "^packages/sok/tauriv2/src/routine\\.rs$"
    ]
  },
  "emitters": {
    "go": [
      {
        "call": "Emit",
        "level": 0,
        "event": 1,
        "fields": 2,
        "only": "^packages/sok/"
      }
    ],
    "js": [
      {
        "call": "trace",
        "fixed": "debug",
        "prefix": "page.trace.",
        "event": 0,
        "fields": 1,
        "bare": true,
        "only": "^packages/workbench/"
      }
    ],
    "rs": [
      {
        "call": "emit",
        "level": 0,
        "event": 1,
        "fields": 2,
        "only": "^packages/sok/"
      }
    ]
  }
}
