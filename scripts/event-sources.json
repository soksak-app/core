{
  "exclude": "^(e2e|packages/window-check)/",
  "entrances": {
    "go.go-statement": [
      "^packages/host/go/src/routine/routine\\.go$",
      "^packages/sok/go/src/routine\\.go$",
      "^packages/host/mygo/benchmark/platform/darwin/main\\.go$"
    ],
    "m.registration": [
      "^native/darwin/src/observe\\.m$"
    ],
    "m.delegate": [
      "^native/darwin/src/observe\\.m$"
    ],
    "go.recover": [
      "^packages/host/go/src/routine/routine\\.go$",
      "^packages/sok/go/src/routine\\.go$"
    ],
    "rs.thread-spawn": [
      "^packages/host/rust/src/routine/routine\\.rs$",
      "^packages/sok/rust/src/routine\\.rs$"
    ]
  },
  "emitters": {
    "go": [
      {
        "call": "Emit",
        "level": 0,
        "event": 1,
        "fields": 2,
        "only": "^packages/(sok|workbench-mygo)/"
      },
      {
        "call": "Trace",
        "fixed": "debug",
        "prefix": "workbench.trace.",
        "event": 0,
        "fields": 1,
        "only": "^packages/workbench-mygo/"
      }
    ],
    "js": [
      {
        "call": "trace",
        "fixed": "debug",
        "prefix": "workbench.trace.",
        "event": 0,
        "fields": 1,
        "bare": true,
        "only": "^packages/workbench/"
      },
      {
        "call": "ownRecord",
        "level": 1,
        "event": 2,
        "fields": 3,
        "bare": true,
        "only": "^packages/plugin-api/log-batch\\.js$"
      }
    ],
    "rs": [
      {
        "call": "emit",
        "level": 0,
        "event": 1,
        "fields": 2,
        "only": "^packages/sok/"
      }
    ]
  }
}
